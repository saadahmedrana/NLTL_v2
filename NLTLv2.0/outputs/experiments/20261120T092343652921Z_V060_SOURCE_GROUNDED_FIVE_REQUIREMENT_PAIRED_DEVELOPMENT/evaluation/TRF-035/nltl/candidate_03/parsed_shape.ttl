@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:message "TRF-035 clause 4.1.1: L shall be represented as the ship's classification-society rule length, using one of the evidenced rule-length properties and a QUDT QuantityValue with unit metre."@en ;
    sh:or ( [ sh:property [ sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:node [ a sh:NodeShape ;
                                sh:class qudt:QuantityValue ;
                                sh:property [ sh:hasValue unit:M ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:path qudt:unit ] ] ;
                        sh:path nltl:ruleLength ] ] [ sh:property [ sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:node [ a sh:NodeShape ;
                                sh:class qudt:QuantityValue ;
                                sh:property [ sh:hasValue unit:M ;
                                        sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:path qudt:unit ] ] ;
                        sh:path nltl:classificationSocietyRuleLength ] ] ) ;
    sh:targetClass nltl:ship .

