@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F04/ruleLength> ;
                    sh:resultMessage "A rule length quantity shall use the canonical QUDT metre unit." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue unit:M ;
                            sh:maxCount 1 ;
                            sh:message "A rule length quantity shall use the canonical QUDT metre unit." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F04/ship> ;
            sh:resultMessage "The ship's L value shall be represented as its rule length used by the classification society (TRF-035, clause 4.1.1)." ;
            sh:resultPath nltl:ruleLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship's L value shall be represented as its rule length used by the classification society (TRF-035, clause 4.1.1)." ;
                    sh:minCount 1 ;
                    sh:node nltl:TRF035LengthQuantityShape ;
                    sh:path nltl:ruleLength ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F04/ruleLength> ] .

