@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

nltl:I2_004_UpperIceWaterlineDisplacementShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:deactivated true ;
    sh:description "Inactive regulatory shape for IACS UR I2 clause I2.1.2.2. The source applies to Polar Class ships according to UR I1, but the supplied ontology does not provide a Polar Class target class or an equivalent applicability binding. It must not be treated as an enforcing implementation until that applicability is resolved. Source: data/requirements/IACS_I2_full.txt, sha256 7ad8d57459782b70809da479380584a57cf259c66d9ff286811c0248b02732d2, selected offsets 0-1304, selection sha256 c6e77eb821ae603a13c191d7eb5073821d353775215f91d431bb454faf9207cb, requirement I2-004, clause I2.1.2.2." ;
    sh:property [
        a sh:PropertyShape ;
        sh:path nltl:upperIceWaterlineDisplacement ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:I2_004_DisplacementQuantityShape ;
        sh:message "A ship displacement corresponding to the upper ice waterline is required and must be represented as one quantity in kt."
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path nltl:hasUpperIceWaterlineCase ;
        sh:node nltl:I2_004_UpperIceWaterlineCaseShape ;
        sh:message "Each upper ice waterline case must provide its waterline-case displacement in kt."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "The ship displacement must not be less than the displacement of any represented upper ice waterline case; where cases are represented, the selected displacement must correspond to the greatest case displacement." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?shipDisplacement .
                $this nltl:hasUpperIceWaterlineCase ?case .
                ?case nltl:waterlineCaseDisplacement ?caseDisplacement .

                ?shipDisplacement qudt:numericValue ?shipValue ;
                                   qudt:unit unit:KiloTON_Metric .
                ?caseDisplacement qudt:numericValue ?caseValue ;
                                    qudt:unit unit:KiloTON_Metric .

                FILTER (?caseValue > ?shipValue)
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "When upper ice waterline cases are represented, at least one case displacement must equal the ship displacement, thereby representing the case with the greatest displacement." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?shipDisplacement .
                $this nltl:hasUpperIceWaterlineCase ?case .

                ?shipDisplacement qudt:numericValue ?shipValue ;
                                   qudt:unit unit:KiloTON_Metric .

                FILTER NOT EXISTS {
                    ?case nltl:waterlineCaseDisplacement ?caseDisplacement .
                    ?caseDisplacement qudt:numericValue ?caseValue ;
                                        qudt:unit unit:KiloTON_Metric .
                    FILTER (?caseValue = ?shipValue)
                }
            }
        """
    ] .

nltl:I2_004_UpperIceWaterlineCaseShape
    a sh:NodeShape ;
    sh:class nltl:upperIceWaterlineCase ;
    sh:property [
        a sh:PropertyShape ;
        sh:path nltl:waterlineCaseDisplacement ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:I2_004_DisplacementQuantityShape ;
        sh:message "An upper ice waterline case must have exactly one waterline-case displacement quantity in kt."
    ] ;
    sh:description "Reusable case shape derived from IACS UR I2 clause I2.1.2.2. It is reachable only through the inactive applicability shape because the supplied source applicability is Polar Class ships according to UR I1 and that target binding is unresolved." .

nltl:I2_004_DisplacementQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        a sh:PropertyShape ;
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "A displacement quantity must contain exactly one decimal numeric value."
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:KiloTON_Metric ;
        sh:message "A displacement quantity must use the canonical QUDT unit http://qudt.org/vocab/unit/KiloTON_Metric (kt)."
    ] ;
    sh:description "Quantity representation is fixed by the supplied JSON-LD serialization: qudt:numericValue with xsd:decimal and qudt:unit with an IRI value. No tolerance or unit conversion is asserted." .
