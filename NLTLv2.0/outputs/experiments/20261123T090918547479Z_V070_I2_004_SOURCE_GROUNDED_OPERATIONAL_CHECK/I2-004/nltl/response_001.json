            "text": "<BEGIN_SHACL>\n@prefix sh: <http://www.w3.org/ns/shacl#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix nltl: <https://w3id.org/nltl/vocab#> .\n@prefix qudt: <http://qudt.org/schema/qudt/> .\n@prefix unit: <http://qudt.org/vocab/unit/> .\n\nnltl:I2_004_UpperIceWaterlineDisplacementShape\n    a sh:NodeShape ;\n    sh:targetClass nltl:ship ;\n    sh:deactivated true ;\n    sh:description \"Inactive regulatory shape for IACS UR I2 clause I2.1.2.2. The source applies to Polar Class ships according to UR I1, but the supplied ontology does not provide a Polar Class target class or an equivalent applicability binding. It must not be treated as an enforcing implementation until that applicability is resolved. Source: data/requirements/IACS_I2_full.txt, sha256 7ad8d57459782b70809da479380584a57cf259c66d9ff286811c0248b02732d2, selected offsets 0-1304, selection sha256 c6e77eb821ae603a13c191d7eb5073821d353775215f91d431bb454faf9207cb, requirement I2-004, clause I2.1.2.2.\" ;\n    sh:property [\n        a sh:PropertyShape ;\n        sh:path nltl:upperIceWaterlineDisplacement ;\n        sh:minCount 1 ;\n        sh:maxCount 1 ;\n        sh:node nltl:I2_004_DisplacementQuantityShape ;\n        sh:message \"A ship displacement corresponding to the upper ice waterline is required and must be represented as one quantity in kt.\"\n    ] ;\n    sh:property [\n        a sh:PropertyShape ;\n        sh:path nltl:hasUpperIceWaterlineCase ;\n        sh:node nltl:I2_004_UpperIceWaterlineCaseShape ;\n        sh:message \"Each upper ice waterline case must provide its waterline-case displacement in kt.\"\n    ] ;\n    sh:sparql [\n        a sh:SPARQLConstraint ;\n        sh:severity sh:Violation ;\n        sh:message \"The ship displacement must not be less than the displacement of any represented upper ice waterline case; where cases are represented, the selected displacement must correspond to the greatest case displacement.\" ;\n        sh:select \"\"\"\n            PREFIX nltl: <https://w3id.org/nltl/vocab#>\n            PREFIX qudt: <http://qudt.org/schema/qudt/>\n            PREFIX unit: <http://qudt.org/vocab/unit/>\n\n            SELECT $this\n            WHERE {\n                $this nltl:upperIceWaterlineDisplacement ?shipDisplacement .\n                $this nltl:hasUpperIceWaterlineCase ?case .\n                ?case nltl:waterlineCaseDisplacement ?caseDisplacement .\n\n                ?shipDisplacement qudt:numericValue ?shipValue ;\n                                   qudt:unit unit:KiloTON_Metric .\n                ?caseDisplacement qudt:numericValue ?caseValue ;\n                                    qudt:unit unit:KiloTON_Metric .\n\n                FILTER (?caseValue > ?shipValue)\n            }\n        \"\"\"\n    ] ;\n    sh:sparql [\n        a sh:SPARQLConstraint ;\n        sh:severity sh:Violation ;\n        sh:message \"When upper ice waterline cases are represented, at least one case displacement must equal the ship displacement, thereby representing the case with the greatest displacement.\" ;\n        sh:select \"\"\"\n            PREFIX nltl: <https://w3id.org/nltl/vocab#>\n            PREFIX qudt: <http://qudt.org/schema/qudt/>\n            PREFIX unit: <http://qudt.org/vocab/unit/>\n\n            SELECT $this\n            WHERE {\n                $this nltl:upperIceWaterlineDisplacement ?shipDisplacement .\n                $this nltl:hasUpperIceWaterlineCase ?case .\n\n                ?shipDisplacement qudt:numericValue ?shipValue ;\n                                   qudt:unit unit:KiloTON_Metric .\n\n                FILTER NOT EXISTS {\n                    ?case nltl:waterlineCaseDisplacement ?caseDisplacement .\n                    ?caseDisplacement qudt:numericValue ?caseValue ;\n                                        qudt:unit unit:KiloTON_Metric .\n                    FILTER (?caseValue = ?shipValue)\n                }\n            }\n        \"\"\"\n    ] .\n\nnltl:I2_004_UpperIceWaterlineCaseShape\n    a sh:NodeShape ;\n    sh:class nltl:upperIceWaterlineCase ;\n    sh:property [\n        a sh:PropertyShape ;\n        sh:path nltl:waterlineCaseDisplacement ;\n        sh:minCount 1 ;\n        sh:maxCount 1 ;\n        sh:node nltl:I2_004_DisplacementQuantityShape ;\n        sh:message \"An upper ice waterline case must have exactly one waterline-case displacement quantity in kt.\"\n    ] ;\n    sh:description \"Reusable case shape derived from IACS UR I2 clause I2.1.2.2. It is reachable only through the inactive applicability shape because the supplied source applicability is Polar Class ships according to UR I1 and that target binding is unresolved.\" .\n\nnltl:I2_004_DisplacementQuantityShape\n    a sh:NodeShape ;\n    sh:class qudt:QuantityValue ;\n    sh:property [\n        a sh:PropertyShape ;\n        sh:path qudt:numericValue ;\n        sh:minCount 1 ;\n        sh:maxCount 1 ;\n        sh:datatype xsd:decimal ;\n        sh:message \"A displacement quantity must contain exactly one decimal numeric value.\"\n    ] ;\n    sh:property [\n        a sh:PropertyShape ;\n        sh:path qudt:unit ;\n        sh:minCount 1 ;\n        sh:maxCount 1 ;\n        sh:hasValue unit:KiloTON_Metric ;\n        sh:message \"A displacement quantity must use the canonical QUDT unit http://qudt.org/vocab/unit/KiloTON_Metric (kt).\"\n    ] ;\n    sh:description \"Quantity representation is fixed by the supplied JSON-LD serialization: qudt:numericValue with xsd:decimal and qudt:unit with an IRI value. No tolerance or unit conversion is asserted.\" .\n<END_SHACL>"
          }
