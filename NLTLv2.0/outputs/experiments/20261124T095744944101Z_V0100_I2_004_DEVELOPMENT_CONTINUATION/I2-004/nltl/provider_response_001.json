{
  "text": "{\n  \"candidate_version\": 1,\n  \"candidate_sha256\": \"d8986fa2c5186ae5d619696650e5f56328480bc5c3430465c4fdbc1ef9d94f9a\",\n  \"review_request_id\": \"review:40eb10462f80a1f6778bb33835c357981caf384790a4e4b960f0b00c5c68ace7\",\n  \"decision\": \"REJECT\",\n  \"issues\": [\n    {\n      \"issue_id\": \"I2-004-LOGIC-001\",\n      \"category\": \"SOURCE_BACKED_LOGIC_ERROR\",\n      \"source_clause\": \"I2.1.2.2\",\n      \"source_evidence_id\": \"E76\",\n      \"source_excerpt\": \"Where multiple waterlines are used for determining the UIWL, the\\n            displacement is to be determined from the waterline corresponding to the greatest\\n            displacement.\",\n      \"reason\": \"The second SPARQL constraint only reports a violation when a valid case displacement is greater than the upper displacement. It therefore permits the upper displacement to be greater than every case displacement, because it does not require that the upper displacement equal one of the greatest case displacements. The query's message claims equality with the greatest displacement, but the implemented condition establishes only an upper bound.\",\n      \"expected\": \"When multiple waterline cases are represented, the ship displacement must correspond to the case having the greatest displacement; the constraint must reject an upper displacement that is greater than the greatest case displacement and must ensure that a greatest case corresponds to the upper displacement.\",\n      \"suggestion\": \"Revise the query so that it expresses equality with the greatest valid case displacement, for example by requiring a case whose numeric value equals the upper value and rejecting any case with a greater numeric value. Preserve the separate quantity-shape checks for decimal values and metric kilotonnes.\",\n      \"evidence_id\": \"E369\",\n      \"evidence_excerpt\": \"{\\\"kind\\\": \\\"REPRESENTATION_ONLY\\\", \\\"modelPaths\\\": [{\\\"fromOwner\\\": \\\"ship\\\", \\\"toOwner\\\": \\\"upperIceWaterlineCase\\\", \\\"via\\\": \\\"hasUpperIceWaterlineCase\\\"}], \\\"owners\\\": {\\\"hasUpperIceWaterlineCase\\\": \\\"ship\\\", \\\"upperIceWaterlineDisplacement\\\": \\\"ship\\\", \\\"waterlineCaseDisplacement\\\": \\\"upperIceWaterlineCase\\\"}, \\\"target_owner\\\": null}\",\n      \"change_id\": null,\n      \"property\": \"https://w3id.org/nltl/vocab#upperIceWaterlineDisplacement\",\n      \"proposed_unit\": \"http://qudt.org/vocab/unit/KiloTON_Metric\",\n      \"proposed_datatype\": \"http://www.w3.org/2001/XMLSchema#decimal\",\n      \"proposed_path\": [\n        \"https://w3id.org/nltl/vocab#hasUpperIceWaterlineCase\",\n        \"https://w3id.org/nltl/vocab#waterlineCaseDisplacement\",\n        \"http://qudt.org/schema/qudt/numericValue\"\n      ],\n      \"candidate_location\": {\n        \"candidate_version\": 1,\n        \"candidate_sha256\": \"d8986fa2c5186ae5d619696650e5f56328480bc5c3430465c4fdbc1ef9d94f9a\",\n        \"unit\": \"lines\",\n        \"start\": 44,\n        \"end\": 60\n      },\n      \"proposed_path_role\": \"NUMERIC_OPERAND\"\n    }\n  ],\n  \"change_assessments\": [],\n  \"reconciliations\": [],\n  \"unchecked\": []\n}",
