            "text": "{\n  \"candidate_version\": 1,\n  \"candidate_sha256\": \"d8986fa2c5186ae5d619696650e5f56328480bc5c3430465c4fdbc1ef9d94f9a\",\n  \"review_request_id\": \"review:652ddf3754a70c5931e7e7491b2d55f1bdb60b5c32683efd211d34a7d52b65bf\",\n  \"decision\": \"REJECT\",\n  \"issues\": [\n    {\n      \"issue_id\": \"I2-004-LOGIC-001\",\n      \"category\": \"SOURCE_BACKED_LOGIC_ERROR\",\n      \"source_clause\": \"I2.1.2.2\",\n      \"source_evidence_id\": \"E66\",\n      \"source_excerpt\": \"The ship displacement DUI is the displacement, in kt, of the ship corresponding to the\\n            upper ice waterline (UIWL). Where multiple waterlines are used for determining the UIWL, the\\n            displacement is to be determined from the waterline corresponding to the greatest\\n            displacement.\",\n      \"reason\": \"The SPARQL constraint only reports a violation when a case displacement is greater than DUI. It therefore permits DUI values greater than the greatest waterline-case displacement, even though the source requires DUI to be the displacement corresponding to the greatest displacement. The query does not establish equality with the maximum case value.\",\n      \"expected\": \"For every admitted ship, DUI must equal the greatest valid displacement among all waterline cases used to determine the UIWL. Both DUI below the maximum and DUI above the maximum must be rejected.\",\n      \"suggestion\": \"Replace the one-sided FILTER EXISTS test with logic that rejects any case value greater than DUI and also rejects DUI when no case has a value equal to the maximum valid case displacement, or otherwise directly express equality to the maximum case value.\",\n      \"evidence_id\": \"E66\",\n      \"evidence_excerpt\": \"The ship displacement DUI is the displacement, in kt, of the ship corresponding to the\\n            upper ice waterline (UIWL). Where multiple waterlines are used for determining the UIWL, the\\n            displacement is to be determined from the waterline corresponding to the greatest\\n            displacement.\",\n      \"change_id\": null,\n      \"property\": \"https://w3id.org/nltl/vocab#upperIceWaterlineDisplacement\",\n      \"proposed_unit\": null,\n      \"proposed_datatype\": null,\n      \"proposed_path\": null,\n      \"proposed_path_role\": null,\n      \"operands\": null,\n      \"representation_disposition\": null,\n      \"candidate_location\": {\n        \"candidate_version\": 1,\n        \"candidate_sha256\": \"d8986fa2c5186ae5d619696650e5f56328480bc5c3430465c4fdbc1ef9d94f9a\",\n        \"unit\": \"lines\",\n        \"start\": 54,\n        \"end\": 58\n      }\n    }\n  ],\n  \"change_assessments\": [],\n  \"reconciliations\": [],\n  \"unchecked\": []\n}"
