@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The ship displacement must correspond to a waterline case having the greatest displacement among the waterline cases used to determine the UIWL." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The ship displacement must correspond to a waterline case having the greatest displacement among the waterline cases used to determine the UIWL." ;
                    sh:select """
            SELECT DISTINCT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?duiQuantity .
                ?duiQuantity qudt:numericValue ?duiValue .

                FILTER (
                    NOT EXISTS {
                        $this nltl:hasUpperIceWaterlineCase ?case .
                        ?case nltl:waterlineCaseDisplacement ?caseQuantity .
                        ?caseQuantity qudt:numericValue ?caseValue .
                        FILTER ( ?caseValue = ?duiValue )
                    }
                    ||
                    EXISTS {
                        $this nltl:hasUpperIceWaterlineCase ?greaterCase .
                        ?greaterCase nltl:waterlineCaseDisplacement ?greaterQuantity .
                        ?greaterQuantity qudt:numericValue ?greaterValue .
                        FILTER ( ?greaterValue > ?duiValue )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:I2_004Shape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ] .

