@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ;
                            sh:resultMessage "The shell inclination quantity must use the canonical degree unit http://qudt.org/vocab/unit/DEG through qudt:unit."@en ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape nltl:I2_005InclinationUnit ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ;
                            sh:resultMessage "The shell inclination numeric value must be exactly 7, encoded as xsd:decimal through qudt:numericValue."@en ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape nltl:I2_005InclinationNumericValue ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/boundaryPoint> ;
                    sh:resultMessage "The boundary point must carry a shell inclination angle represented as a QUDT QuantityValue."@en ;
                    sh:resultPath nltl:shellInclinationAngle ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape nltl:I2_005InclinationProperty ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/ship> ;
            sh:resultMessage "Each admitted ship must identify a bottom/lower-region boundary point represented by nltl:hasBottomRegionLowerRegionBoundaryPoint and typed as nltl:hullBoundaryPoint."@en ;
            sh:resultPath nltl:hasBottomRegionLowerRegionBoundaryPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape nltl:I2_005BoundaryPointProperty ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/boundaryPoint> ] .

