@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-F03/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:not [ sh:property [ sh:hasValue nltl:polarShipCategoryA ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:shipCategory ] ] ] , [ sh:property [ sh:hasValue nltl:mediumFirstYearIceWithPossibleOldIceInclusions ; sh:message Literal(\"A Category A ship must have a design ice condition of at least medium first-year ice, which may include old-ice inclusions.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:designIceCondition ; sh:severity sh:Violation ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltl:IMO-001-CategoryAShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-F03/ship> ] .

