@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/ship> ;
            sh:resultMessage "TRF-035 clause 4.1.1 requires the ship's ruleLength to equal the separately supplied classificationSocietyRuleLength reference quantity.",
                "The numeric value of nltl:ruleLength must equal the numeric value of nltl:classificationSocietyRuleLength; both quantities must be expressed in canonical metres." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:description "Represents the condition in TRAFICOM 2021 regulation clause 4.1.1 that L is to be taken as the ship's rule length used by the classification society. No tolerance or unit conversion is introduced." ;
                    sh:message "The numeric value of nltl:ruleLength must equal the numeric value of nltl:classificationSocietyRuleLength; both quantities must be expressed in canonical metres." ;
                    sh:prefixes [ a sh:PrefixDeclaration ;
                            sh:declare [ a sh:PrefixDeclaration ;
                                    sh:namespace "https://w3id.org/nltl/vocab#" ;
                                    sh:prefix "nltl" ],
                                [ a sh:PrefixDeclaration ;
                                    sh:namespace "http://www.w3.org/2001/XMLSchema#" ;
                                    sh:prefix "xsd" ],
                                [ a sh:PrefixDeclaration ;
                                    sh:namespace "http://qudt.org/schema/qudt/" ;
                                    sh:prefix "qudt" ] ] ;
                    sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl/vocab#ruleLength> ?ruleQuantity .
                ?ruleQuantity <http://qudt.org/schema/qudt/numericValue> ?ruleValue .
                $this <https://w3id.org/nltl/vocab#classificationSocietyRuleLength> ?societyQuantity .
                ?societyQuantity <http://qudt.org/schema/qudt/numericValue> ?societyValue .
                FILTER ( ?ruleValue != ?societyValue )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:TRF035ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/ship> ] .

