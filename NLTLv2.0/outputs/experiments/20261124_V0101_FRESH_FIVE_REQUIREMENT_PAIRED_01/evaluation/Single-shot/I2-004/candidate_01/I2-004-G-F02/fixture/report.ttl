@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F02/ship> ;
            sh:resultMessage "Each ship must have exactly one upper ice waterline displacement DUI quantity in kt." ;
            sh:resultPath nltl:upperIceWaterlineDisplacement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ship must have exactly one upper ice waterline displacement DUI quantity in kt." ;
                    sh:minCount 1 ;
                    sh:node nltl:I2-004-QuantityShape ;
                    sh:path nltl:upperIceWaterlineDisplacement ] ] .

