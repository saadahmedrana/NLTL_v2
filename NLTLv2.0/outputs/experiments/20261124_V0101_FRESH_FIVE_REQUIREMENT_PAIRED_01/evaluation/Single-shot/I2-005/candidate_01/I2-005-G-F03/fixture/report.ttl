@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ;
                            sh:resultMessage "The shell inclination numeric value must be the decimal value 7." ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:decimal ;
                                    sh:hasValue 7.0 ;
                                    sh:maxCount 1 ;
                                    sh:message "The shell inclination numeric value must be the decimal value 7." ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ;
                            sh:resultMessage "The shell inclination quantity must use the canonical QUDT degree unit http://qudt.org/vocab/unit/DEG." ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue unit:DEG ;
                                    sh:maxCount 1 ;
                                    sh:message "The shell inclination quantity must use the canonical QUDT degree unit http://qudt.org/vocab/unit/DEG." ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/boundaryPoint> ;
                    sh:resultMessage "The represented hull boundary point must have a shell inclination angle quantity equal to 7 degrees from horizontal." ;
                    sh:resultPath nltl:shellInclinationAngle ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "The represented hull boundary point must have a shell inclination angle quantity equal to 7 degrees from horizontal." ;
                            sh:minCount 1 ;
                            sh:node nltl:I2-005-ShellInclinationQuantityShape ;
                            sh:path nltl:shellInclinationAngle ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/ship> ;
            sh:resultMessage "Each admitted ship must have a represented bottom/lower-region boundary point, and that point must satisfy I2.2.5." ;
            sh:resultPath nltl:hasBottomRegionLowerRegionBoundaryPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each admitted ship must have a represented bottom/lower-region boundary point, and that point must satisfy I2.2.5." ;
                    sh:minCount 1 ;
                    sh:node nltl:I2-005-HullBoundaryPointShape ;
                    sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/boundaryPoint> ] .

