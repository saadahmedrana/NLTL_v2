@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/ship> ;
            sh:resultMessage "Each admitted ship must have a represented bottom/lower-region boundary point, and that point must satisfy I2.2.5." ;
            sh:resultPath nltl:hasBottomRegionLowerRegionBoundaryPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Each admitted ship must have a represented bottom/lower-region boundary point, and that point must satisfy I2.2.5." ;
                    sh:minCount 1 ;
                    sh:node nltl:I2-005-HullBoundaryPointShape ;
                    sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ] ] .

