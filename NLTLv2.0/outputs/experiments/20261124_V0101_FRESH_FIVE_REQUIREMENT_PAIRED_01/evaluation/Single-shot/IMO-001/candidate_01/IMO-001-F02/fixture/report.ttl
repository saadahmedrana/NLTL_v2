@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-F02/ship> ;
            sh:resultMessage "The Category A definition applies only when the ship-category selector is Category A; the selector and the represented Category A design condition must be supplied without guessing applicability."@en ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape nltl:IMO-001-CategoryAShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-F02/ship> ;
            sh:resultMessage "A ship must contain exactly one recognized Polar Code ship category selector: Category A, Category B, or Category C."@en ;
            sh:resultPath nltl:shipCategory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB nltl:polarShipCategoryC ) ;
                    sh:maxCount 1 ;
                    sh:message "A ship must contain exactly one recognized Polar Code ship category selector: Category A, Category B, or Category C."@en ;
                    sh:minCount 1 ;
                    sh:path nltl:shipCategory ] ] .

