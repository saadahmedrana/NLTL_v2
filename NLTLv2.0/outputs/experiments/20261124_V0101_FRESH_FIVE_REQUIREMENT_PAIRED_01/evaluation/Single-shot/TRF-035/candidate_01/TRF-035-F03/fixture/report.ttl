@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F03/ship> ;
            sh:resultMessage "A ship must have exactly one ruleLength quantity encoded as a metre-valued QUDT QuantityValue." ;
            sh:resultPath nltl:ruleLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "A ship must have exactly one ruleLength quantity encoded as a metre-valued QUDT QuantityValue." ;
                    sh:minCount 1 ;
                    sh:node nltl:TRF035QuantityValueShape ;
                    sh:path nltl:ruleLength ;
                    sh:severity sh:Violation ] ] .

