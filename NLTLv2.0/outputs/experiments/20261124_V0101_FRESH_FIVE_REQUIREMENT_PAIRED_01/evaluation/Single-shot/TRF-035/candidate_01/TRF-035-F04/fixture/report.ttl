@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F04/ship> ;
            sh:resultMessage "ruleLength must equal classificationSocietyRuleLength in both decimal metre value and unit." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "ruleLength must equal classificationSocietyRuleLength in both decimal metre value and unit." ;
                    sh:select """
            SELECT $this
            WHERE {
                $this nltl:ruleLength ?ruleQuantity ;
                      nltl:classificationSocietyRuleLength ?societyQuantity .

                ?ruleQuantity qudt:numericValue ?ruleValue ;
                              qudt:unit ?ruleUnit .

                ?societyQuantity qudt:numericValue ?societyValue ;
                                 qudt:unit ?societyUnit .

                FILTER (
                    xsd:decimal(?ruleValue) != xsd:decimal(?societyValue)
                    || ?ruleUnit != ?societyUnit
                )
            }
        """ ;
                    sh:severity sh:Violation ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:TRF035ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F04/ruleLength> ;
                    sh:resultMessage "The quantity must contain exactly one metre unit (http://qudt.org/vocab/unit/M)." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                            sh:maxCount 1 ;
                            sh:message "The quantity must contain exactly one metre unit (http://qudt.org/vocab/unit/M)." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ;
                            sh:severity sh:Violation ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F04/ship> ;
            sh:resultMessage "A ship must have exactly one ruleLength quantity encoded as a metre-valued QUDT QuantityValue." ;
            sh:resultPath nltl:ruleLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:message "A ship must have exactly one ruleLength quantity encoded as a metre-valued QUDT QuantityValue." ;
                    sh:minCount 1 ;
                    sh:node nltl:TRF035QuantityValueShape ;
                    sh:path nltl:ruleLength ;
                    sh:severity sh:Violation ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F04/ruleLength> ] .

