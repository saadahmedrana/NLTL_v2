{
  "text": "<BEGIN_SHACL>\n@prefix nltl: <https://w3id.org/nltl/vocab#> .\n@prefix sh: <http://www.w3.org/ns/shacl#> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix qudt: <http://qudt.org/schema/qudt/> .\n@prefix unit: <http://qudt.org/vocab/unit/> .\n\nnltl:I2_004Shape\n    a sh:NodeShape ;\n    sh:targetClass nltl:ship ;\n    sh:description \"Activated representation of I2-004, UR I2 Structural Requirements for Polar Class Ships, clause I2.1.2.2. The admitted population is the caller-declared complete synthetic population of nltl:ship records. The source states that UR I2 applies to Polar Class ships according to UR I1; that applicability is retained as source text and is not independently re-certified by this shape.\" ;\n    sh:description \"Source evidence: data/requirements/IACS_I2_full.txt; document SHA-256 7ad8d57459782b70809da479380584a57cf259c66d9ff286811c0248b02732d2; retained selection offsets 0-1304; selection SHA-256 c6e77eb821ae603a13c191d7eb5073821d353775215f91d431bb454faf9207cb. Requirement text: I2.1.2.2 The ship displacement DUI is the displacement, in kt, of the ship corresponding to the upper ice waterline (UIWL). Where multiple waterlines are used for determining the UIWL, the displacement is to be determined from the waterline corresponding to the greatest displacement.\" ;\n    sh:description \"Source-context uncertainty retained: the source references UR I1 without a locally represented applicability binding. The caller supplied UR I1 Rev.2 (April 2016) as experimental contextual scope evidence only; no additional applicability selector is inferred.\" ;\n    sh:node [\n        sh:class nltl:ship ;\n        sh:message \"The focus node must remain within the caller-admitted ship population.\"\n    ] ;\n    sh:property [\n        sh:path nltl:upperIceWaterlineDisplacement ;\n        sh:minCount 1 ;\n        sh:maxCount 1 ;\n        sh:node nltl:I2_004_QuantityShape ;\n        sh:message \"Each admitted ship must have exactly one upper ice waterline displacement quantity.\"\n    ] ;\n    sh:property [\n        sh:path nltl:hasUpperIceWaterlineCase ;\n        sh:minCount 1 ;\n        sh:node nltl:I2_004_CaseShape ;\n        sh:message \"Each admitted ship must have at least one upper ice waterline case.\"\n    ] ;\n    sh:sparql [\n        a sh:SPARQLConstraint ;\n        sh:message \"The ship displacement must correspond to a waterline case having the greatest displacement among the waterline cases used to determine the UIWL.\" ;\n        sh:select \"\"\"\n            SELECT DISTINCT $this\n            WHERE {\n                $this nltl:upperIceWaterlineDisplacement ?duiQuantity .\n                ?duiQuantity qudt:numericValue ?duiValue .\n\n                FILTER (\n                    NOT EXISTS {\n                        $this nltl:hasUpperIceWaterlineCase ?case .\n                        ?case nltl:waterlineCaseDisplacement ?caseQuantity .\n                        ?caseQuantity qudt:numericValue ?caseValue .\n                        FILTER ( ?caseValue = ?duiValue )\n                    }\n                    ||\n                    EXISTS {\n                        $this nltl:hasUpperIceWaterlineCase ?greaterCase .\n                        ?greaterCase nltl:waterlineCaseDisplacement ?greaterQuantity .\n                        ?greaterQuantity qudt:numericValue ?greaterValue .\n                        FILTER ( ?greaterValue > ?duiValue )\n                    }\n                )\n            }\n        \"\"\" ;\n    ] .\n\nnltl:I2_004_CaseShape\n    a sh:NodeShape ;\n    sh:class nltl:upperIceWaterlineCase ;\n    sh:property [\n        sh:path nltl:waterlineCaseDisplacement ;\n        sh:minCount 1 ;\n        sh:maxCount 1 ;\n        sh:node nltl:I2_004_QuantityShape ;\n        sh:message \"Each upper ice waterline case must have exactly one waterline case displacement quantity.\"\n    ] ;\n    sh:message \"A linked upper ice waterline case must be an nltl:upperIceWaterlineCase and must carry its case displacement.\"\n    .\n\nnltl:I2_004_QuantityShape\n    a sh:NodeShape ;\n    sh:class qudt:QuantityValue ;\n    sh:property [\n        sh:path qudt:numericValue ;\n        sh:minCount 1 ;\n        sh:maxCount 1 ;\n        sh:datatype xsd:decimal ;\n        sh:message \"A displacement quantity must have exactly one xsd:decimal qudt:numericValue.\"\n    ] ;\n    sh:property [\n        sh:path qudt:unit ;\n        sh:minCount 1 ;\n        sh:maxCount 1 ;\n        sh:hasValue unit:KiloTON_Metric ;\n        sh:message \"A displacement quantity must have exactly one unit, qudt:unit KiloTON_Metric.\"\n    ] ;\n    sh:message \"Displacement quantities use the declared QUDT quantity representation with qudt:numericValue as xsd:decimal and qudt:unit as an IRI.\"\n    .\n<END_SHACL>",
