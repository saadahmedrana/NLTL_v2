@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qv: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:I2-004-QuantityShape
    a sh:NodeShape ;
    sh:class qv:QuantityValue ;
    sh:property [
        sh:path qv:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "The displacement quantity must have exactly one xsd:decimal qv:numericValue." ;
    ] ;
    sh:property [
        sh:path qv:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloTON_Metric> ;
        sh:message "The displacement quantity must have exactly one unit, http://qudt.org/vocab/unit/KiloTON_Metric (kt)." ;
    ] ;
    sh:name "I2-004 displacement quantity representation" ;
    sh:description "Declared JSON-LD quantity encoding: qv:numericValue as xsd:decimal and qv:unit as an IRI. The required unit is metric kilotonne (kt)." .

nltl:I2-004-UpperIceWaterlineCaseShape
    a sh:NodeShape ;
    sh:class nltl:upperIceWaterlineCase ;
    sh:property [
        sh:path nltl:waterlineCaseDisplacement ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:I2-004-QuantityShape ;
        sh:message "Each upper ice waterline case must have exactly one waterline-case displacement quantity in kt." ;
    ] ;
    sh:name "I2-004 upper ice waterline case" ;
    sh:description "A represented waterline case used to determine the displacement corresponding to the UIWL. The supplied ontology does not bind the retired nltl:upperIceWaterline scalar property to an owner; that unresolved ownership is therefore not used as an enforcement path." .

nltl:I2-004-ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:class nltl:ship ;
    sh:name "I2-004 ship displacement at upper ice waterline" ;
    sh:description "Activated for the caller-admitted synthetic population of nltl:ship design records. The sh:class guard is the mandatory input guard for the scoped class target; caller admission is external provenance and is not independently re-certified here." ;
    sh:message "I2.1.2.2: The ship displacement DUI is the displacement, in kt, of the ship corresponding to the upper ice waterline (UIWL). Where multiple waterlines are used for determining the UIWL, the displacement is to be determined from the waterline corresponding to the greatest displacement." ;
    dcterms:source "data/requirements/IACS_I2_full.txt" ;
    dcterms:description "Source selection: start=0; end=1304; selection sha256=c6e77eb821ae603a13c191d7eb5073821d353775215f91d431bb454faf9207cb; document sha256=7ad8d57459782b70809da479380584a57cf259c66d9ff286811c0248b02732d2; source clause I2.1.2.2; requirement I2-004." ;
    dcterms:description "Visible source applicability: I2.1.1 states that this UR applies to Polar Class ships according to UR I1. The caller supplies the synthetic research population and experimental edition context; this shape does not infer or independently certify Polar Class, construction-date, or legal-edition eligibility." ;
    dcterms:description "Cross-document context remains explicit: the retained source references UR I1 and other UR I2 material. The supplied context records dependency-resolution uncertainty for those references; no additional applicability selector is invented here." ;
    sh:property [
        sh:path nltl:upperIceWaterlineDisplacement ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:I2-004-QuantityShape ;
        sh:message "Each ship must have exactly one upper ice waterline displacement DUI quantity in kt." ;
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterlineCase ;
        sh:minCount 1 ;
        sh:node nltl:I2-004-UpperIceWaterlineCaseShape ;
        sh:message "Each ship must have at least one represented upper ice waterline case so that the corresponding UIWL displacement and the greatest-displacement condition can be evaluated." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The ship's upper ice waterline displacement must equal the displacement of at least one represented waterline case, and no represented waterline case may have a greater displacement." ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl/vocab#upperIceWaterlineDisplacement> ?duiQuantity .
                ?duiQuantity <http://qudt.org/schema/qudt/numericValue> ?duiValue .

                $this <https://w3id.org/nltl/vocab#hasUpperIceWaterlineCase> ?case .

                FILTER NOT EXISTS {
                    $this <https://w3id.org/nltl/vocab#hasUpperIceWaterlineCase> ?greaterCase .
                    ?greaterCase <https://w3id.org/nltl/vocab#waterlineCaseDisplacement> ?greaterQuantity .
                    ?greaterQuantity <http://qudt.org/schema/qudt/numericValue> ?greaterValue .
                    FILTER ( ?greaterValue > ?duiValue )
                }

                FILTER NOT EXISTS {
                    $this <https://w3id.org/nltl/vocab#hasUpperIceWaterlineCase> ?equalCase .
                    ?equalCase <https://w3id.org/nltl/vocab#waterlineCaseDisplacement> ?equalQuantity .
                    ?equalQuantity <http://qudt.org/schema/qudt/numericValue> ?equalValue .
                    FILTER ( ?equalValue = ?duiValue )
                }
            }
        """ ;
    ] .

