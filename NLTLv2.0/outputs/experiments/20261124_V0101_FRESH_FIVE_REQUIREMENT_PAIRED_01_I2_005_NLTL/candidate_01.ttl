@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

nltl:I2_005ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:description "Activated for the caller-admitted complete population of nltl:ship synthetic design records. I2.1.1 states: This UR applies to Polar Class ships according to UR I1. External Polar Class eligibility and source-edition applicability are caller-admitted research assumptions and are not independently inferred or re-certified by this shape. The UR I1 cross-document dependency remains unresolved in the supplied source context."@en ;
    sh:property nltl:I2_005ShipTypeGuard ;
    sh:property nltl:I2_005BoundaryPointProperty ;
    sh:message "I2-005 / I2.2.5: The boundary between the bottom and lower regions is to be taken at the point where the shell is inclined 7° from horizontal."@en .

nltl:I2_005ShipTypeGuard
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:minCount 1 ;
    sh:hasValue nltl:ship ;
    sh:message "The focus node must be an admitted nltl:ship. This is an input-population guard and does not independently establish Polar Class eligibility."@en .

nltl:I2_005BoundaryPointProperty
    a sh:PropertyShape ;
    sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ;
    sh:minCount 1 ;
    sh:class nltl:hullBoundaryPoint ;
    sh:node nltl:I2_005BoundaryPointShape ;
    sh:message "Each admitted ship must identify a bottom/lower-region boundary point represented by nltl:hasBottomRegionLowerRegionBoundaryPoint and typed as nltl:hullBoundaryPoint."@en .

nltl:I2_005BoundaryPointShape
    a sh:NodeShape ;
    sh:property nltl:I2_005InclinationProperty ;
    sh:message "The supplied source defines the boundary at the shell location where the shell is inclined 7° from horizontal."@en .

nltl:I2_005InclinationProperty
    a sh:PropertyShape ;
    sh:path nltl:shellInclinationAngle ;
    sh:minCount 1 ;
    sh:class qudt:QuantityValue ;
    sh:node nltl:I2_005InclinationQuantityShape ;
    sh:message "The boundary point must carry a shell inclination angle represented as a QUDT QuantityValue."@en .

nltl:I2_005InclinationQuantityShape
    a sh:NodeShape ;
    sh:property nltl:I2_005InclinationNumericValue ;
    sh:property nltl:I2_005InclinationUnit ;
    sh:message "The required shell inclination is exactly 7 degrees. The supplied representation provides a quantity value and unit, but no separate predicate for shell orientation relative to horizontal; this shape therefore checks the represented angle value and canonical unit only."@en .

nltl:I2_005InclinationNumericValue
    a sh:PropertyShape ;
    sh:path qudt:numericValue ;
    sh:minCount 1 ;
    sh:datatype xsd:decimal ;
    sh:hasValue "7"^^xsd:decimal ;
    sh:message "The shell inclination numeric value must be exactly 7, encoded as xsd:decimal through qudt:numericValue."@en .

nltl:I2_005InclinationUnit
    a sh:PropertyShape ;
    sh:path qudt:unit ;
    sh:minCount 1 ;
    sh:hasValue unit:DEG ;
    sh:message "The shell inclination quantity must use the canonical degree unit http://qudt.org/vocab/unit/DEG through qudt:unit."@en .
