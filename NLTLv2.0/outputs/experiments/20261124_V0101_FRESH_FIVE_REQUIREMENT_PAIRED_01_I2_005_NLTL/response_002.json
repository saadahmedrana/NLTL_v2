  "text": "{\n  \"candidate_version\": 1,\n  \"candidate_sha256\": \"fd9f93389c7317a0678d2d23f3116e376c0b8d8cb51d02e3e6e4f52921db4979\",\n  \"review_request_id\": \"review:54f93737a39cd0af94db019b4a2ed224583a71791f4bbdf4bf833880e4a6a30c\",\n  \"decision\": \"UNRESOLVED\",\n  \"issues\": [\n    {\n      \"issue_id\": \"I2-005-review-001\",\n      \"category\": \"UNRESOLVED_CONTEXT\",\n      \"source_clause\": \"I2.2.5\",\n      \"source_evidence_id\": \"E20\",\n      \"source_excerpt\": \"         I2.2.5 The boundary between the bottom and lower regions is to be taken at the point where\\n         the shell is inclined 7° from horizontal.\\n\\n\",\n      \"reason\": \"The source condition includes the shell's inclination from horizontal. The candidate validates only a QuantityValue with numeric value 7 and unit DEG. Its own message states that no orientation or horizontal-reference predicate is checked, so the SHACL does not establish that the measured angle is the source-required shell inclination from horizontal. The supplied schema identifies shellInclinationAngle as a quantity property but does not provide a separate, source-backed orientation/reference representation.\",\n      \"expected\": \"The represented constraint must preserve and validate the horizontal-reference condition, either through a declared property semantics that explicitly encodes it or through an available schema path for the reference/orientation.\",\n      \"suggestion\": \"Resolve whether nltl:shellInclinationAngle is formally defined by the supplied schema as inclination from horizontal. If not, obtain or declare a supported representation for the horizontal reference and constrain it; do not treat numeric value and unit alone as the complete I2.2.5 condition.\",\n      \"evidence_id\": \"E47\",\n      \"evidence_excerpt\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#shellInclinationAngle\\\", \\\"kind\\\": \\\"QuantityProperty\\\", \\\"label\\\": \\\"Shell inclination angle\\\", \\\"localName\\\": \\\"shellInclinationAngle\\\", \\\"parentOrRange\\\": \\\"http://qudt.org/schema/qudt/QuantityValue\\\", \\\"sourceRefs\\\": \\\"I2-005 | IACS_UR_I2 p.2 | I2.2.5\\\", \\\"unitIri\\\": \\\"http://qudt.org/vocab/unit/DEG\\\", \\\"unitSymbol\\\": \\\"deg\\\"}\",\n      \"change_id\": null,\n      \"property\": \"https://w3id.org/nltl/vocab#shellInclinationAngle\",\n      \"proposed_unit\": \"http://qudt.org/vocab/unit/DEG\",\n      \"proposed_datatype\": \"http://www.w3.org/2001/XMLSchema#decimal\",\n      \"proposed_path\": [\n        \"https://w3id.org/nltl/vocab#shellInclinationAngle\"\n      ],\n      \"candidate_location\": {\n        \"candidate_version\": 1,\n        \"candidate_sha256\": \"fd9f93389c7317a0678d2d23f3116e376c0b8d8cb51d02e3e6e4f52921db4979\",\n        \"unit\": \"lines\",\n        \"start\": 44,\n        \"end\": 56\n      },\n      \"proposed_path_role\": \"PROPERTY\",\n      \"operands\": null,\n      \"representation_disposition\": null\n    },\n    {\n      \"issue_id\": \"I2-005-review-002\",\n      \"category\": \"UNRESOLVED_CONTEXT\",\n      \"source_clause\": \"I2.2.5\",\n      \"source_evidence_id\": \"E20\",\n      \"source_excerpt\": \"         I2.2.5 The boundary between the bottom and lower regions is to be taken at the point where\\n         the shell is inclined 7° from horizontal.\\n\\n\",\n      \"reason\": \"The numeric constraint uses sh:hasValue with the exact RDF literal \\\"7\\\"^^xsd:decimal. The supplied quantity encoding declares xsd:decimal as the datatype but does not state that the source requires this exact lexical RDF term rather than decimal value equality. Consequently, equivalent decimal lexical forms such as \\\"7.0\\\"^^xsd:decimal may be rejected without source support.\",\n      \"expected\": \"The implementation must use the source-supported numeric interpretation while retaining the declared xsd:decimal representation and DEG unit.\",\n      \"suggestion\": \"Resolve whether I2.2.5 requires exact RDF-term identity or numeric decimal equality. If numeric equality is required, replace exact-term matching with a supported numeric comparison; otherwise retain the exact-term constraint only with explicit source support for that lexical requirement.\",\n      \"evidence_id\": \"E207\",\n      \"evidence_excerpt\": \"{\\\"canonical_literal_encoding\\\": \\\"http://www.w3.org/2001/XMLSchema#decimal\\\", \\\"declarations\\\": {\\\"numericValue\\\": {\\\"@id\\\": \\\"qudt:numericValue\\\", \\\"@type\\\": \\\"xsd:decimal\\\"}, \\\"unit\\\": {\\\"@id\\\": \\\"qudt:unit\\\", \\\"@type\\\": \\\"@id\\\"}}, \\\"file\\\": \\\"schema/locked_representation_context.jsonld\\\", \\\"numeric_predicate\\\": \\\"http://qudt.org/schema/qudt/numericValue\\\", \\\"quantity_class\\\": \\\"http://qudt.org/schema/qudt/QuantityValue\\\", \\\"scope\\\": \\\"Declared quantity serialization, not a numeric-equality solution or conversion\\\", \\\"unit_predicate\\\": \\\"http://qudt.org/schema/qudt/unit\\\"}\",\n      \"change_id\": null,\n      \"property\": \"https://w3id.org/nltl/vocab#shellInclinationAngle\",\n      \"proposed_unit\": \"http://qudt.org/vocab/unit/DEG\",\n      \"proposed_datatype\": \"http://www.w3.org/2001/XMLSchema#decimal\",\n      \"proposed_path\": [\n        \"https://w3id.org/nltl/vocab#shellInclinationAngle\",\n        \"http://qudt.org/schema/qudt/numericValue\"\n      ],\n      \"candidate_location\": {\n        \"candidate_version\": 1,\n        \"candidate_sha256\": \"fd9f93389c7317a0678d2d23f3116e376c0b8d8cb51d02e3e6e4f52921db4979\",\n        \"unit\": \"lines\",\n        \"start\": 50,\n        \"end\": 56\n      },\n      \"proposed_path_role\": \"NUMERIC_OPERAND\",\n      \"operands\": null,\n      \"representation_disposition\": null\n    }\n  ],\n  \"change_assessments\": [],\n  \"reconciliations\": [],\n  \"unchecked\": []\n}",
