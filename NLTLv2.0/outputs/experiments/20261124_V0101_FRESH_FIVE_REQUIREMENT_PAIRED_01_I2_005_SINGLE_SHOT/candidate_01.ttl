@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

nltl:I2-005-ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:description """I2-005, IACS UR I2 Structural Requirements for Polar Class Ships, clause I2.2.5: "The boundary between the bottom and lower regions is to be taken at the point where the shell is inclined 7° from horizontal."

The caller-admitted population is the complete synthetic nltl:ship population per input under admission SYNTHETIC_DESIGN_RESEARCH_SCOPE_I2_005_V1. External Polar Class and source-edition eligibility is caller provenance and is not independently inferred here. The source applicability text in I2.1.1 states: "This UR applies to Polar Class ships according to UR I1." The referenced UR I1 context is retained as unresolved external source context and is not used as an inferred selector.""" ;
    sh:property [
        sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ;
        sh:minCount 1 ;
        sh:node nltl:I2-005-HullBoundaryPointShape ;
        sh:message "Each admitted ship must have a represented bottom/lower-region boundary point, and that point must satisfy I2.2.5." ;
    ] .

nltl:I2-005-HullBoundaryPointShape
    a sh:NodeShape ;
    sh:class nltl:hullBoundaryPoint ;
    sh:property [
        sh:path nltl:shellInclinationAngle ;
        sh:minCount 1 ;
        sh:node nltl:I2-005-ShellInclinationQuantityShape ;
        sh:message "The represented hull boundary point must have a shell inclination angle quantity equal to 7 degrees from horizontal." ;
    ] .

nltl:I2-005-ShellInclinationQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:hasValue "7"^^xsd:decimal ;
        sh:message "The shell inclination numeric value must be the decimal value 7." ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:DEG ;
        sh:message "The shell inclination quantity must use the canonical QUDT degree unit http://qudt.org/vocab/unit/DEG." ;
    ] ;
    sh:description """Quantity encoding is fixed by the declared JSON-LD representation context: qudt:numericValue with xsd:decimal and qudt:unit with an IRI. The canonical quantity class is qudt:QuantityValue and the required unit is qudt:DEG.""" .

nltl:I2-005-SourceEvidence
    a sh:NodeShape ;
    sh:deactivated true ;
    sh:description """Retained source evidence, not an evaluation target. Requirement I2-005 is from data/requirements/IACS_I2_full.txt, document SHA-256 7ad8d57459782b70809da479380584a57cf259c66d9ff286811c0248b02732d2. The exact clause selection is characters 3906-4058 with selection SHA-256 690e41194055f2b890c1646217f46632461cd8facb426a21578401b007d777a4. The retained parent/application selection is characters 218-1333 with selection SHA-256 3c3cee5a6bc2cec55f1397184d78083a090b09835cf6af93a7405643e1b5c8ac. Source manifest SHA-256 is c1c9863ccd8297d09d12249c49f6ab2005ace6eedd8df93672a7a8a3fcd2cd58.

Unresolved cross-document references retained in the supplied source context include UR I1 generally, UR I1 section I1.1.6, and UR I2 section I2.13. They are not required to interpret the represented I2.2.5 angle condition and are not silently resolved or used to activate/deactivate this requirement shape.""" .
