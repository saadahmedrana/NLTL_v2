{
  "text": "<BEGIN_SHACL>\n@prefix nltl: <https://w3id.org/nltl/vocab#> .\n@prefix sh:   <http://www.w3.org/ns/shacl#> .\n@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix skos: <http://www.w3.org/2004/02/skos/core#> .\n@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .\n@prefix dcterms: <http://purl.org/dc/terms/> .\n\nnltl:IMO-001-CategoryAShipShape\n    a sh:NodeShape ;\n    sh:targetClass nltl:ship ;\n    sh:deactivated false ;\n    sh:property [\n        sh:path rdf:type ;\n        sh:hasValue nltl:ship ;\n        sh:minCount 1 ;\n        sh:severity sh:Violation ;\n        sh:message \"The focus node must be admitted as an nltl:ship within the caller-declared population.\" ;\n    ] ;\n    sh:or (\n        [\n            sh:not [\n                sh:property [\n                    sh:path nltl:shipCategory ;\n                    sh:hasValue nltl:polarShipCategoryA ;\n                    sh:minCount 1 ;\n                ]\n            ]\n        ]\n        [\n            sh:property [\n                sh:path nltl:designIceCondition ;\n                sh:hasValue nltl:mediumFirstYearIceWithPossibleOldIceInclusions ;\n                sh:minCount 1 ;\n                sh:severity sh:Violation ;\n                sh:message \"A Category A ship must have a design ice condition of at least medium first-year ice, which may include old-ice inclusions.\" ;\n            ]\n        ]\n    ) ;\n    sh:name \"IMO-001 Category A ship design-condition constraint\"@en ;\n    sh:description \"Represents Polar Code Introduction 2.1: Category A ship means a ship designed for operation in polar waters in at least medium first-year ice, which may include old ice inclusions. The conditional constraint is activated only when nltl:shipCategory is nltl:polarShipCategoryA; absence of the category selector does not establish applicability.\"@en ;\n    dcterms:identifier \"IMO-001\" ;\n    dcterms:source \"data/requirements/IMO_full.txt\" ;\n    rdfs:seeAlso nltl:polarShipCategoryA ;\n    rdfs:seeAlso nltl:mediumFirstYearIceWithPossibleOldIceInclusions ;\n    rdfs:comment \"Retained source selection: file=data/requirements/IMO_full.txt; document SHA-256=27ffb65eeae2519755523f40105ea0611d4f8238f15dddb7b465b9241ba32553; selected start=14049; selected end=16635; selection SHA-256=d78e8ecd4ce79ad14d0e63674ee6ede1a31392e8122f726acd80e3b37cf141cd; section IDs=2, 2.1, 2.2, 2.3, 2.4, 2.5, 2.6, 2.7, 2.8, 2.9, 2.10, 2.11, 2.12, 2.13, 2.14, 2.15.\"@en .\n\nnltl:polarShipCategoryA\n    a skos:Concept, nltl:polarShipCategoryValue ;\n    skos:prefLabel \"Category A\"@en .\n\nnltl:mediumFirstYearIceWithPossibleOldIceInclusions\n    a nltl:iceConditionValue ;\n    skos:prefLabel \"Medium first-year ice with possible old-ice inclusions\"@en .\n\nnltl:shipCategory\n    a rdf:Property ;\n    rdfs:domain nltl:benchmarkEntity ;\n    rdfs:range nltl:polarShipCategoryValue .\n\nnltl:designIceCondition\n    a rdf:Property ;\n    rdfs:domain nltl:ship ;\n    rdfs:range nltl:iceConditionValue .\n<END_SHACL>",
