            "logprobs": [],
            "text": "<BEGIN_SHACL>\n@prefix sh: <http://www.w3.org/ns/shacl#> .\n@prefix nltl: <https://w3id.org/nltl/vocab#> .\n\nnltl:IMO-001-CategoryAShipShape\n    a sh:NodeShape ;\n    sh:targetClass nltl:ship ;\n    sh:deactivated false ;\n    sh:severity sh:Violation ;\n    sh:name \"IMO-001 Category A ship definition\"@en ;\n    sh:description \"Activated representation of Polar Code Introduction 2.1. For each admitted ship, shipCategory is a mandatory selector and must be one of the declared Polar Code category values. If the selector is Category A, the ship must have the source-represented design condition of at least medium first-year ice, which may include old-ice inclusions. Caller admission is external research-scope provenance and is not independently re-certified by this shape.\"@en ;\n    sh:order 1 ;\n    sh:property [\n        sh:path nltl:shipCategory ;\n        sh:minCount 1 ;\n        sh:maxCount 1 ;\n        sh:in (\n            nltl:polarShipCategoryA\n            nltl:polarShipCategoryB\n            nltl:polarShipCategoryC\n        ) ;\n        sh:message \"A ship must contain exactly one recognized Polar Code ship category selector: Category A, Category B, or Category C.\"@en ;\n    ] ;\n    sh:or (\n        [\n            sh:property [\n                sh:path nltl:shipCategory ;\n                sh:hasValue nltl:polarShipCategoryA ;\n            ] ;\n            sh:property [\n                sh:path nltl:designIceCondition ;\n                sh:minCount 1 ;\n                sh:maxCount 1 ;\n                sh:hasValue nltl:mediumFirstYearIceWithPossibleOldIceInclusions ;\n                sh:message \"A Category A ship must be designed for operation in at least medium first-year ice, which may include old-ice inclusions.\"@en ;\n            ] ;\n        ]\n        [\n            sh:property [\n                sh:path nltl:shipCategory ;\n                sh:hasValue nltl:polarShipCategoryB ;\n            ] ;\n        ]\n        [\n            sh:property [\n                sh:path nltl:shipCategory ;\n                sh:hasValue nltl:polarShipCategoryC ;\n            ] ;\n        ]\n    ) ;\n    sh:message \"The Category A definition applies only when the ship-category selector is Category A; the selector and the represented Category A design condition must be supplied without guessing applicability.\"@en ;\n    nltl:sourceRequirementId \"IMO-001\" ;\n    nltl:sourceReference \"IMO-001 | IMO_POLAR_CODE p.9 | Introduction 2.1\" ;\n    nltl:sourceDocument \"data/requirements/IMO_full.txt\" ;\n    nltl:sourceDocumentSha256 \"27ffb65eeae2519755523f40105ea0611d4f8238f15dddb7b465b9241ba32553\" ;\n    nltl:sourceSelectionStart 14049 ;\n    nltl:sourceSelectionEnd 16635 ;\n    nltl:sourceSelectionSha256 \"d78e8ecd4ce79ad14d0e63674ee6ede1a31392e8122f726acd80e3b37cf141cd\" ;\n    nltl:sourceSelectionManifestSha256 \"414a5acc74d0beb567524a5c597c542230169d28f7efddf55bb762b744ee9ad3\" ;\n    nltl:sourceText \"2.1    Category A ship means a ship designed for operation in polar waters in at least medium first-year ice, which may include old ice inclusions.\" ;\n    nltl:admissionId \"SYNTHETIC_DESIGN_RESEARCH_SCOPE_IMO_001_V1\" ;\n    nltl:admissionInterpretation \"A\" ;\n    nltl:admittedOwnerClass nltl:ship .\n<END_SHACL>"
