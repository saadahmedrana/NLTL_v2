            "text": "<BEGIN_SHACL>\n@prefix nltl: <https://w3id.org/nltl/vocab#> .\n@prefix qudt: <http://qudt.org/schema/qudt/> .\n@prefix sh: <http://www.w3.org/ns/shacl#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n\nnltl:TRF035ShipShape\n    a sh:NodeShape ;\n    sh:targetClass nltl:ship ;\n    sh:property nltl:TRF035RuleLengthPropertyShape ;\n    sh:property nltl:TRF035ClassificationSocietyRuleLengthPropertyShape ;\n    sh:sparql nltl:TRF035RuleLengthEqualityConstraint ;\n    sh:description \"Activated constraint for the caller-admitted complete population of nltl:ship records. The represented source requirement is: \\\"L shall be taken as the ship's rule length used by the classification society.\\\" The caller supplies external research-scope eligibility and the selected 2021 source edition; those assumptions are not independently re-certified by this shape.\" ;\n    sh:message \"TRF-035 clause 4.1.1 requires the ship's ruleLength to equal the separately supplied classificationSocietyRuleLength reference quantity.\" ;\n    sh:order 35 .\n\nnltl:TRF035RuleLengthPropertyShape\n    a sh:PropertyShape ;\n    sh:path nltl:ruleLength ;\n    sh:minCount 1 ;\n    sh:node nltl:TRF035LengthQuantityShape ;\n    sh:description \"The direct ship-owned quantity representing L, the rule length used by the design.\" .\n\nnltl:TRF035ClassificationSocietyRuleLengthPropertyShape\n    a sh:PropertyShape ;\n    sh:path nltl:classificationSocietyRuleLength ;\n    sh:minCount 1 ;\n    sh:node nltl:TRF035LengthQuantityShape ;\n    sh:description \"The direct ship-owned classification-society reference quantity against which ruleLength is compared. The source does not provide a separately enforceable society identity or derivation procedure; no such obligation is added.\" .\n\nnltl:TRF035LengthQuantityShape\n    a sh:NodeShape ;\n    sh:class qudt:QuantityValue ;\n    sh:property nltl:TRF035NumericValuePropertyShape ;\n    sh:property nltl:TRF035UnitPropertyShape ;\n    sh:description \"Canonical quantity representation required by the declared JSON-LD serialization: one decimal numericValue and one canonical metre unit.\" .\n\nnltl:TRF035NumericValuePropertyShape\n    a sh:PropertyShape ;\n    sh:path qudt:numericValue ;\n    sh:minCount 1 ;\n    sh:maxCount 1 ;\n    sh:datatype xsd:decimal ;\n    sh:description \"Numeric component of the quantity, encoded as xsd:decimal according to the declared quantityEncoding.numeric_predicate.\" .\n\nnltl:TRF035UnitPropertyShape\n    a sh:PropertyShape ;\n    sh:path qudt:unit ;\n    sh:minCount 1 ;\n    sh:maxCount 1 ;\n    sh:hasValue <http://qudt.org/vocab/unit/M> ;\n    sh:description \"Unit component of the quantity, required to be the canonical metre IRI according to the declared quantityEncoding.unit_predicate.\" .\n\nnltl:TRF035RuleLengthEqualityConstraint\n    a sh:SPARQLConstraint ;\n    sh:prefixes nltl:TRF035Prefixes ;\n    sh:select \"\"\"\n        SELECT $this\n        WHERE {\n            $this <https://w3id.org/nltl/vocab#ruleLength> ?ruleQuantity .\n            ?ruleQuantity <http://qudt.org/schema/qudt/numericValue> ?ruleValue .\n            ?this <https://w3id.org/nltl/vocab#classificationSocietyRuleLength> ?societyQuantity .\n            ?societyQuantity <http://qudt.org/schema/qudt/numericValue> ?societyValue .\n            FILTER ( ?ruleValue != ?societyValue )\n        }\n    \"\"\" ;\n    sh:message \"The numeric value of nltl:ruleLength must equal the numeric value of nltl:classificationSocietyRuleLength; both quantities must be expressed in canonical metres.\" ;\n    sh:description \"Represents the condition in TRAFICOM 2021 regulation clause 4.1.1 that L is to be taken as the ship's rule length used by the classification society. No tolerance or unit conversion is introduced.\" .\n\nnltl:TRF035Prefixes\n    a sh:PrefixDeclaration ;\n    sh:declare [\n        a sh:PrefixDeclaration ;\n        sh:prefix \"nltl\" ;\n        sh:namespace \"https://w3id.org/nltl/vocab#\"\n    ] ;\n    sh:declare [\n        a sh:PrefixDeclaration ;\n        sh:prefix \"qudt\" ;\n        sh:namespace \"http://qudt.org/schema/qudt/\"\n    ] ;\n    sh:declare [\n        a sh:PrefixDeclaration ;\n        sh:prefix \"xsd\" ;\n        sh:namespace \"http://www.w3.org/2001/XMLSchema#\"\n    ] .\n\nnltl:TRF035SourceEvidence\n    a sh:NodeShape ;\n    sh:description \"Source evidence retained for TRF-035: data/requirements/TRAFICOM_full.txt; document SHA-256 e0bf179c97a1535aa7d4d0dd5d4053edf5f3f4e7e028c49d14c3a31cc7c1e8ba; selected clause 4.1.1 character offsets 42109-43429; selection SHA-256 bcccb0c27b3065f7270ed4809b69f39fcbcc051291a324f43641bf09a19a7c90. The selected text states: \\\"L shall be taken as the ship's rule length used by the classification society.\\\" Source-edition applicability and population eligibility are caller-admitted research assumptions, not independently verified legal findings. The source selection manifest records other unresolved references in the broader document; none is silently used to expand this clause's represented obligation.\" .\n<END_SHACL>"
