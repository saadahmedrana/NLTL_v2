@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt#> .            # original (fragment) prefix – kept for compatibility
@prefix qdt:  <http://qudt.org/schema/qudt/> .            # canonical (no‑fragment) prefix required by the schema
@prefix unit: <http://qudt.org/vocab/unit/> .

# -----------------------------------------------------------------
# Shape that targets every ship (the admitted population) and
# requires a single hull‑boundary point linked via
# nltl:hasBottomRegionLowerRegionBoundaryPoint.
# -----------------------------------------------------------------
<https://w3id.org/nltl/shapes#ShipBoundaryShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <https://w3id.org/nltl/shapes#HullBoundaryShape> ;
    ] .

# -----------------------------------------------------------------
# Shape that validates the hull‑boundary point referenced from a ship.
# This shape is **not** globally targeted; it is activated only when a
# ship instance has a hasBottomRegionLowerRegionBoundaryPoint property.
# -----------------------------------------------------------------
<https://w3id.org/nltl/shapes#HullBoundaryShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shellInclinationAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <https://w3id.org/nltl/shapes#ShellAngleQuantityShape> ;
    ] .

# -----------------------------------------------------------------
# Shape that validates the QUDT QuantityValue representing the shell
# inclination.  The shape is invoked only via the node constraint above.
# -----------------------------------------------------------------
<https://w3id.org/nltl/shapes#ShellAngleQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qdt:numericValue ;               # canonical IRI http://qudt.org/schema/qudt/numericValue
        sh:datatype xsd:decimal ;
        sh:hasValue "7"^^xsd:decimal ;
    ] ;
    sh:property [
        sh:path qdt:unit ;                       # canonical IRI http://qudt.org/schema/qudt/unit
        sh:hasValue unit:DEG ;
    ] .
