            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/inclination> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/inclination> ;
                            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/inclination>->qudt:numericValue does not contain a value in the set: ['Literal(\"7\", datatype=xsd:decimal)']" ;
                            sh:resultPath qudt:numericValue ;
