@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ------------------------------------------------------------
# Shape representing the definition of a Category A ship
# (IMO‑001, Introduction 2.1)
# ------------------------------------------------------------
nltl:CategoryADesignConditionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    rdfs:comment "Definition (IMO‑001 | Polar Code p.9 | 2.1): “Category A ship means a ship designed for operation in polar waters in at least medium first‑year ice, which may include old ice inclusions.”" ;
    sh:description "A ship that is classified as Category A must have a design ice condition of at least medium first‑year ice with possible old‑ice inclusions." ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:hasValue nltl:polarShipCategoryA ;
        sh:message "Ship must be classified as Category A (polarShipCategoryA)." ;
        sh:severity sh:Violation
    ] , [
        sh:path nltl:designIceCondition ;
        sh:hasValue nltl:mediumFirstYearIceWithPossibleOldIceInclusions ;
        sh:message "Design ice condition for a Category A ship must be ‘medium first‑year ice with possible old‑ice inclusions’ (mediumFirstYearIceWithPossibleOldIceInclusions)." ;
        sh:severity sh:Violation
    ] .
