@prefix ex: <http://example.org/ex#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/inclination> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/inclination>->qudt:numericValue does not contain a value in the set: ['Literal(\"7\", datatype=xsd:decimal)']" ;
            sh:resultPath qudt:numericValue ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n4b5f0b4f68054a17a5572a9dcbac213cb3 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/inclination> ;
                            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/inclination>->qudt:numericValue does not contain a value in the set: ['Literal(\"7\", datatype=xsd:decimal)']" ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:n4b5f0b4f68054a17a5572a9dcbac213cb3 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/boundaryPoint> ;
                    sh:resultMessage "Value does not conform to Shape ex:ShellInclinationAngleValueShape. See details for more information." ;
                    sh:resultPath nltl:shellInclinationAngle ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:n4b5f0b4f68054a17a5572a9dcbac213cb2 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/inclination> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape ex:HullBoundaryPointShape. See details for more information." ;
            sh:resultPath nltl:hasBottomRegionLowerRegionBoundaryPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node ex:HullBoundaryPointShape ;
                    sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/boundaryPoint> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/inclination> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/inclination>->qudt:numericValue does not contain a value in the set: ['Literal(\"7\", datatype=xsd:decimal)']" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n4b5f0b4f68054a17a5572a9dcbac213cb3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/boundaryPoint> ;
            sh:resultMessage "Value does not conform to Shape ex:ShellInclinationAngleValueShape. See details for more information." ;
            sh:resultPath nltl:shellInclinationAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n4b5f0b4f68054a17a5572a9dcbac213cb2 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/inclination> ] .

_:n4b5f0b4f68054a17a5572a9dcbac213cb2 sh:minCount 1 ;
    sh:node ex:ShellInclinationAngleValueShape ;
    sh:path nltl:shellInclinationAngle .

_:n4b5f0b4f68054a17a5572a9dcbac213cb3 sh:datatype xsd:decimal ;
    sh:hasValue 7.0 ;
    sh:path qudt:numericValue .

