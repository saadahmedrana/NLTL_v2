@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-P02/ship> ;
            sh:resultMessage "Design ice condition for a Category A ship must be ‘medium first‑year ice with possible old‑ice inclusions’ (mediumFirstYearIceWithPossibleOldIceInclusions)." ;
            sh:resultPath nltl:designIceCondition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:mediumFirstYearIceWithPossibleOldIceInclusions ;
                    sh:message "Design ice condition for a Category A ship must be ‘medium first‑year ice with possible old‑ice inclusions’ (mediumFirstYearIceWithPossibleOldIceInclusions)." ;
                    sh:path nltl:designIceCondition ;
                    sh:severity sh:Violation ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-P02/ship> ;
            sh:resultMessage "Ship must be classified as Category A (polarShipCategoryA)." ;
            sh:resultPath nltl:shipCategory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:polarShipCategoryA ;
                    sh:message "Ship must be classified as Category A (polarShipCategoryA)." ;
                    sh:path nltl:shipCategory ;
                    sh:severity sh:Violation ] ] .

