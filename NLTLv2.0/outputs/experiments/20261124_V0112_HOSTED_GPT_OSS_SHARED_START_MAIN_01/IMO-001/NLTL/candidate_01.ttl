@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

nltl:ShipCategoryARequirementShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:description "Category A ship means a ship designed for operation in polar waters in at least medium first‑year ice, which may include old ice inclusions. (IMO‑001 | IMO_POLAR_CODE p.9 | 2.1)" ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:hasValue nltl:polarShipCategoryA ;
        sh:message "The ship must be classified as Category A (polarShipCategoryA)." ;
    ] ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:hasValue nltl:mediumFirstYearIceWithPossibleOldIceInclusions ;
        sh:message "The design ice condition must be at least medium first‑year ice with possible old‑ice inclusions (mediumFirstYearIceWithPossibleOldIceInclusions)." ;
    ] .
