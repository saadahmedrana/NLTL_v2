@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix nltl:  <https://w3id.org/nltl/vocab#> .

# Shape that captures the ice‑class assignment requirement (TRF‑010, clause 1.8)
nltl:ShipIceClassShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:description """Under section 3 of the Act on the Ice Classes of Ships and Icebreaker Assistance (1121/2005), ships are assigned to ice classes as follows:
1. ice class IA Super – ships capable of navigating in difficult ice conditions without icebreaker assistance;
2. ice class IA – ships capable of navigating in difficult ice conditions with icebreaker assistance;
3. ice class IB – ships capable of navigating in moderate ice conditions with icebreaker assistance;
4. ice class IC – ships capable of navigating in light ice conditions with icebreaker assistance;
5. ice class II – ships with a steel hull structurally fit for open‑sea navigation and able to navigate in very light ice using own propulsion;
6. ice class III – ships that do not belong to the above classes.""" ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ;
        sh:message "A ship must be assigned exactly one of the ice‑class values defined in clause 1.8 of TRF‑010 (IA Super, IA, IB, IC, II, III)." ;
    ] .
