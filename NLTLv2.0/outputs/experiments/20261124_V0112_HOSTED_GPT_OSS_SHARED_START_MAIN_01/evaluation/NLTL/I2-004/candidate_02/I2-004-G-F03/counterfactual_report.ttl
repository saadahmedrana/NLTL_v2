@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/caseDisp1> ;
                            sh:resultMessage "A QuantityValue must specify the unit KiloTON_Metric (kt)." ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
                            sh:sourceShape _:n584258dbd10d45ffb4b6cfc7c63bcf13b2 ;
                            sh:value unit:KiloTON_Metric ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/waterlineCase1> ;
                    sh:resultMessage "Each UpperIceWaterlineCase must have a waterlineCaseDisplacement expressed as a QuantityValue." ;
                    sh:resultPath nltl:waterlineCaseDisplacement ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:n584258dbd10d45ffb4b6cfc7c63bcf13b3 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/caseDisp1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/ship> ;
            sh:resultMessage "A ship must have at least one UpperIceWaterlineCase (hasUpperIceWaterlineCase)." ;
            sh:resultPath nltl:hasUpperIceWaterlineCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n584258dbd10d45ffb4b6cfc7c63bcf13b4 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/waterlineCase1> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/selectedDui> ;
                    sh:resultMessage "A QuantityValue must specify the unit KiloTON_Metric (kt)." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:ClassConstraintComponent ;
                    sh:sourceShape _:n584258dbd10d45ffb4b6cfc7c63bcf13b2 ;
                    sh:value unit:KiloTON_Metric ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/ship> ;
            sh:resultMessage "A ship must have an upperIceWaterlineDisplacement (DUI) expressed as a QuantityValue." ;
            sh:resultPath nltl:upperIceWaterlineDisplacement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A ship must have an upperIceWaterlineDisplacement (DUI) expressed as a QuantityValue." ;
                    sh:minCount 1 ;
                    sh:node nltl:QuantityValueShape ;
                    sh:path nltl:upperIceWaterlineDisplacement ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/selectedDui> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/caseDisp2> ;
                            sh:resultMessage "A QuantityValue must specify the unit KiloTON_Metric (kt)." ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
                            sh:sourceShape _:n584258dbd10d45ffb4b6cfc7c63bcf13b2 ;
                            sh:value unit:KiloTON_Metric ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/waterlineCase2> ;
                    sh:resultMessage "Each UpperIceWaterlineCase must have a waterlineCaseDisplacement expressed as a QuantityValue." ;
                    sh:resultPath nltl:waterlineCaseDisplacement ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:n584258dbd10d45ffb4b6cfc7c63bcf13b3 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/caseDisp2> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/ship> ;
            sh:resultMessage "A ship must have at least one UpperIceWaterlineCase (hasUpperIceWaterlineCase)." ;
            sh:resultPath nltl:hasUpperIceWaterlineCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n584258dbd10d45ffb4b6cfc7c63bcf13b4 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/waterlineCase2> ] .

_:n584258dbd10d45ffb4b6cfc7c63bcf13b3 sh:message "Each UpperIceWaterlineCase must have a waterlineCaseDisplacement expressed as a QuantityValue." ;
    sh:minCount 1 ;
    sh:node nltl:QuantityValueShape ;
    sh:path nltl:waterlineCaseDisplacement .

_:n584258dbd10d45ffb4b6cfc7c63bcf13b4 sh:class nltl:upperIceWaterlineCase ;
    sh:message "A ship must have at least one UpperIceWaterlineCase (hasUpperIceWaterlineCase)." ;
    sh:minCount 1 ;
    sh:node nltl:UpperIceWaterlineCaseShape ;
    sh:path nltl:hasUpperIceWaterlineCase .

_:n584258dbd10d45ffb4b6cfc7c63bcf13b2 sh:class unit:KiloTON_Metric ;
    sh:maxCount 1 ;
    sh:message "A QuantityValue must specify the unit KiloTON_Metric (kt)." ;
    sh:minCount 1 ;
    sh:path qudt:unit .

