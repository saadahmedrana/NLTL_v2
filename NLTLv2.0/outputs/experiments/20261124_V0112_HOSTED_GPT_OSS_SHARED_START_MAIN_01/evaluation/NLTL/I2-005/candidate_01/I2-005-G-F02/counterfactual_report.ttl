@prefix ex: <https://example.org/shapes/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/inclination> ;
                            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/inclination>->qudt:numericValue does not contain a value in the set: ['Literal(\"7\", datatype=xsd:decimal)']" ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:n77093912f67c4cdfae83dae5971040d7b3 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/boundaryPoint> ;
                    sh:resultMessage "Value does not conform to Shape ex:ShellInclinationAngleValueShape. See details for more information." ;
                    sh:resultPath nltl:shellInclinationAngle ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:n77093912f67c4cdfae83dae5971040d7b2 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/inclination> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape ex:HullBoundaryPointShape. See details for more information." ;
            sh:resultPath nltl:hasBottomRegionLowerRegionBoundaryPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:description "The ship must have at least one hull‑boundary point that marks the bottom/lower‑region boundary." ;
                    sh:minCount 1 ;
                    sh:node ex:HullBoundaryPointShape ;
                    sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/boundaryPoint> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/inclination> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/inclination>->qudt:numericValue does not contain a value in the set: ['Literal(\"7\", datatype=xsd:decimal)']" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n77093912f67c4cdfae83dae5971040d7b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/boundaryPoint> ;
            sh:resultMessage "Value does not conform to Shape ex:ShellInclinationAngleValueShape. See details for more information." ;
            sh:resultPath nltl:shellInclinationAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n77093912f67c4cdfae83dae5971040d7b2 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/inclination> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/inclination> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/inclination>->qudt:numericValue does not contain a value in the set: ['Literal(\"7\", datatype=xsd:decimal)']" ;
            sh:resultPath qudt:numericValue ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n77093912f67c4cdfae83dae5971040d7b3 ] .

_:n77093912f67c4cdfae83dae5971040d7b2 sh:description "The boundary point must carry a shell inclination angle quantity." ;
    sh:minCount 1 ;
    sh:node ex:ShellInclinationAngleValueShape ;
    sh:path nltl:shellInclinationAngle .

_:n77093912f67c4cdfae83dae5971040d7b3 sh:datatype xsd:decimal ;
    sh:description "Numeric value of the angle must be 7." ;
    sh:hasValue 7.0 ;
    sh:path qudt:numericValue .

