@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-P02/ship> ;
            sh:resultMessage "The design ice condition must be at least medium first‑year ice with possible old‑ice inclusions (mediumFirstYearIceWithPossibleOldIceInclusions)." ;
            sh:resultPath nltl:designIceCondition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:mediumFirstYearIceWithPossibleOldIceInclusions ;
                    sh:message "The design ice condition must be at least medium first‑year ice with possible old‑ice inclusions (mediumFirstYearIceWithPossibleOldIceInclusions)." ;
                    sh:path nltl:designIceCondition ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-P02/ship> ;
            sh:resultMessage "The ship must be classified as Category A (polarShipCategoryA)." ;
            sh:resultPath nltl:shipCategory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:polarShipCategoryA ;
                    sh:message "The ship must be classified as Category A (polarShipCategoryA)." ;
                    sh:path nltl:shipCategory ] ] .

