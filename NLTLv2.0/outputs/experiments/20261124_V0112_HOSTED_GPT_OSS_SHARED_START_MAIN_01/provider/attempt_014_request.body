https://w3id.org/nltl/vocab#shipDisplacementFactor> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-DEV-R9-0289\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E193\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineDraught> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical benchmark length unit\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E194\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hasLowerIceWaterline> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-020\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E195\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hasLowerIceWaterline> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E196\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#waterlineCaseDisplacement> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Waterline case displacement\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E197\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#displacementAtUpperIceWaterline> <https://w3id.org/nltl/vocab#sourceReference> \\\"TRF-016 | TRAFICOM p.7 | 2.2\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E198\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineDraught> <https://w3id.org/nltl/vocab#quantityKindLabel> \\\"Length\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E199\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hasUpperIceWaterline> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Has upper ice waterline\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E200\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#lowerIceWaterlineReferencePosition> <http://www.w3.org/2000/01/rdf-schema#range> <http://qudt.org/schema/qudt/QuantityValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E201\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceWaterline> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E202\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#pleasureYacht\\\", \\\"kind\\\": \\\"Class\\\", \\\"label\\\": \\\"Pleasure yacht\\\", \\\"localName\\\": \\\"pleasureYacht\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#ship\\\", \\\"sourceRefs\\\": \\\"IMO26-002 | IMO_AMEND_2026 p.2 | Chapter 9-1 applicability; IMO26-016 | IMO_AMEND_2026 p.5 | Chapter 11-1 applicability\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E203\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#module> <https://w3id.org/nltl/vocab#moduleCore> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E204\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#upperIceWaterlineBreadth\\\", \\\"kind\\\": \\\"QuantityProperty\\\", \\\"label\\\": \\\"Upper ice waterline breadth\\\", \\\"localName\\\": \\\"u