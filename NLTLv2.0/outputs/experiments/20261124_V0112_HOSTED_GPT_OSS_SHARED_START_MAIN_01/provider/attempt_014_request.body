ield\": \"ontology_evidence\"}}, {\"evidence_id\": \"E311\", \"kind\": \"CONTEXT_STATUS\", \"text\": \"[\\\"upperIceWaterline\\\"]\", \"origin\": {\"context_field\": \"unresolvedOwnership\"}}, {\"evidence_id\": \"E312\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineLengthLUI> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#ship> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E313\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <http://www.w3.org/2004/02/skos/core#altLabel> \\\"oil_tanker\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E314\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#minimumRequiredPowerAtUpperIceWaterline\\\", \\\"kind\\\": \\\"QuantityProperty\\\", \\\"label\\\": \\\"Minimum required power at upper ice waterline\\\", \\\"localName\\\": \\\"minimumRequiredPowerAtUpperIceWaterline\\\", \\\"parentOrRange\\\": \\\"http://qudt.org/schema/qudt/QuantityValue\\\", \\\"sourceRefs\\\": \\\"TRF-020 | TRAFICOM p.8-9 | 3.2.2\\\", \\\"unitIri\\\": \\\"http://qudt.org/vocab/unit/KiloW\\\", \\\"unitSymbol\\\": \\\"kW\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E315\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#situatedAboveLowerIceWaterline> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E316\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-0121\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E317\", \"kind\": \"