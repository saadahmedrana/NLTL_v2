org/nltl/vocab#minimumRequiredPowerAtLowerIceWaterline> <https://w3id.org/nltl/vocab#recommendedUnit> <http://qudt.org/vocab/unit/KiloW> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E434\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#sourceReference> \\\"IMO26-002 | IMO_AMEND_2026 p.2 | Chapter 9-1 applicability; IMO26-016 | IMO_AMEND_2026 p.5 | Chapter 11-1 applicability\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E435\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineDisplacement> <http://www.w3.org/2000/01/rdf-schema#range> <http://qudt.org/schema/qudt/QuantityValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E436\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterline> <http://www.w3.org/2004/02/skos/core#changeNote> \\\"Retired in VOCAB-DEV-2026-08-13-BATCH01-R8.1-POSTCONFIRMATION: string representation cannot express the required Batch 01 node/value model.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E437\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineDraught> <http://www.w3.org/2004/02/skos/core#altLabel> \\\"upper_ice_waterline_draught\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E438\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#brashIceChannelResistanceAtUpperIceWaterline> <https://w3id.org/nltl/vocab#namingRule> \\\"N4 - explicit engineering quantity in ASCII lowerCamelCase; formula symbols remain aliases only.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E439\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineReferencePosition> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Development unit selected and fixture conversion required\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E440\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#minimumRequiredPowerAtLowerIceWaterline> <https://w3id.org/nltl/vocab#quantityKindLabel> \\\"Power\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E441\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#lowerIceWaterline> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-030\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E442\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#situatedAboveLowerIceWaterline> <http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#boolean> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E443\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Explicit engineering entity/artifact class set\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E444\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#minimumRequiredPowerAtUpperIceWaterline> <https://w3id.org/nltl/vocab#namingRule> \\\"N3 - remove unit from the identifier and retain it in unit/quantity metadata\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E445\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipDisplacementFactor> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"I2-017\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E446\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hasUpperIceWaterlineCase> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#ObjectProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E447\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#framingIceStrengtheningAboveUpperIceWaterline> <http://www.w3.org/2000/01/rdf-schema#range> <http://qudt.org/schema/qudt/QuantityValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E448\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineLengthLUI> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R9 development): Upper ice waterline length l u i represents the linked requirement entity, relationship, value, evidence role, or quantity; its scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E449\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hasLowerIceWaterline> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Has lower ice waterline\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E450\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#lowerIceWaterlineReferencePosition> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#directAnalysisCase> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E451\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterline> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-030\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E452\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineLength> <https://w3id.org/nltl/vocab#sourceAlias> \\\"upper_ice_waterline_length\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E453\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#sourceAlias> \\\"fishing_vessel\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E454\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#displacementAtUpperIceWaterline> <https://w3id.org/nltl/vocab#stage2UnitEvidence> \\\"TRF-016 formula uses displacement at UIWL in tonnes\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E455\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hasUpperIceWaterline> <http://www.w3.org/2000/01/rdf-schema#range> <https://w3id.org/nltl/vocab#iceWaterline> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E456\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E457\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineDraught> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#ObjectProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E458\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E459\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Stage 1): candidate concept for oilTanker derived from the linked locked requirements; scope and final semantics require vocabulary approval.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E460\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hasUpperIceWaterline> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-013\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E461\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hasUpperIceWaterlineCase> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Has upper ice waterline case\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E462\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#upperIceWaterlineDraught\\\", \\\"kind\\\": \\\"QuantityProperty\\\", \\\"label\\\": \\\"Upper ice waterline draught\\\", \\\"localName\\\": \\\"upperIceWaterlineDraught\\\", \\\"parentOrRange\\\": \\\"http://qudt.org/schema/qudt/QuantityValue\\\", \\\"sourceRefs\\\": \\\"IMO-038 | IMO_POLAR_CODE p.19 | 4.3.2.2\\\", \\\"unitIri\\\": \\\"http://qudt.org/vocab/unit/M\\\", \\\"unitSymbol\\\": \\\"m\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E463\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterline> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-020\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E464\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#minimumRequiredPowerAtLowerIceWaterline> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Stage 1): candidate concept for minimumRequiredPowerAtLowerIceWaterline derived from the linked locked requirements; scope and final semantics require vocabulary approval.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E465\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineReferencePosition> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-030\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E466\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#lowerIceWaterline> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-020\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E467\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#namingRule> \\\"N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E468\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#sourceAlias> \\\"cargo_ship\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E469\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineDraughtDUI> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#ship> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E470\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterline> <https://w3id.org/nltl/vocab#sourceAlias> \\\"UIWL\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E471\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <https://w3id.org/nltl/vocab#stage1LocalName> \\\"oilTanker\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E472\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Explicit engineering entity/artifact class set\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E473\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineLengthLUI> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"I2-054\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E474\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#lowerIceWaterlineReferencePosition> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#ObjectProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E475\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineCenteredPosition> <https://w3id.org/nltl/vocab#namingRule> \\\"N6 - concise ASCII lowerCamelCase controlled-value name grounded in the linked regulation.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E476\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#lowerIceWaterline> <http://www.w3.org/2002/07/owl#deprecated> \\\"true\\\"^^<http://www.w3.org/2001/XMLSchema#boolean> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E477\", \"kind\": \"SOURCE\", \"text\": \"         I1.3   Upper and Lower Ice Waterlines\\n\\n         I1.3.1 The upper and lower ice waterlines upon which the design of the ship has been based\\n         is to be indicated in the Certificate of Classification. The upper ice waterline (UIWL) is to be\\n         defined by the maximum draughts fore, amidships and aft. The lower ice waterline (LIWL) is\\n         to be defined by the minimum draughts fore, amidships and aft.\\n\\n         I1.3.2 The lower ice waterline is to be determined with due regard to the ship’s ice-going\\n         capability in the ballast loading conditions. The propeller is to be fully submerged at the lower\\n         ice waterline.\\n\\n\\n\\n\\n                                                                                           End of\\n                                                                                           Document\\n\\n\\n\\n\\n                                               I1-2                     IACS Req. 2006/Rev.2 2016\\n\\f\", \"origin\": {\"file\": \"data/requirements/IACS_I1_Rev2_2016.txt\", \"edition\": \"Rev.2 (April 2016)\", \"authority\": \"IACS\", \"selection\": {\"start\": 5412, \"end\": 6375, \"line_start\": 102, \"line_end\": 123, \"page_start\": 2, \"page_end\": 3}}}, {\"evidence_id\": \"E478\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipDisplacementFactor> <http://www.w3.org/2000/01/rdf-schema#range> <http://qudt.org/schema/qudt/QuantityValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E479\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-070\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E480\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hasUpperIceWaterlineCase> <http://www.w3.org/2000/01/rdf-schema#range> <https://w3id.org/nltl/vocab#upperIceWaterlineCase> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E481\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineCenteredPosition> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-030\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E482\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterline> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Upper ice waterline\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E483\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#usedToReachLowerIceWaterline> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#DatatypeProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E484\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#ship> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Ship\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E485\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#displacementAtUpperIceWaterline> <https://w3id.org/nltl/vocab#unitSymbol> \\\"t\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E486\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#minimumRequiredPowerAtUpperIceWaterline> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Stage 1): candidate concept for minimumRequiredPowerAtUpperIceWaterline derived from the linked locked requirements; scope and final semantics require vocabulary approval.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E487\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Explicit engineering entity/artifact class set\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E488\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#upperIceWaterlineLength\\\", \\\"kind\\\": \\\"QuantityProperty\\\", \\\"label\\\": \\\"Upper ice waterline length\\\", \\\"localName\\\": \\\"upperIceWaterlineLength\\\", \\\"parentOrRange\\\": \\\"http://qudt.org/schema/qudt/QuantityValue\\\", \\\"sourceRefs\\\": \\\"IMO-038 | IMO_POLAR_CODE p.19 | 4.3.2.2\\\", \\\"unitIri\\\": \\\"http://qudt.org/vocab/unit/M\\\", \\\"unitSymbol\\\": \\\"m\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E489\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-109\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E490\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipDisplacementFactor> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#ObjectProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E491\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineDraughtDUI> <http://www.w3.org/2000/01/rdf-schema#range> <http://qudt.org/schema/qudt/QuantityValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E492\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hasUpperIceWaterlineCase> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#ship> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E493\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Passenger ship\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E494\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineLength> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E495\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#brashIceChannelResistanceAtUpperIceWaterline> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Numeric operand, comparison value, formula input/output, or engineering measurement.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E496\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#displacementAtUpperIceWaterline> <https://w3id.org/nltl/vocab#stage1LocalName> \\\"displacementUiwlT\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E497\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#brashIceChannelResistanceAtUpperIceWaterline\\\", \\\"kind\\\": \\\"QuantityProperty\\\", \\\"label\\\": \\\"Brash ice channel resistance at upper ice waterline\\\", \\\"localName\\\": \\\"brashIceChannelResistanceAtUpperIceWaterline\\\", \\\"parentOrRange\\\": \\\"http://qudt.org/schema/qudt/QuantityValue\\\", \\\"sourceRefs\\\": \\\"TRF-020 | TRAFICOM p.8-9 | 3.2.2\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E498\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipDisplacementFactor> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Ship displacement factor\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E499\", \"kind\": \"SOURCE\", \"text\": \"         I2.3.2.1   Bow area\\n\\n         (i) In the Bow area, the force (F), line load (Q), pressure (P) and load patch aspect ratio (AR)\\n         associated with the glancing impact load scenario are functions of the hull angles measured\\n         at the upper ice waterline (UIWL). The influence of the hull angles is captured through\\n         calculation of a bow shape coefficient (fa). The hull angles are defined in Figure 2.\\n\\n                                        Figure 2 - Definition of hull angles\\n\\n\\n\\n\\n         Note:  = normal frame angle at upper ice waterline [deg]\\n                = upper ice waterline angle [deg]\\n                = buttock angle at upper ice waterline (angle of buttock line measured from horizontal) [deg]\\n               tan() = tan()/tan()\\n               tan() = tan()ꞏcos()\\n\\n\\n                                                  I2-4                    IACS Req. 2006/Rev.4 2019\\n\\f                                                                                                         I2\\n\\n\\n\\nI2       (ii) The waterline length of the bow region is generally to be divided into 4 sub-regions of\\n(cont)   equal length. The force (F), line load (Q), pressure (P) and load patch aspect ratio (AR) are\\n         to be calculated with respect to the mid-length position of each sub-region (each maximum of\\n         F, Q and P is to be used in the calculation of the ice load parameters Pavg, b and w).\\n\\n         (iii) The Bow area load characteristics for bow forms defined in I2.3.1 (v) are determined as\\n         follows:\\n\\n         (a) Shape coefficient, fai, is to be taken as\\n\\n             fai   = minimum (fai,1 ; fai,2 ; fai,3)\\n\\n             where fai,1 = (0.097 - 0.68 ꞏ (x/ LUI - 0.15)2) ꞏ i / (i)0.5\\n                   fai,2 = 1.2 ꞏ CFF / ( sin (i) ꞏ CFC ꞏ DUI0.64)\\n                   fai,3 = 0.60\\n\\n         (b) Force, Fi:\\n\\n             Fi = fai ꞏ CFC ꞏ DUI0.64 [MN]\\n\\n         (c) Load patch aspect ratio, ARi:\\n\\n             ARi = 7.46 ꞏ sin (i)  1.3\\n\\n         (d) Line load, Qi:\\n\\n             Qi = Fi 0.61 ꞏ CFD / ARi0.35 [MN/m]\\n\\n         (e) Pressure, Pi:\\n\\n             Pi = Fi0.22 ꞏ CFD2 ꞏ ARi0.3 [MPa]\\n\\n             where i = sub-region considered\\n                   LUI = length as defined in I2.1.2.1 [m]\\n                   x = distance from the fore side of the stem at the intersection with the upper ice\\n                        waterline (UIWL) to station under consideration [m]\\n                    = waterline angle [deg], see Figure 2\\n                    = normal frame angle [deg], see Figure 2\\n                   DUI = displacement as defined in I2.1.2.2, not to be taken less than 5 [kt]\\n                   CFC = Crushing failure Class Factor from Table 1\\n                   CFF = Flexural failure Class Factor from Table 1\\n                   CFD = Load patch dimensions Class Factor from Table 1\\n\\n         (iv) The Bow area load characteristics for bow forms defined in I2.3.1 (vi) are determined as\\n         follows:\\n\\n         (a) Shape coefficient, fai, is to be taken as\\n\\n             fai = i / 30\\n\\n         (b) Force, Fi:\\n\\n             Fi = fai ꞏ CFCV ꞏ DUI0.47 [MN]\\n\\n\\n                                                   I2-5                   IACS Req. 2006/Rev.4 2019\\n\\f                                                                                                        I2\\n\\n\\n\\nI2       (c) Line load, Qi:\\n(cont)\\n             Qi = Fi 0.22 ꞏ CFQV [MN/m]\\n\\n         (d) Pressure, Pi:\\n\\n             Pi = F0.56 ꞏ CFPV [MPa]\\n\\n             where      i = sub-region considered\\n                         = waterline angle [deg], see Figure 2\\n                        DUI = displacement as defined in I2.1.2.2, not to be taken less than 5 [kt]\\n                        CFCV = Crushing failure Class Factor from Table 2\\n                        CFQV = Line load Class Factor from Table 2\\n                        CFPV = Pressure Class Factor from Table 2\\n\\n\\n\", \"origin\": {\"file\": \"data/requirements/IACS_I2_full.txt\", \"edition\": \"Rev.4 (December 2019)\", \"authority\": \"IACS\", \"selection\": {\"start\": 9791, \"end\": 13710, \"line_start\": 182, \"line_end\": 282, \"page_start\": 4, \"page_end\": 6}}}, {\"evidence_id\": \"E500\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#displacementAtUpperIceWaterline> <https://w3id.org/nltl/vocab#recommendedUnit> <http://qudt.org/vocab/unit/TON_Metric> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E501\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineLength> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Upper ice waterline length\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E502\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceWaterline> <https://w3id.org/nltl/vocab#namingRule> \\\"N4 - singular ASCII lowerCamelCase entity name derived from the linked regulatory role.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E503\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#sourceReference> \\\"IMO-070 | IMO_POLAR_CODE p.24 | 8.3.3.1.1; IMO-118 | IMO_POLAR_CODE p.43 | 4.2.2\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E504\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#ship> <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/nltl/vocab#benchmarkEntity> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E505\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineReferencePosition> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Batch 01 development): Upper ice waterline reference position is the benchmark representation of the linked requirement operand, relationship, evidence role, or controlled value. Exact scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E506\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#brashIceChannelResistanceAtUpperIceWaterline> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#benchmarkEntity> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E507\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <https://w3id.org/nltl/vocab#namingBasis> \\\"Benchmark-coined descriptive engineering term\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E508\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineDraught> <https://w3id.org/nltl/vocab#namingRule> \\\"N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E509\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineLength> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-0785\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E510\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/nltl/vocab#ship> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E511\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <https://w3id.org/nltl/vocab#namingRule> \\\"N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E512\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceWaterline> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-011\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E513\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <https://w3id.org/nltl/vocab#module> <https://w3id.org/nltl/vocab#moduleHull> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E514\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterline> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-011\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}], \"limits\": \"Ground RDF triples only; exact RDF terms, no inference, no blank-node equivalence, no numeric value coercion. Source quotations remain verbatim.\"}, \"change_manifest\": {\"status\": \"STRUCTURAL_CHANGES_RECORDED\", \"changes\": [{\"change_id\": \"6c4559ea35b52bb68b6a96b33ee0704cee276fc0a6fc83beeac819d3297f6b3e\", \"kind\": \"TARGET_APPLICABILITY\", \"removed_count\": 2, \"added_count\": 0, \"removal_required\": true}]}, \"prior_issues\": [], \"findings\": [], \"packet_sha256\": \"bb3bcc2b1c6fa346481e5983244e52854f2934147992441b51fe619dddc0a77b\", \"format_feedback\": {\"validation_errors\": [{\"code\": \"SOURCE_ID_KIND_MISMATCH\", \"path\": \"$.change_assessments[0].source_evidence_id\", \"category\": \"INVALID_SOURCE_QUOTATION\", \"expected\": \"source_evidence_id must identify a SOURCE entry\", \"observed\": \"\\\"<https://w3id.org/nltl/vocab#upperIceWaterline> <http://www.w3.org/2002/07/owl#d