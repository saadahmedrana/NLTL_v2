 \\\"edition\\\": \\\"Rev.4 (December 2019)\\\", \\\"edition_compatibility\\\": \\\"Explicit requested revision matched\\\", \\\"file\\\": \\\"data/requirements/IACS_I2_full.txt\\\", \\\"kind\\\": \\\"source\\\", \\\"passages\\\": [], \\\"reference\\\": \\\"UR I2\\\", \\\"skipped\\\": [{\\\"end\\\": 9791, \\\"reason\\\": \\\"WHOLE_PASSAGE_BUDGET_LIMIT\\\", \\\"start\\\": 9147}], \\\"status\\\": \\\"PASSAGE_LIMIT_EXHAUSTED\\\"}, {\\\"authority\\\": \\\"IACS\\\", \\\"characters\\\": 0, \\\"document_sha256\\\": \\\"7ad8d57459782b70809da479380584a57cf259c66d9ff286811c0248b02732d2\\\", \\\"edition\\\": \\\"Rev.4 (December 2019)\\\", \\\"edition_compatibility\\\": \\\"Explicit caller edition selection, not a finding that the unversioned citation legally prescribes this edition\\\", \\\"file\\\": \\\"data/requirements/IACS_I2_full.txt\\\", \\\"kind\\\": \\\"source\\\", \\\"passages\\\": [], \\\"reference\\\": \\\"UR I2\\\", \\\"skipped\\\": [{\\\"end\\\": 7327, \\\"reason\\\": \\\"WHOLE_PASSAGE_BUDGET_LIMIT\\\", \\\"start\\\": 4741}], \\\"status\\\": \\\"PASSAGE_LIMIT_EXHAUSTED\\\"}, {\\\"kind\\\": \\\"source\\\", \\\"reference\\\": \\\"UR F0\\\", \\\"status\\\": \\\"MISSING_DOCUMENT\\\"}, {\\\"authority\\\": \\\"IACS\\\", \\\"characters\\\": 0, \\\"document_sha256\\\": \\\"7ad8d57459782b70809da479380584a57cf259c66d9ff286811c0248b02732d2\\\", \\\"edition\\\": \\\"Rev.4 (December 2019)\\\", \\\"edition_compatibility\\\": \\\"Explicit caller edition selection, not a finding that the unversioned citation legally prescribes this edition\\\", \\\"file\\\": \\\"data/requirements/IACS_I2_full.txt\\\", \\\"kind\\\": \\\"source\\\", \\\"passages\\\": [], \\\"reference\\\": \\\"UR I2\\\", \\\"skipped\\\": [{\\\"end\\\": 56498, \\\"reason\\\": \\\"WHOLE_PASSAGE_BUDGET_LIMIT\\\", \\\"start\\\": 50184}], \\\"status\\\": \\\"PASSAGE_LIMIT_EXHAUSTED\\\"}, {\\\"kind\\\": \\\"source\\\", \\\"reference\\\": \\\"UR I3\\\", \\\"status\\\": \\\"MISSING_DOCUMENT\\\"}, {\\\"kind\\\": \\\"source\\\", \\\"reference\\\": \\\"PR 29\\\", \\\"status\\\": \\\"MISSING_DOCUMENT\\\"}, {\\\"authority\\\": \\\"IACS\\\", \\\"characters\\\": 0, \\\"document_sha256\\\": \\\"9ec1b5957c0967641d1e20f7edd92da71aed427e576fe383ddf152ea45e3acf9\\\", \\\"edition\\\": \\\"Rev.2 (April 2016)\\\", \\\"edition_compatibility\\\": \\\"Explicit requested revision matched\\\", \\\"file\\\": \\\"data/requirements/IACS_I1_Rev2_2016.txt\\\", \\\"kind\\\": \\\"source\\\", \\\"passages\\\": [], \\\"reference\\\": \\\"UR I1\\\", \\\"skipped\\\": [{\\\"end\\\": 5412, \\\"reason\\\": \\\"WHOLE_PASSAGE_BUDGET_LIMIT\\\", \\\"start\\\": 4307}], \\\"status\\\": \\\"PASSAGE_LIMIT_EXHAUSTED\\\"}]\", \"origin\": {\"context_field\": \"unresolvedSourceContext\"}}, {\"evidence_id\": \"E341\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineBreadth> <https://w3id.org/nltl/vocab#namingBasis> \\\"Applicable TRAFICOM regulation wording plus explicit engineering node/operand role\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E342\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineCenteredPosition> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-DEV-B01-235\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E343\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hasUpperIceWaterlineCase> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"I2-004\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E344\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E345\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-0546\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E346\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#upperIceWaterlineDisplacement\\\", \\\"kind\\\": \\\"QuantityProperty\\\", \\\"label\\\": \\\"Upper ice waterline displacement\\\", \\\"localName\\\": \\\"upperIceWaterlineDisplacement\\\", \\\"parentOrRange\\\": \\\"http://qudt.org/schema/qudt/QuantityValue\\\", \\\"sourceRefs\\\": \\\"I2-004 | IACS_UR_I2 p.1 | I2.1.2.2\\\", \\\"unitIri\\\": \\\"http://qudt.org/vocab/unit/KiloTON_Metric\\\", \\\"unitSymbol\\\": \\\"kt\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E347\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#ship> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E348\", \"kind\": \"SOURCE\", \"text\": \"         I2.13.1 Application\\n\\n         I2.13.1.1 A ramming impact on the bow is the design scenario for the evaluation of the\\n         longitudinal strength of the hull.\\n\\n\\n\\n\\n                                                       I2-17                       IACS Req. 2006/Rev.4 2019\\n\\f                                                                                                            I2\\n\\n\\n         I2.13.1.2 Intentional ramming is not considered as a design scenario for ships which are\\nI2       designed with vertical or bulbous bows, see I1.1.6. Hence the longitudinal strength\\n(cont)   requirements given in I2.13 is not to be considered for ships with stem angle stem equal to or\\n         larger than 80 deg.\\n\\n         I2.13.1.3 Ice loads are only to be combined with still water loads. The combined stresses\\n         are to be compared against permissible bending and shear stresses at different locations\\n         along the ship’s length. In addition, sufficient local buckling strength is also to be verified.\\n\\n\", \"origin\": {\"file\": \"data/requirements/IACS_I2_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 50224, \"end\": 51251}}}, {\"evidence_id\": \"E349\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineCenteredPosition> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Controlled benchmark value used instead of an unconstrained text literal.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E350\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#situatedAboveLowerIceWaterline> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-016\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E351\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"iri\\\": \\\"https://w3id.org/nltl/vocab#benchmarkEntity\\\", \\\"kind\\\": \\\"Class\\\", \\\"label\\\": \\\"Benchmark entity\\\", \\\"localName\\\": \\\"benchmarkEntity\\\", \\\"mapping_basis\\\": \\\"Ontology declaration (registry row not required)\\\", \\\"types\\\": [\\\"http://www.w3.org/2002/07/owl#Class\\\"]}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E352\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"iri\\\": \\\"https://w3id.org/nltl/vocab#ship\\\", \\\"kind\\\": \\\"Class\\\", \\\"label\\\": \\\"Ship\\\", \\\"localName\\\": \\\"ship\\\", \\\"mapping_basis\\\": \\\"Ontology declaration (registry row not required)\\\", \\\"types\\\": [\\\"http://www.w3.org/2002/07/owl#Class\\\"]}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E353\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#minimumRequiredPowerAtLowerIceWaterline> <https://w3id.org/nltl/vocab#stage1LocalName> \\\"minimumRequiredPowerAtLowerIceWaterline\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E354\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineReferencePosition> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Upper ice waterline reference position\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E355\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#lowerIceWaterline> <https://w3id.org/nltl/vocab#stage1LocalName> \\\"lowerIceWaterline\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E356\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#usedToReachLowerIceWaterline> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-016\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E357\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineDisplacement> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-DEV-R9-0333\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E358\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterline> <https://w3id.org/nltl/vocab#namingBasis> \\\"Verified exact implementation term\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E359\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#evidenceExcerpt> \\\"This chapter applies to: fishing vessels of 24 metres in length overall and above; pleasure yachts of 300 gross tonnage and upwards not engaged in trade; and cargo ships of 300 gross tonnage and upwards but below 500 gross tonnage.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E360\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#minimumRequiredPowerAtUpperIceWaterline> <https://w3id.org/nltl/vocab#evidenceExcerpt> \\\"To qualify for ice class IA Super, IA, IB or IC, a ship the keel of which is laid or which is at a similar stage of construction on or after 1 September 2003 shall comply with the following requirements regarding its engine output. The engine output requirement shall be calculated for two draughts by formula 3.1. Draughts to be used are the maximum draught a...\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E361\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineCase> <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/nltl/vocab#designCondition> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E362\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#minimumRequiredPowerAtLowerIceWaterline> <https://w3id.org/nltl/vocab#namingRule> \\\"N3 - remove unit from the identifier and retain it in unit/quantity metadata\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E363\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipDisplacementFactor> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Ship displacement factor\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E364\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#module> <https://w3id.org/nltl/vocab#moduleCore> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E365\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineLength> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#ObjectProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E366\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Stage 1): candidate concept for pleasureYacht derived from the linked locked requirements; scope and final semantics require vocabulary approval.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E367\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#upperIceWaterlineCenteredPosition> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Batch 01 development): Upper ice waterline centered position is the benchmark representation of the linked requirement operand, relationship, evidence role, or controlled value. Exact scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E368\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#namingRule> \\\"N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E369\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#minimumRequiredPowerAtLowerIceWaterline> <http://www.w3.org/2000/01/rdf-schema#range> <http://qudt.org/schema/qudt/QuantityValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E370\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hasUpperIceWaterlineCase> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R9 development): Has upper ice waterline case represents the linked requirement entity, relationship, value, evidence role, or quantity; its scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E371\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#waterlineCaseDisplacement> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#upperIceWaterlineCase> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E372\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#waterlineCaseDisplacement\\\", \\\"kind\\\": \\\"QuantityProperty\\\", \\\"label\\\": \\\"Waterline case displacement\\\", \\\"localName\\\": \\\"waterlineCaseDisplacement\\\", \\\"parentOrRange\\\": \\\"http://qudt.org/schema/qudt/QuantityValue\\\", \\\"sourceRefs\\\": \\\"I2-004 | IACS_UR_I2 p.1 | I2.1.2.2\\\", \\\"unitIri\\\": \\\"http://qudt.org/vocab/unit/KiloTON_Metric\\\", \\\"unitSymbol\\\": \\\"kt\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E373\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#minimumRequiredPowerAtLowerIceWaterline> <https://w3id.org/nltl/vocab#unitSymbol> \\\"kW\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E374\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#usedToReachLowerIceWaterline> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Typed literal required for applicability, state, identification, or non-quantity evidence.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E375\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nlt