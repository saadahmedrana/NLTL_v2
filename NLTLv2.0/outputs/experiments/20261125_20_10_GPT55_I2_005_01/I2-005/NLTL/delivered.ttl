@prefix ex: <https://w3id.org/nltl/shapes/I2-005#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:I2-005-BottomLowerRegionBoundaryShape
    a sh:NodeShape ;
    rdfs:label "I2-005 / I2.2.5 bottom-lower region boundary point shell inclination"@en ;
    rdfs:comment "Activated only for the caller-admitted complete nltl:ship population. The caller admission is an external research-scope attestation and is not an independent certification of Polar Class eligibility, governing edition, construction date, or real-vessel applicability."@en ;
    ex:sourceRequirementId "I2-005" ;
    ex:sourceClause "I2.2.5" ;
    ex:sourceDocument "UR I2 Structural Requirements for Polar Class Ships" ;
    ex:sourceDocumentSha256 "7ad8d57459782b70809da479380584a57cf259c66d9ff286811c0248b02732d2" ;
    ex:sourceSelectionSha256 "690e41194055f2b890c1646217f46632461cd8facb426a21578401b007d777a4" ;
    ex:sourceSelectionStart "3906"^^xsd:integer ;
    ex:sourceSelectionEnd "4058"^^xsd:integer ;
    ex:sourceText """I2.2.5 The boundary between the bottom and lower regions is to be taken at the point where
         the shell is inclined 7° from horizontal.""" ;
    ex:admissionDeclarationSha256 "e22102a9d89fbb7bcbb7eeeef49191a2de15ecdb010a3148fd853f148d559169" ;
    ex:scopeDefinitionSha256 "4b23be7162740a4bd5141d0589861a594660fd48d6a0312f9e57cfb4c4381137" ;
    ex:applicabilityNote "Visible source context states: I2.1.1 This UR applies to Polar Class ships according to UR I1. UR I1 eligibility and edition selection are caller-admitted external research assumptions, not inferred or re-certified by this shape."@en ;
    ex:representationNote "The supplied ontology represents the source phrase 'where the shell is inclined 7° from horizontal' through nltl:shellInclinationAngle on the nltl:hullBoundaryPoint reached by nltl:hasBottomRegionLowerRegionBoundaryPoint. No separate horizontal-reference property was supplied; no additional datum is invented here."@en ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ;
        sh:name "bottom/lower region boundary point"@en ;
        sh:description "For each admitted ship, the bottom/lower region boundary is represented by a hull boundary point satisfying I2.2.5."@en ;
        sh:minCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class nltl:hullBoundaryPoint ;
        sh:node ex:I2-005-BoundaryPointShape ;
        sh:message "I2.2.5 requires the boundary between the bottom and lower regions to be taken at the point where the shell is inclined 7 degrees from horizontal."@en ;
    ] .

ex:I2-005-BoundaryPointShape
    a sh:NodeShape ;
    rdfs:label "I2-005 boundary point inclination condition"@en ;
    sh:property [
        sh:path nltl:shellInclinationAngle ;
        sh:name "shell inclination angle"@en ;
        sh:description "The represented boundary point must carry a QUDT quantity value for shell inclination angle."@en ;
        sh:minCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class qudt:QuantityValue ;
        sh:node ex:I2-005-SevenDegreeQuantityValueShape ;
        sh:message "The bottom/lower region boundary point must have shell inclination angle recorded as a QUDT QuantityValue equal to 7 degrees."@en ;
    ] .

ex:I2-005-SevenDegreeQuantityValueShape
    a sh:NodeShape ;
    rdfs:label "I2-005 exact seven degree quantity value"@en ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:name "numeric value"@en ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "7"^^xsd:decimal ;
        sh:maxInclusive "7"^^xsd:decimal ;
        sh:message "The shell inclination numeric value must be exactly 7 as an xsd:decimal; no tolerance is supplied or implied."@en ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:name "unit"@en ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:hasValue unit:DEG ;
        sh:in ( unit:DEG ) ;
        sh:message "The shell inclination angle unit must be the canonical QUDT degree unit http://qudt.org/vocab/unit/DEG."@en ;
    ] .
