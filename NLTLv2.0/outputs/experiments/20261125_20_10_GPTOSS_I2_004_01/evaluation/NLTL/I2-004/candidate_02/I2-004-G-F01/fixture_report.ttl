@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vocab: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The upper‑ice‑waterline displacement (DUI) must equal the greatest displacement among the associated waterline cases." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The upper‑ice‑waterline displacement (DUI) must equal the greatest displacement among the associated waterline cases." ;
                    sh:select """ 
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX vocab: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this WHERE {
                $this vocab:upperIceWaterlineDisplacement ?shipQty .
                ?shipQty qudt:numericValue ?shipVal .
                $this vocab:hasUpperIceWaterlineCase ?case .
                ?case vocab:waterlineCaseDisplacement ?caseQty .
                ?caseQty qudt:numericValue ?caseVal .
            }
            GROUP BY $this ?shipVal
            HAVING ( ?shipVal != MAX(?caseVal) )
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape vocab:ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ] .

