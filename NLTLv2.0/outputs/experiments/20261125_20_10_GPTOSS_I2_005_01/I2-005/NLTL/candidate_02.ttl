@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
# Default prefix for local shape IRIs – can be any IRI that serves as a base.
@prefix :     <http://example.org/shapes#> .

# --------------------------------------------------------------------
# Shape for ships – enforce that each ship has a bottom‑region boundary
# point whose shell inclination angle is exactly 7 deg (requirement I2‑005,
# clause I2.2.5).
# --------------------------------------------------------------------
:ShipBoundaryShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    rdfs:comment "I2.2.5 – The boundary between the bottom and lower regions is to be taken at the point where the shell is inclined 7° from horizontal." ;
    sh:property [
        sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ;
        sh:minCount 1 ;
        sh:node :HullBoundaryPointShape ;
        sh:description "Each ship must reference a hull‑boundary point that defines the bottom/lower‑region limit." ;
    ] .

# --------------------------------------------------------------------
# Shape for the hull‑boundary point – it must carry a shell inclination
# angle quantity.
# --------------------------------------------------------------------
:HullBoundaryPointShape
    a sh:NodeShape ;
    sh:targetClass nltl:hullBoundaryPoint ;
    sh:property [
        sh:path nltl:shellInclinationAngle ;
        sh:minCount 1 ;
        sh:node :ShellInclinationAngleValueShape ;
        sh:description "The hull boundary point must have a shell inclination angle quantity." ;
    ] .

# --------------------------------------------------------------------
# Shape for the QUDT QuantityValue representing the shell inclination
# angle – it must be 7 deg.
# --------------------------------------------------------------------
:ShellInclinationAngleValueShape
    a sh:NodeShape ;
    sh:targetClass qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:hasValue "7"^^xsd:decimal ;
        sh:datatype xsd:decimal ;
        sh:description "Numeric value of the shell inclination angle must be 7." ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:class unit:DEG ;
        sh:description "Unit of the shell inclination angle must be degrees." ;
    ] .
