@prefix : <http://example.org/shapes#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ;
                            sh:resultMessage "Value does not have class unit:DEG" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
                            sh:sourceShape _:n7f0634243f444398a5d4e3ab7734ecbbb4 ;
                            sh:value unit:DEG ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ;
                            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination>->qudt:numericValue does not contain a value in the set: ['Literal(\"7\", datatype=xsd:decimal)']" ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:n7f0634243f444398a5d4e3ab7734ecbbb3 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/boundaryPoint> ;
                    sh:resultMessage "Value does not conform to Shape :ShellInclinationAngleValueShape. See details for more information." ;
                    sh:resultPath nltl:shellInclinationAngle ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:n7f0634243f444398a5d4e3ab7734ecbbb2 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape :HullBoundaryPointShape. See details for more information." ;
            sh:resultPath nltl:hasBottomRegionLowerRegionBoundaryPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:description "Each ship must reference a hull‑boundary point that defines the bottom/lower‑region limit." ;
                    sh:minCount 1 ;
                    sh:node :HullBoundaryPointShape ;
                    sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/boundaryPoint> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination>->qudt:numericValue does not contain a value in the set: ['Literal(\"7\", datatype=xsd:decimal)']" ;
            sh:resultPath qudt:numericValue ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n7f0634243f444398a5d4e3ab7734ecbbb3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ;
            sh:resultMessage "Value does not have class unit:DEG" ;
            sh:resultPath qudt:unit ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
            sh:sourceShape _:n7f0634243f444398a5d4e3ab7734ecbbb4 ;
            sh:value unit:DEG ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination>->qudt:numericValue does not contain a value in the set: ['Literal(\"7\", datatype=xsd:decimal)']" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n7f0634243f444398a5d4e3ab7734ecbbb3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ;
                    sh:resultMessage "Value does not have class unit:DEG" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:ClassConstraintComponent ;
                    sh:sourceShape _:n7f0634243f444398a5d4e3ab7734ecbbb4 ;
                    sh:value unit:DEG ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/boundaryPoint> ;
            sh:resultMessage "Value does not conform to Shape :ShellInclinationAngleValueShape. See details for more information." ;
            sh:resultPath nltl:shellInclinationAngle ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n7f0634243f444398a5d4e3ab7734ecbbb2 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ] .

_:n7f0634243f444398a5d4e3ab7734ecbbb2 sh:description "The hull boundary point must have a shell inclination angle quantity." ;
    sh:minCount 1 ;
    sh:node :ShellInclinationAngleValueShape ;
    sh:path nltl:shellInclinationAngle .

_:n7f0634243f444398a5d4e3ab7734ecbbb3 sh:datatype xsd:decimal ;
    sh:description "Numeric value of the shell inclination angle must be 7." ;
    sh:hasValue 7.0 ;
    sh:path qudt:numericValue .

_:n7f0634243f444398a5d4e3ab7734ecbbb4 sh:class unit:DEG ;
    sh:description "Unit of the shell inclination angle must be degrees." ;
    sh:hasValue unit:DEG ;
    sh:path qudt:unit .

