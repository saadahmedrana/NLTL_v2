@prefix : <http://example.org/shapes#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasBottomRegionLowerRegionBoundaryPoint" ;
            sh:resultPath nltl:hasBottomRegionLowerRegionBoundaryPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:description "Each ship must reference a hull‑boundary point that defines the bottom/lower‑region limit." ;
                    sh:minCount 1 ;
                    sh:node :HullBoundaryPointShape ;
                    sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ] ] .

