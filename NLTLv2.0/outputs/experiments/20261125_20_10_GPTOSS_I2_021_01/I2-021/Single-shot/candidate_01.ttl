@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix ex: <http://example.org/shapes#> .

# -----------------------------------------------------------------
# Shape for QUDT QuantityValue – enforces decimal numeric value and
# mandatory unit of millimetres (mm) as required by the source text.
# -----------------------------------------------------------------
ex:QuantityValueShape
    a sh:NodeShape ;
    sh:targetClass qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "QuantityValue must have a numeric value (decimal)." ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:message "QuantityValue must be expressed in millimetres (mm)." ;
    ] .

# -----------------------------------------------------------------
# Shape for Plating components referenced from a Ship.
# It validates that each plating element carries the three quantity
# properties defined in the UR I2‑021 requirement:
#   • iceLoadRequiredNetPlateThickness (tnet)
#   • corrosionAbrasionAllowance (ts)
#   • thickness (t – the resulting minimum shell plate thickness)
# The required relationship t = tnet + ts is documented in the
# sh:message; arithmetic validation is not performed because SHACL
# does not provide built‑in sum functions without custom extensions.
# -----------------------------------------------------------------
ex:PlatingShape
    a sh:NodeShape ;
    rdfs:label "Plating shape for UR I2‑021 shell plate thickness requirement" ;
    sh:targetObjectsOf nltl:hasPlating ;
    sh:property [
        sh:path nltl:iceLoadRequiredNetPlateThickness ;
        sh:node ex:QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Plating must have a net plate thickness required to resist ice loads (tnet)." ;
    ] ;
    sh:property [
        sh:path nltl:corrosionAbrasionAllowance ;
        sh:node ex:QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Plating must have a corrosion/abrasion allowance (ts)." ;
    ] ;
    sh:property [
        sh:path nltl:thickness ;
        sh:node ex:QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Plating must have a declared overall thickness (t)." ;
    ] ;
    sh:message """
    UR I2‑021 – Shell plate thickness requirement:
    The required minimum shell plate thickness, t, is defined by:
        t = tnet + ts   [mm]
    where tnet = iceLoadRequiredNetPlateThickness,
          ts   = corrosionAbrasionAllowance.
    All three quantities must be expressed in millimetres.
    """ .

# -----------------------------------------------------------------
# Shape for Ship – connects a ship to its plating and ensures that
# the plating nodes conform to the PlatingShape above.
# -----------------------------------------------------------------
ex:ShipPlatingShape
    a sh:NodeShape ;
    rdfs:label "Ship shape linking to Plating for UR I2‑021" ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPlating ;
        sh:node ex:PlatingShape ;
        sh:minCount 1 ;
        sh:message "A ship must have at least one plating component to which the thickness requirement applies." ;
    ] .

