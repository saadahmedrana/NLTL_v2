@prefix ex: <http://example.org/shapes#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/thickness> ;
                    sh:resultMessage "QuantityValue must be expressed in millimetres (mm)." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n887eccbb525e40e5988527b0261af934b2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/plating> ;
            sh:resultMessage "Plating must have a declared overall thickness (t)." ;
            sh:resultPath nltl:thickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n887eccbb525e40e5988527b0261af934b5 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/thickness> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/thickness> ;
                            sh:resultMessage "QuantityValue must be expressed in millimetres (mm)." ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:n887eccbb525e40e5988527b0261af934b2 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/plating> ;
                    sh:resultMessage "Plating must have a declared overall thickness (t)." ;
                    sh:resultPath nltl:thickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:n887eccbb525e40e5988527b0261af934b5 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/thickness> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/ship> ;
            sh:resultMessage "A ship must have at least one plating component to which the thickness requirement applies." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A ship must have at least one plating component to which the thickness requirement applies." ;
                    sh:minCount 1 ;
                    sh:node ex:PlatingShape ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/thickness> ;
            sh:resultMessage "QuantityValue must be expressed in millimetres (mm)." ;
            sh:resultPath qudt:unit ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n887eccbb525e40e5988527b0261af934b2 ] .

_:n887eccbb525e40e5988527b0261af934b5 sh:message "Plating must have a declared overall thickness (t)." ;
    sh:minCount 1 ;
    sh:node ex:QuantityValueShape ;
    sh:path nltl:thickness .

_:n887eccbb525e40e5988527b0261af934b2 sh:hasValue unit:MilliM ;
    sh:message "QuantityValue must be expressed in millimetres (mm)." ;
    sh:minCount 1 ;
    sh:path qudt:unit .

