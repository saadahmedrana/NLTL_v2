@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F03/addition1> ;
                    sh:resultMessage "Node ex:addition1->qudt:unit does not contain a value in the set: ['unit:MilliM']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n1ad44ead8e564635a58c85cfc3090ad0b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; rdfs:comment Literal(\"QuantityValue node that must encode the corrosion/abrasion addition as exactly 1.0 mm per I2‑11.3. Units and datatype are fixed by the locked representation context.\") ; sh:property [ rdfs:comment Literal(\"Numeric value must be exactly 1.0 (decimal), per the source requirement.\") ; sh:datatype xsd:decimal ; sh:maxInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:minInclusive Literal(\"1.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ rdfs:comment Literal(\"Unit must be the canonical QUDT millimetre unit.\") ; sh:hasValue unit:MilliM ; sh:path qudt:unit ] ; sh:targetClass qudt:QuantityValue ]. See details for more information." ;
            sh:resultPath ( nltl:hasInternalIceStrengthenedStructure nltl:internalStructureCorrosionAbrasionAddition ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ rdfs:comment "Each internal ice‑strengthened structure linked from a ship must have an associated corrosion/abrasion addition matching the QuantityValueShape." ;
                    sh:node [ a sh:NodeShape ;
                            rdfs:comment "QuantityValue node that must encode the corrosion/abrasion addition as exactly 1.0 mm per I2‑11.3. Units and datatype are fixed by the locked representation context." ;
                            sh:property [ rdfs:comment "Numeric value must be exactly 1.0 (decimal), per the source requirement." ;
                                    sh:datatype xsd:decimal ;
                                    sh:maxInclusive 1.0 ;
                                    sh:minInclusive 1.0 ;
                                    sh:path qudt:numericValue ],
                                [ rdfs:comment "Unit must be the canonical QUDT millimetre unit." ;
                                    sh:hasValue unit:MilliM ;
                                    sh:path qudt:unit ] ;
                            sh:targetClass qudt:QuantityValue ] ;
                    sh:path ( nltl:hasInternalIceStrengthenedStructure nltl:internalStructureCorrosionAbrasionAddition ) ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F03/addition1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F03/addition1> ;
            sh:resultMessage "Node ex:addition1->qudt:unit does not contain a value in the set: ['unit:MilliM']" ;
            sh:resultPath qudt:unit ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n1ad44ead8e564635a58c85cfc3090ad0b3 ] .

_:n1ad44ead8e564635a58c85cfc3090ad0b3 rdfs:comment "Unit must be the canonical QUDT millimetre unit." ;
    sh:hasValue unit:MilliM ;
    sh:path qudt:unit .

