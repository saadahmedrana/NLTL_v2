                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:description "Numeric value of the quantity (e.g., plate thickness)." ;
                            sh:minCount 1 ;
                            sh:path qudt:numericValue ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T023/thickness> ;
                    sh:resultMessage "Less than 1 values on ex:thickness->qudt:unit" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:description "Unit must be millimetre for plate thickness (as declared in the schema)." ;
                            sh:in ( <http://qudt.org/vocab/unit/MilliM> ) ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T023/case> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:decimal ; sh:description Literal(\"Numeric value of the quantity (e.g., plate thickness).\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:description Literal(\"Unit must be millimetre for plate thickness (as declared in the schema).\") ; sh:in ( <http://qudt.org/vocab/unit/MilliM> ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path qudt:unit ] ; sh:targetClass qudt:QuantityValue ]. See details for more information." ;
            sh:resultPath nltl:asBuiltPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n578e131970d84909ae71b7059bf7a445b5 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T023/thickness> ] .

