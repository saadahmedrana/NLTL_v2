@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F002/case> ;
            sh:resultMessage "Less than 1 values on ex:case->nltl:steelGradeRequirementCasePlating" ;
            sh:resultPath nltl:steelGradeRequirementCasePlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:plating ;
                    sh:description "Plating component to which this steel‑grade requirement applies (I2.12.1)." ;
                    sh:minCount 1 ;
                    sh:path nltl:steelGradeRequirementCasePlating ] ] .

