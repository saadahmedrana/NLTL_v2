@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F004/thickness> ;
                    sh:resultMessage "Value unit:UNITLESS not in list ['<http://qudt.org/vocab/unit/MilliM>']" ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:description "Unit must be millimetre for plate thickness (as declared in the schema)." ;
                            sh:in ( <http://qudt.org/vocab/unit/MilliM> ) ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ;
                    sh:value <http://qudt.org/vocab/unit/UNITLESS> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F004/case> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:decimal ; sh:description Literal(\"Numeric value of the quantity (e.g., plate thickness).\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:description Literal(\"Unit must be millimetre for plate thickness (as declared in the schema).\") ; sh:in ( <http://qudt.org/vocab/unit/MilliM> ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path <http://qudt.org/schema/qudt/unit> ] ; sh:targetClass qudt:QuantityValue ]. See details for more information." ;
            sh:resultPath nltl:asBuiltPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                    sh:description "As‑built plate thickness (quantity) required for the lookup." ;
                    sh:minCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ sh:description "Unit must be millimetre for plate thickness (as declared in the schema)." ;
                                    sh:in ( <http://qudt.org/vocab/unit/MilliM> ) ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:description "Numeric value of the quantity (e.g., plate thickness)." ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ;
                            sh:targetClass qudt:QuantityValue ] ;
                    sh:path nltl:asBuiltPlateThickness ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F004/thickness> ] .

