@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F008/case> ;
            sh:resultMessage "Node ex:case->nltl:tableReference does not contain a value in the set: ['nltl:iacsUrI2Table8']" ;
            sh:resultPath nltl:tableReference ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:class nltl:tableReferenceValue ;
                    sh:description "Explicit reference to IACS UR I2 Table 8 that supplies the allowable steel grades." ;
                    sh:hasValue nltl:iacsUrI2Table8 ;
                    sh:minCount 1 ;
                    sh:path nltl:tableReference ] ] .

