@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F014/case> ;
            sh:resultMessage "Lookup against Table 8 (I2.12.1) is required; table data not provided in the current evidence set – constraint is recorded as unresolved." ;
            sh:resultPath nltl:requiredHullStructuralSteelGrade ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeValue ;
                    sh:description "Required hull‑structural steel grade.  The grade must be **not less than** the grade given in Table 8 for the combination of thickness, polar class and material class (I2.12.1)." ;
                    sh:message "Lookup against Table 8 (I2.12.1) is required; table data not provided in the current evidence set – constraint is recorded as unresolved." ;
                    sh:minCount 1 ;
                    sh:path nltl:requiredHullStructuralSteelGrade ] ] .

