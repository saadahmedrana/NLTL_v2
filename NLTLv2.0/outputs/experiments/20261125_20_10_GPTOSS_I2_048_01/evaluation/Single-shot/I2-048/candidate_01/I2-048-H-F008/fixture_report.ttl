                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path qudt:unit ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F008/thickness> ;
                    sh:resultMessage "Less than 1 values on ex:thickness->qudt:numericValue" ;
