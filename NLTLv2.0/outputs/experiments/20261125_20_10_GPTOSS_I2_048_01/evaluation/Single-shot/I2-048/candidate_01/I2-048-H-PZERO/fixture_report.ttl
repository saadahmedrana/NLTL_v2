@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-PZERO/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasSteelGradeRequirementCase" ;
            sh:resultPath nltl:hasSteelGradeRequirementCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:steelGradeRequirementCase ;
                    sh:description "Each ship must have an associated steel‑grade requirement case for its hull plating (I2.12.1)." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasSteelGradeRequirementCase ] ] .

