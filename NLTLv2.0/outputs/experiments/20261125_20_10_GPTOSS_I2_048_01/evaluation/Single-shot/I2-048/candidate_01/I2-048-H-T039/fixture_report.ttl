@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T039/case> ;
            sh:resultMessage "Less than 1 values on ex:case->nltl:polarClass" ;
            sh:resultPath nltl:polarClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarClassValue ;
                    sh:description "Polar class of the ship (I2.12.1)." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarClass ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T039/thickness> ;
                    sh:resultMessage "Less than 1 values on ex:thickness->qudt:unit" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:description "Unit must be millimetre for plate thickness (as declared in the schema)." ;
                            sh:in ( <http://qudt.org/vocab/unit/MilliM> ) ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path qudt:unit ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T039/thickness> ;
                    sh:resultMessage "Less than 1 values on ex:thickness->qudt:numericValue" ;
                    sh:resultPath qudt:numericValue ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:description "Numeric value of the quantity (e.g., plate thickness)." ;
                            sh:minCount 1 ;
                            sh:path qudt:numericValue ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T039/case> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:decimal ; sh:description Literal(\"Numeric value of the quantity (e.g., plate thickness).\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:description Literal(\"Unit must be millimetre for plate thickness (as declared in the schema).\") ; sh:in ( <http://qudt.org/vocab/unit/MilliM> ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path qudt:unit ] ; sh:targetClass qudt:QuantityValue ]. See details for more information." ;
            sh:resultPath nltl:asBuiltPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nbb2677eb274f4f0287acdc2f2c473409b5 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T039/thickness> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T039/case> ;
            sh:resultMessage "Value does not have class qudt:QuantityValue" ;
            sh:resultPath nltl:asBuiltPlateThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
            sh:sourceShape _:nbb2677eb274f4f0287acdc2f2c473409b5 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T039/thickness> ] .

_:N135907088c5b41c292e6773f4b1dc4dc a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description "Numeric value of the quantity (e.g., plate thickness)." ;
            sh:minCount 1 ;
            sh:path qudt:numericValue ],
        [ sh:description "Unit must be millimetre for plate thickness (as declared in the schema)." ;
            sh:in ( <http://qudt.org/vocab/unit/MilliM> ) ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path qudt:unit ] ;
    sh:targetClass qudt:QuantityValue .

_:nbb2677eb274f4f0287acdc2f2c473409b5 sh:class qudt:QuantityValue ;
    sh:description "As‑built plate thickness (quantity) required for the lookup." ;
    sh:minCount 1 ;
    sh:node _:N135907088c5b41c292e6773f4b1dc4dc ;
    sh:path nltl:asBuiltPlateThickness .

