@prefix ex: <http://example.org/shacl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vocab: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F01/weld1> ;
                    sh:resultMessage "Weld does not satisfy the double‑continuous requirement for ice‑strengthened areas." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape ex:WeldRequirementShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F01/weld1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F01/ship> ;
            sh:resultMessage "Associated weld must satisfy the double‑continuous requirement when positioned in ice‑strengthened areas." ;
            sh:resultPath vocab:hasWeld ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Associated weld must satisfy the double‑continuous requirement when positioned in ice‑strengthened areas." ;
                    sh:node ex:WeldRequirementShape ;
                    sh:path vocab:hasWeld ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-066-F01/weld1> ] .

