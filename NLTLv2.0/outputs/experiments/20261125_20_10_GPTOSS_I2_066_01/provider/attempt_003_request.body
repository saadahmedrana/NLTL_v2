 {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E254\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weldType> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Stage 1 controlled-enumeration string\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E255\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO26-002\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E256\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#supportsIceStrengthenedFrames> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-054\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E257\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#continuousPropulsionPowerAvailableInIce> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#ObjectProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E258\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#hullAreaValue\\\", \\\"kind\\\": \\\"Class\\\", \\\"label\\\": \\\"Hull area value\\\", \\\"localName\\\": \\\"hullAreaValue\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#benchmarkEntity\\\", \\\"sourceRefs\\\": \\\"\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E259\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Oil tanker\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E260\", \"kind\": \"RDF_FACT\", \"text