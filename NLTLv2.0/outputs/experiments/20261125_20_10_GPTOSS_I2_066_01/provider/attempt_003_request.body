": \"ontology_evidence\"}}, {\"evidence_id\": \"E286\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceOriginType> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-DEV-R9-0174\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E287\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceTypeClassification> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#ObjectProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E288\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#firstYearIce> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-004\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E289\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hullAreaValue> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E290\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#firstYearIce> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://w3id.org/nltl/vocab#iceTypeValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E291\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#frameSpanWithinIceStrengtheningZone\\\", \\\"kind\\\": \\\"QuantityProperty\\\", \\\"label\\\": \\\"Frame span within ice strengthening zone\\\", \\\"localName\\\": \\\"frameSpanWithinIceStrengtheningZone\\\", \\\"parentOrRange\\\": \\\"http://qudt.org/schema/qudt/QuantityValue\\\", \\\"sourceRefs\\\": \\\"TRF-045 | TRAFICOM p.19 | 4.4.2.1\\\", \\\"unitIri\\\": \\\"http://qudt.org/vocab/unit/M\\\", \\\"unitSymbol\\\": \\\"m\\\"}\", \"origin\": {\"context_field\": \"schema