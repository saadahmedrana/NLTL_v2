"}}, {\"evidence_id\": \"E155\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#iceTypeClassification\\\", \\\"kind\\\": \\\"ObjectProperty\\\", \\\"label\\\": \\\"Ice type classification\\\", \\\"localName\\\": \\\"iceTypeClassification\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#iceTypeValue\\\", \\\"sourceRefs\\\": \\\"IMO-004 | IMO_POLAR_CODE p.9 | 2.4; IMO-006 | IMO_POLAR_CODE p.9 | 2.8; IMO-008 | IMO_POLAR_CODE p.10 | 2.15\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E156\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#firstYearIce> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"First year ice\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E157\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hullRegionValue> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Explicit entity/node type needed for targeting, traversal, repeatable cases, or evidence attachment.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E158\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipIceStrengthened> <http://www.w3.org/2004/02/skos/core#altLabel> \\\"ship_ice_strengthened\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E159\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#sidescuttleInIceBelt> <https://w3id.org/nltl/vocab#stage1LocalName> \\\"sidescuttleInIceBelt\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E160\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/nltl/vocab#ship> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E161\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceStrengthenedArea> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"I2-026\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E162\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceTypeValue> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-004\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E163\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#withinIceStrengthenedArea> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Typed literal required for applicability, state, identification, or non-quantity evidence.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E164\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <http://www.w3.org/2004/02/skos/core#altLabel> \\\"passenger_ship\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E165\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"declaration_evidence\\\": {\\\"numericValue\\\": {\\\"@id\\\": \\\"qudt:numericValue\\\", \\\"@type\\\": \\\"xsd:decimal\\\"}, \\\"unit\\\": {\\\"@id\\\": \\\"qudt:unit\\\", \\\"@type\\\": \\\"@id\\\"}}, \\\"iri\\\": \\\"http://qudt.org/schema/qudt/unit\\\", \\\"kind\\\": \\\"ObjectProperty\\\", \\\"localName\\\": \\\"unit\\\", \\\"mapping_basis\\\": \\\"Declared JSON-LD schema/locked_representation_context.jsonld\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E166\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#operatingIceType> <http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E167\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO26-002\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E168\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hullRegionValue> <https://w3id.org/nltl/vocab#namingBasis> \\\"Applicable TRAFICOM regulation wording plus explicit engineering node/operand role\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E169\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#evidenceExcerpt> \\\"This chapter applies to: fishing vessels of 24 metres in length overall and above; pleasure yachts of 300 gross tonnage and upwards not engaged in trade; and cargo ships of 300 gross tonnage and upwards but below 500 gross tonnage.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E170\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-0528\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E171\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#otherIceStrengthenedAreaValue> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-DEV-R9-0240\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E172\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"xsd:boolean\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#locatedWithinIceBelt\\\", \\\"kind\\\": \\\"DatatypeProperty\\\", \\\"label\\\": \\\"Located within ice belt\\\", \\\"localName\\\": \\\"locatedWithinIceBelt\\\", \\\"parentOrRange\\\": \\\"http://www.w3.org/2001/XMLSchema#boolean\\\", \\\"sourceRefs\\\": \\\"TRF-053 | TRAFICOM p.21-22 | 4.5.1\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E173\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO26-016\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E174\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#sidescuttleInIceBelt> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Sidescuttle in ice belt\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E175\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceType> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-0381\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E176\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipIceStrengthened> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO26-007\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E177\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#weld\\\", \\\"kind\\\": \\\"Class\\\", \\\"label\\\": \\\"Weld\\\", \\\"localName\\\": \\\"weld\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#benchmarkEntity\\\", \\\"sourceRefs\\\": \\\"I2-066 | IACS_UR_I2 p.21 | I2.18.2\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E178\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#stage1LocalName> \\\"fishingVessel\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E179\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#terminatesWithinIceStrengthenedArea> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"I2-026\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E180\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#stage1LocalName> \\\"pleasureYacht\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E181\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#sidescuttleInIceBelt> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Explicit binary applicability/state semantics from the linked requirement\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E182\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#operatingIceType> <https://w3id.org/nltl/vocab#evidenceExcerpt> \\\"Scantlings of category A ships shall be approved by the Administration, or a recognized organization accepted by it, taking into account standards acceptable to the Organization or other standards offering an equivalent level of safety; scantlings of category B ships shall be approved by the Administration, or a recognized organization accepted by it, taking...\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E183\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#supportsIceStrengthenedFrames> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Batch 01 development): Supports ice strengthened frames is the benchmark representation of the linked requirement operand, relationship, evidence role, or controlled value. Exact scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E184\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#navigatingInIce> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#benchmarkEntity> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E185\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceTypeValue> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-006\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E186\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/nltl/vocab#ship> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E187\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Explicit engineering entity/artifact class set\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E188\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceTypeClassification> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R9 development): Ice type classification represents the linked requirement entity, relationship, value, evidence role, or quantity; its scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E189\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#markingPlainlyVisibleInIceConditions> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-DEV-R9-0214\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E190\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceStrengthenedArea> <https://w3id.org/nltl/vocab#stage1LocalName> \\\"iceStrengthenedArea\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E191\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceOriginType> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-004\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E192\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipIceStrengthened> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Ship ice strengthened\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E193\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#sourceAlias> \\\"pleasure_yacht\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E194\", \"kind\": \"SOURCE\", \"text\": \"         Table 1 - Polar Class descriptions\\n\\n\\n           Polar Class       Ice descriptions (based on WMO Sea Ice Nomenclature)\\n\\n                PC 1         Year-round operation in all polar waters\\n\\n                PC 2         Year-round operation in moderate multi-year ice conditions\\n                             Year-round operation in second-year ice which may include multi-\\n                PC 3\\n                             year ice inclusions.\\n                             Year-round operation in thick first-year ice which may include old\\n                PC 4\\n                             ice inclusions\\n                             Year-round operation in medium first-year ice which may include\\n                PC 5\\n                             old ice inclusions\\n                             Summer/autumn operation in medium first-year ice which may\\n                PC 6\\n                             include old ice inclusions\\n                             Summer/autumn operation in thin first-year ice which may include\\n                PC 7\\n                             old ice inclusions\\n\\n\", \"origin\": {\"file\": \"data/requirements/IACS_I1_Rev2_2016.txt\", \"edition\": \"Rev.2 (April 2016)\", \"authority\": \"IACS\", \"selection\": {\"start\": 4307, \"end\": 5412, \"line_start\": 78, \"line_end\": 102, \"page_start\": 2, \"page_end\": 2}}}, {\"evidence_id\": \"E195\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceLoadSourceType> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Ice load source type\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E196\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#continuousPropulsionPowerAvailableInIce> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-037\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E197\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hullRegionValue> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Batch 01 development): Hull region value is the benchmark representation of the linked requirement operand, relationship, evidence role, or controlled value. Exact scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E198\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipIceStrengthened> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-0679\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"