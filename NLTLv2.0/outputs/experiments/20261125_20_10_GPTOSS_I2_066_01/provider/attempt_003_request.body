December 2019)\\\", \\\"edition_compatibility\\\": \\\"Explicit caller edition selection, not a finding that the unversioned citation legally prescribes this edition\\\", \\\"file\\\": \\\"data/requirements/IACS_I2_full.txt\\\", \\\"kind\\\": \\\"source\\\", \\\"passages\\\": [], \\\"reference\\\": \\\"UR I2\\\", \\\"skipped\\\": [{\\\"end\\\": 7750, \\\"reason\\\": \\\"WHOLE_PASSAGE_BUDGET_LIMIT\\\", \\\"start\\\": 7327}, {\\\"end\\\": 13710, \\\"reason\\\": \\\"WHOLE_PASSAGE_BUDGET_LIMIT\\\", \\\"start\\\": 9791}], \\\"status\\\": \\\"PASSAGE_LIMIT_EXHAUSTED\\\"}, {\\\"kind\\\": \\\"source\\\", \\\"reference\\\": \\\"UR I3\\\", \\\"status\\\": \\\"MISSING_DOCUMENT\\\"}, {\\\"kind\\\": \\\"source\\\", \\\"reference\\\": \\\"PR 29\\\", \\\"status\\\": \\\"MISSING_DOCUMENT\\\"}]\", \"origin\": {\"context_field\": \"unresolvedSourceContext\"}}, {\"evidence_id\": \"E137\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#operatingIceType> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Stage 1 controlled-enumeration string\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E138\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#sidescuttleInIceBelt> <http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#boolean> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E139\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hasWeld> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R7): links a ship to each weld in scope for the I2.18.2 welding requirement.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E140\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO26-002\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E141\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#otherIceStrengthenedArea> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Other ice strengthened area\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E142\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceTypeValue> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E143\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipIceStrengthened> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Stage 1): candidate concept for shipIceStrengthened derived from the linked locked requirements; scope and final semantics require vocabulary approval.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E144\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceType> <https://w3id.org/nltl/vocab#sourceAlias> \\\"ice_type\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E145\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weldType> <http://www.w3.org/2004/02/skos/core#altLabel> \\\"weldType\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E146\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceType> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#DatatypeProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E147\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#operatingIceType> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#benchmarkEntity> .\", \"origin\": {\"context_field\": \"ontology