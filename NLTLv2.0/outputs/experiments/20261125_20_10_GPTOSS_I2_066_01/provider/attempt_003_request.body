ng> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E430\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weldTypeValue> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Explicit entity/node type needed for targeting, traversal, repeatable cases, or evidence attachment.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E431\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipIceStrengthened> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-049\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E432\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#operatingIceType> <https://w3id.org/nltl/vocab#sourceReference> \\\"IMO-032 | IMO_POLAR_CODE p.17 | 3.3.2.1-.3; IMO-049 | IMO_POLAR_CODE p.21 | 6.3.3.1-.3\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E433\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#frameSpanWithinIceStrengtheningZone> <http://www.w3.org/2000/01/rdf-schema#range> <http://qudt.org/schema/qudt/QuantityValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E434\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#continuousPropulsionPowerAvailableInIce> <https://w3id.org/nltl/vocab#namingBasis> \\\"Applicable TRAFICOM regulation wording plus explicit engineering node/operand role\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E435\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceLoadSourceType> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-057\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_