dSourceType\\\", \\\"https://w3id.org/nltl/vocab#supportsIceStrengthenedFrames\\\", \\\"https://w3id.org/nltl/vocab#internalIceStrengthenedStructure\\\", \\\"https://w3id.org/nltl/vocab#firstYearIce\\\", \\\"https://w3id.org/nltl/vocab#hullAreaValue\\\", \\\"https://w3id.org/nltl/vocab#hullRegionValue\\\"]}]\", \"origin\": {\"context_field\": \"retrieved_schema_evidence\"}}, {\"evidence_id\": \"E120\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designOperationSpeedInIce> <https://w3id.org/nltl/vocab#sourceAlias> \\\"designOperationSpeedInIce_kn\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E121\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designOperationSpeedInIce> <https://w3id.org/nltl/vocab#namingBasis> \\\"Unit-stripped normalized regulatory variable\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E122\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Passenger ship\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E123\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#stage1LocalName> \\\"passengerShip\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E124\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#firstYearIce\\\", \\\"kind\\\": \\\"NamedIndividual\\\", \\\"label\\\": \\\"First year ice\\\", \\\"localName\\\": \\\"firstYearIce\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#iceTypeValue\\\", \\\"sourceRefs\\\": \\\"IMO-004 | IMO_POLAR_CODE p.9 | 2.4\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E125\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#frameSpanWithinIceStrengtheningZone> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#ObjectProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E126\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#continuousPropulsionPowerAvailableInIce> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Numeric operand, comparison value, formula input/output, or engineering measurement.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E127\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#markingPlainlyVisibleInIceConditions> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#DatatypeProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E128\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#continuousPropulsionPowerAvailableInIce> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Batch 01 development): Continuous propulsion power available in ice is the benchmark representation of the linked requirement operand, relationship, evidence role, or controlled value. Exact scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E129\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E130\", \"kind\": \"CONTEXT_STATUS\", \"text\": \"[{\\\"evidence\\\": {\\\"authority\\\": \\\"IACS\\\", \\\"characters\\\": 4766, \\\"document_sha256\\\": \\\"9ec1b5957