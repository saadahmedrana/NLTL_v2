_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E63\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#otherIceStrengthenedArea> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://w3id.org/nltl/vocab#hullAreaValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E64\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/nltl/vocab#ship> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E65\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"xsd:string\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#operatingIceType\\\", \\\"kind\\\": \\\"DatatypeProperty\\\", \\\"label\\\": \\\"Operating ice type\\\", \\\"localName\\\": \\\"operatingIceType\\\", \\\"parentOrRange\\\": \\\"http://www.w3.org/2001/XMLSchema#string\\\", \\\"sourceRefs\\\": \\\"IMO-032 | IMO_POLAR_CODE p.17 | 3.3.2.1-.3; IMO-049 | IMO_POLAR_CODE p.21 | 6.3.3.1-.3\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E66\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceStrengthenedArea> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-0376\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E67\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceTypeClassification> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-006\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E68\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceStrengthenedArea> <https://w3id.org/nltl/vocab#namingRule> \\\"N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E69\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weldTypeValue> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Weld type value\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E70\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weldType> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#weld> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E71\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceType> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Ice type\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E72\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#weldType\\\", \\\"kind\\\": \\\"ObjectProperty\\\", \\\"label\\\": \\\"Weld type\\\", \\\"localName\\\": \\\"weldType\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#weldTypeValue\\\", \\\"sourceRefs\\\": \\\"I2-066 | IACS_UR_I2 p.22 | I2.18.1; TRF-050 | TRAFICOM p.21 | 4.4.4.2\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E73\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#doubleContinuousWeld> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Controlled benchmark value used instead of an unconstrained text literal.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E74\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#otherIceStrengthenedArea> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Other ice strengthened area\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E75\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceTypeClassification> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Ice type classification\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E76\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weldTypeValue> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E77\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipOperatesInIceCoveredWaters> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Ship operates in ice covered waters\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E78\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#withinIceStrengthenedArea> <http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#boolean> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E79\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designOperationSpeedInIce> <http://www.w3.org/2004/02/skos/core#altLabel> \\\"designOperationSpeedInIce_kn\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E80\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#namingBasis> \\\"Benchmark-coined descriptive engineering term\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E81\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Oil tanker\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E82\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Stage 1): candidate concept for passengerShip derived from the linked locked requirements; scope and final semantics require vocabulary approval.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E83\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#frameSpanWithinIceStrengtheningZone> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#benchmarkEntity> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E84\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#iceOriginType\\\", \\\"kind\\\": \\\"ObjectProperty\\\", \\\"label\\\": \\\"Ice origin type\\\", \\\"localName\\\": \\\"iceOriginType\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#iceOriginValue\\\", \\\"sourceRefs\\\": \\\"IMO-004 | IMO_POLAR_CODE p.9 | 2.4\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E85\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weldTypeValue> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E86\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Fishing vessel\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E87\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weldType> <http://www.w3.org/2002/07/owl#deprecated> \\\"true\\\"^^<http://www.w3.org/2001/XMLSchema#boolean> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E88\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#terminatesWithinIceStrengthenedArea> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Terminates within ice strengthened area\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E89\", \"kind\": \"SOURCE\", \"text\": \"                                                                                                          I1\\n\\n\\n\\nI1        Polar Class Descriptions and Application\\n(August\\n(cont)\\n2006)\\n(Rev.1    I1.1     Application\\nJan\\n2007)     I1.1.1 The Unified Requirements for Polar Class ships apply to ships constructed of steel\\n(Corr.1   and intended for independent navigation in ice-infested polar waters.\\nOct\\n2007)     I1.1.2 Ships that comply with the UR I2 and UR I3 can be considered for a Polar Class\\n(Rev.2    notation as listed in Table 1. The requirements of UR I2 and UR I3 are in addition to the open\\nApr       water requirements of the Classification Society. If the hull and machinery are constructed\\n2016)     such as to comply with the requirements of different Polar Classes, then both the hull and\\n          machinery are to be assigned the lower of these classes in the Certificate of Classification.\\n          Compliance of the hull or machinery with the requirements of a higher Polar Class is also to\\n          be indicated in the Certificate of Classification or equivalent.\\n\\n          I1.1.3 Ships which are assigned a Polar Class notation and complying with the relevant\\n          requirements of UR I2 and UR I3 may be given the additional notation “Icebreaker”.\\n          “Icebreaker\\\" refers to any ship having an operational profile that includes escort or ice\\n          management functions, having powering and dimensions that allow it to undertake\\n          aggressive operations in ice-covered waters.\\n\\n          I1.1.4 For ships which are assigned a Polar Class notation, the hull form and propulsion\\n          power are to be such that the ship can operate independently and at continuous speed in a\\n          representative ice condition, as defined in Table 1 for the corresponding Polar Class. For\\n          ships and ship-shaped units which are intentionally not designed to operate independently in\\n          ice, such operational intent or limitations are to be explicitly stated in the Certificate of\\n          Classification or equivalent.\\n\\n          I1.1.5 For ships which are assigned a Polar Class notation PC 1 through PC 5, bows with\\n          vertical sides, and bulbous bows are generally to be avoided. Bow angles should in general\\n          be within the range specified in I2.3.1 (v).\\n\\n\\n          Note:\\n\\n          1.      UR I1 applies to ships contracted for construction on or after 1 July 2007.\\n\\n          2.      Rev.1 of this UR is to be uniformly applied by IACS Societies on ships contracted for\\n                  construction on and after 1 March 2008.\\n\\n          3.      Rev.2 of this UR is to be uniformly implemented by IACS Societies on ships contracted\\n                  for construction on and after 1 July 2017.\\n\\n          4.      The “contracted for construction” date means the date on which the contract to build the\\n                  vessel is signed between the prospective owner and the shipbuilder. For further details\\n                  regarding the date of “contract for construction”, refer to IACS Procedural Requirement\\n                  (PR) No. 29.\\n\\n\\n\\n\\n                                                  I1-1                  IACS Req. 2006/Rev.2 2016\\n\\f                                                                                                        I1\\n\\n\\n         I1.1.6 For ships which are assigned a Polar Class notation PC 6 and PC 7, and are\\nI1       designed with a bow with vertical sides or bulbous bows, operational limitations (restricted\\n(cont)   from intentional ramming) in design conditions are to be stated in the Certificate of\\n         Classification or equivalent.\\n\\n\", \"origin\": {\"file\": \"data/requirements/IACS_I1_Rev2_2016.txt\", \"edition\": \"Rev.2 (April 2016)\", \"authority\": \"IACS\", \"selection\": {\"start\": 0, \"end\": 3661, \"line_start\": 1, \"line_end\": 67, \"page_start\": 1, \"page_end\": 2}}}, {\"evidence_id\": \"E90\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#namingBasis> \\\"Benchmark-coined descriptive engineering term\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E91\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceLoadSourceTypeValue> <https://w3id.org/nltl/vocab#namingBasis> \\\"Applicable TRAFICOM regulation wording plus explicit engineering node/operand role\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E92\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#internalIceStrengthenedStructure> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Internal ice strengthened structure\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E93\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#otherIceStrengthenedArea> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R9 development): Other ice strengthened area represents the linked requirement entity, relationship, value, evidence role, or quantity; its scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E94\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceLoadSourceTypeValue> <https://w3id.org/nltl/vocab#namingRule> \\\"N4 - singular ASCII lowerCamelCase entity name derived from the linked regulatory role.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E95\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weldType> <https://w3id.org/nltl/vocab#namingRule> \\\"N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E96\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#locatedWithinIceBelt> <http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#boolean> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E97\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#hasWeld\\\", \\\"kind\\\": \\\"ObjectProperty\\\", \\\"label\\\": \\\"Has weld\\\", \\\"localName\\\": \\\"hasWeld\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#weld\\\", \\\"sourceRefs\\\": \\\"I2-066 | IACS_UR_I2 p.21 | I2.18.2\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E98\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#navigatingInIce> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Typed literal required for applicability, state, identification, or non-quantity evidence.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E99\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#frameSpanWithinIceStrengtheningZone> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Numeric operand, comparison value, formula input/output, or engineering measurement.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E100\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#operatingIceType> <https://w3id.org/nltl/vocab#namingRule> \\\"N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E101\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#passengerShip\\\", \\\"kind\\\": \\\"Class\\\", \\\"label\\\": \\\"Passenger ship\\\", \\\"localName\\\": \\\"passengerShip\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#ship\\\", \\\"sourceRefs\\\": \\\"IMO-070 | IMO_POLAR_CODE p.24 | 8.3.3.1.1; IMO-118 | IMO_POLAR_CODE p.43 | 4.2.2\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E102\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hullRegionValue> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Hull region value\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E103\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#sidescuttleInIceBelt> <https://w3id.org/nltl/vocab#module> <https://w3id.org/nltl/vocab#moduleHull> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E104\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#benchmarkEntity> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E105\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#markingPlainlyVisibleInIceConditions> <http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#boolean> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E106\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#withinIceStrengthenedArea> <https://w3id.org/nltl/vocab#namingRule> \\\"N4 - explicit regulatory concept in ASCII lowerCamelCase with an XSD datatype.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E107\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E108\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceStrengthenedArea> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#DatatypeProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E109\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipOperatesInIceCoveredWaters> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E110\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceOriginType> <http://www.w3.org/2000/01/rdf-schema#range> <https://w3id.org/nltl/vocab#iceOriginValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E111\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weldTypeValue> <https://w3id.org/nltl/vocab#namingRule> \\\"N4 - singular ASCII lowerCamelCase entity name derived from the linked regulatory role.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E112\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hullRegionValue> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-035\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E113\", \"kind\": \"SOURCE\", \"text\": \"                                                                                                           I2\\n\\n\\n\\nI2          Structural Requirements for Polar Class Ships\\n(August\\n(cont)\\n2006)       I2.1 General\\n(Rev.1\\nJan 2007)   I2.1.1 Application*\\n(Corr.1\\nOct 2007)   This UR applies to Polar Class ships according to UR I1.\\n(Rev.2\\nNov 2010)   I2.1.2 Definitions\\n(Rev.3\\nApr 2016)   I2.1.2.1 The length LUI is the distance, in m, measured horizontally from the fore side of the\\n(Rev.4      stem at the intersection with the upper ice waterline (UIWL) to the after side of the rudder\\nDec 2019)   post, or the centre of the rudder stock if there is no rudder post. LUI is not to be less than\\n            96%, and need not be greater than 97%, of the extreme length of the upper ice waterline\\n            (UIWL) measured horizontally from the fore side of the stem. In ships with unusual stern and\\n            bow arrangement the length LUI will be specially considered.\\n\\n            I2.1.2.2 The ship displacement DUI is the displacement, in kt, of the ship corresponding to the\\n            upper ice waterline (UIWL). Where multiple waterlines are used for determining the UIWL, the\\n            displacement is to be determined from the waterline corresponding to the greatest\\n            displacement.\\n\\n\", \"origin\": {\"file\": \"data/requirements/IACS_I2_full.txt\", \"edition\": \"Rev.4 (December 2019)\", \"authority\": \"IACS\", \"selection\": {\"start\": 0, \"end\": 1304, \"line_start\": 1, \"line_end\": 28, \"page_start\": 1, \"page_end\": 1}}}, {\"evidence_id\": \"E114\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#namingBasis> \\\"Benchmark-coined descriptive engineering term\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E115\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#otherIceStrengthenedArea> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"I2-009\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E116\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weldType> <http://purl.org/dc/terms/isReplacedBy> <https://w3id.org/nltl/vocab#frameShellWeldType> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E117\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#supportsIceStrengthenedFrames> <https://w3id.org/nltl/vocab#namingRule> \\\"N4 - explicit regulatory concept in ASCII lowerCamelCase with an XSD datatype.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E118\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weldType> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#ObjectProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E119\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"[{\\\"binding_search_truncated\\\": true, \\\"kind\\\": \\\"schema\\\", \\\"meaning\\\": \\\"Vocabulary/type/domain/range existence is not evidence of legal eligibility or of an applicability binding. Other-requirement mappings cannot be transferred automatically.\\\", \\\"query_sha256\\\": \\\"f9ed44fa8d4ad7e9c84ff7298152d528882e84a73d3c06119181a87d1d0fa66b\\\", \\\"representation_mappings\\\": [{\\\"model_paths\\\": [{\\\"fromOwner\\\": \\\"structuralMember\\\", \\\"toOwner\\\": \\\"memberSupport\\\", \\\"via\\\": \\\"hasMemberSupport\\\"}], \\\"owners\\\": {\\\"terminatesWithinIceStrengthenedArea\\\": \\\"structuralMember\\\"}, \\\"requirement_id\\\": \\\"I2-026\\\", \\\"scope\\\": \\\"OTHER_REQUIREMENT_NOT_TRANSFERABLE\\\", \\\"target_owner\\\": null}, {\\\"model_paths\\\": [], \\\"owners\\\": {\\\"iceOriginType\\\": \\\"ship\\\", \\\"iceTypeClas