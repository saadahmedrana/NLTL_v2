dence_id\": \"E299\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designOperationSpeedInIce> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#ObjectProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E300\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#doubleContinuousWeld> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Double continuous weld\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E301\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceOriginType> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Ice origin type\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E302\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceStrengthenedArea> <http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E303\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#terminatesWithinIceStrengthenedArea> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#structuralMember> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E304\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#evidenceExcerpt> \\\"This chapter applies to: fishing vessels of 24 metres in length overall and above; pleasure yachts of 300 gross tonnage and upwards not engaged in trade; and cargo ships of 300 gross tonnage and upwards but below 500 gross tonnage.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E305\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weldType> <http://www.w3.org/2000/01/rdf-schema#range> <https://w3id.org/nltl/vocab#weldTypeValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E306\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#frameSpanWithinIceStrengtheningZone> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-045\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E307\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hullAreaValue> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Hull area value\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E308\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designOperationSpeedInIce> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Design operation speed in ice\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E309\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceStrengthenedArea> <https://w3id.org/nltl/vocab#sourceAlias> \\\"iceStrengthenedArea\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E310\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceLoadSourceType> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-DEV-B01-125\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E311\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E312\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#locatedWithinIceBelt> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#benchmarkEntity> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E313\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hasWeld> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-R7-0004\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E314\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designOperationSpeedInIce> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-0195\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E315\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceOriginType> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R9 development): Ice origin type represents the linked requirement entity, relationship, value, evidence role, or quantity; its scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E316\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceStrengthenedArea> <https://w3id.org/nltl/vocab#sourceReference> \\\"I2-026 | IACS_UR_I2 p.10 | I2.5.3; I2-066 | IACS_UR_I2 p.22 | I2.18.1\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E317\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hullRegionValue> <https://w3id.org/nltl/vocab#namingRule> \\\"N4 - singular ASCII lowerCamelCase entity name derived from the linked regulatory role.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E318\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hasWeld> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#ship> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E319\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#doubleContinuousWeld> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#NamedIndividual> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E320\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weldType> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E321\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-118\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E322\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#otherIceStrengthenedAreaValue> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Other ice strengthened area value\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E323\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-110\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E324\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#locatedWithinIceBelt> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Located within ice belt\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E325\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#sourceReference> \\\"IMO26-002 | IMO_AMEND_2026 p.2 | Chapter 9-1 applicability; IMO26-016 | IMO_AMEND_2026 p.5 | Chapter 11-1 applicability\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E326\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#supportsIceStrengthenedFrames> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Supports ice strengthened frames\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E327\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#withinIceStrengthenedArea> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Batch 01 development): Within ice strengthened area is the benchmark representation of the linked requirement operand, relationship, evidence role, or controlled value. Exact scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E328\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceStrengthenedArea> <http://www.w3.org/2004/02/skos/core#altLabel> \\\"iceStrengthenedArea\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E329\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Pleasure yacht\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E330\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hullRegionValue> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E331\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weldType> <http://www.w3.org/2004/02/skos/core#changeNote> \\\"Retired in VOCAB-DEV-2026-08-13-BATCH01-R8.1-POSTCONFIRMATION: string representation cannot express the required Batch 01 node/value model.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E332\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Stage 1): candidate concept for cargoShip derived from the linked locked requirements; scope and final semantics require vocabulary approval.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E333\", \"kind\": \"SOURCE\", \"text\": \"         I2.11.3 Polar Class ships are to have a minimum corrosion/abrasion addition of ts = 1.0 mm\\n         applied to all internal structures within the ice-strengthened hull areas, including plated\\n         members adjacent to the shell, as well as stiffener webs and flanges.\\n\\n\\n\\n\\n                                                I2-15                   IACS Req. 2006/Rev.4 2019\\n\\f                                                                                                         I2\\n\\n\\n\", \"origin\": {\"file\": \"data/requirements/IACS_I2_full.txt\", \"edition\": \"Rev.4 (December 2019)\", \"authority\": \"IACS\", \"selection\": {\"start\": 43151, \"end\": 43644, \"line_start\": 820, \"line_end\": 831, \"page_start\": 15, \"page_end\": 16}}}, {\"evidence_id\": \"E334\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <http://www.w3.org/2004/02/skos/core#altLabel> \\\"oil_tanker\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E335\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#sidescuttleInIceBelt> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E336\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceType> <https://w3id.org/nltl/vocab#evidenceExcerpt> \\\"First-year ice means sea ice of not more than one winter growth developing from young ice with thickness from 0.3 m to 2.0 m.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E337\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceType> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-006\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E338\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#internalIceStrengthenedStructure> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Internal ice strengthened structure\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E339\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-0121\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E340\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designOperationSpeedInIce> <https://w3id.org/nltl/vocab#quantityKindLabel> \\\"Velocity\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E341\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#sidescuttleInIceBelt> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Stage 1): candidate concept for sidescuttleInIceBelt derived from the linked locked requirements; scope and final semantics require vocabulary approval.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E342\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#withinIceStrengthenedArea> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#DatatypeProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E343\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#terminatesWithinIceStrengthenedArea> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#DatatypeProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E344\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <http://www.w3.org/2004/02/skos/core#altLabel> \\\"cargo_ship\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E345\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceLoadSourceTypeValue> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Ice load source type value\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E346\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#frameSpanWithinIceStrengtheningZone> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Frame span within ice strengthening zone\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E347\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#withinIceStrengthenedArea> <https://w3id.org/nltl/vocab#namingBasis> \\\"Applicable TRAFICOM regulation wording plus explicit engineering node/operand role\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E348\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipOperatesInIceCoveredWaters> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-0681\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E349\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceLoadSourceTypeValue> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Explicit entity/node type needed for targeting, traversal, repeatable cases, or evidence attachment.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E350\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipOperatesInIceCoveredWaters> <https://w3id.org/nltl/vocab#sourceAlias> \\\"ship_operates_in_ice_covered_waters\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E351\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E352\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#locatedWithinIceBelt> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Typed literal required for applicability, state, identification, or non-quantity evidence.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E353\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipIceStrengthened> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Boolean semantic suffix/word rule\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E354\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#supportsIceStrengthenedFrames> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E355\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#operatingIceType> <https://w3id.org/nltl/vocab#module> <https://w3id.org/nltl/vocab#moduleMachinery> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E356\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceLoadSourceType> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Ice load source type\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E357\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#evidenceExcerpt> \\\"For passenger ships, a proper sized immersion suit or a thermal protective aid shall be provided for each person on board.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E358\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#sidescuttleInIceBelt> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#DatatypeProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E359\", \"kind\": \"SOURCE\", \"text\": \"         I2.3 Design ice loads\\nI2\\n(cont)   I2.3.1 General\\n\\n         (i) A glancing impact on the bow is the design scenario for determining the scantlings\\n         required to resist ice loads.\\n\\n         (ii) The design ice load is characterized by an average pressure (Pavg) uniformly distributed\\n         over a rectangular load patch of height (b) and width (w).\\n\\n         (iii) Within the Bow area of all Polar Class ships, and within the Bow Intermediate Icebelt\\n         area of Polar Class PC6 and PC7, the ice load parameters are functions of the actual bow\\n         shape. To determine the ice load parameters (Pavg, b and w), it is required to calculate the\\n         following ice load characteristics for sub-regions of the bow area; shape coefficient (fai), total\\n         glancing impact force (Fi), line load (Qi) and pressure (Pi).\\n\\n         (iv) In other ice-strengthened areas, the ice load parameters (Pavg, bNonBow and wNonBow) are\\n         determined independently of the hull shape and based on a fixed load patch aspect ratio, AR\\n         = 3.6.\\n\\n         (v) Design ice forces calculated according to I2.3.2.1 (iii) are applicable for bow forms where\\n         the buttock angle  at the stem is positive and less than 80 deg, and the normal frame angle\\n         ’ at the centre of the foremost sub-region, as defined in I2.3.2.1 (i), is greater than 10 deg.\\n\\n         (vi) Design ice forces calculated according to I2.3.2.1 (iv) are applicable for ships which are\\n         assigned the Polar Class PC6 or PC7 and have a bow form with vertical sides. This includes\\n         bows where the normal frame angles ’ at the considered sub-regions, as defined in I2.3.2.1\\n         (i), are between 0 and 10 deg.\\n\\n         (vii) For ships which are assigned the Polar Class PC6 or PC7, and equipped with bulbous\\n         bows, the design ice forces on the bow are to be determined according to I2.3.2.1 (iv). In\\n         addition, the design forces are not to be taken less than those given in I2.3.2.1 (iii), assuming\\n         fa = 0.6 and AR = 1.3.\\n\\n         (viii) For ships with bow forms other than those defined in (v) to (vii), design forces are to be\\n         specially considered by the Classification Society.\\n\\n         (ix) Ship structures that are not directly subjected to ice loads may still experience inertial\\n         loads of stowed cargo and equipment resulting from ship/ice interaction. These inertial loads,\\n         based on accelerations determined by the Classification Society, are to be considered in the\\n         design of these structures.\\n\\n\", \"origin\": {\"file\": \"data/requirements/IACS_I2_full.txt\", \"edition\": \"Rev.4 (December 2019)\", \"authority\": \"IACS\", \"selection\": {\"start\": 4741, \"end\": 7327, \"line_start\": 100, \"line_end\": 142, \"page_start\": 3, \"page_end\": 3}}}, {\"evidence_id\": \"E360\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#namingRule> \\\"N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E361\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"http://www.w3.org/2001/XMLSchema#decimal\\\", \\\"declaration_evidence\\\": {\\\"numericValue\\\": {\\\"@id\\\": \\\"qudt:numericValue\\\", \\\"@type\\\": \\\"xsd:decimal\\\"}, \\\"unit\\\": {\\\"@id\\\": \\\"qudt:unit\\\", \\\"@type\\\": \\\"@id\\\"}}, \\\"iri\\\": \\\"http://qudt.org/schema/qudt/numericValue\\\", \\\"kind\\\": \\\"DatatypeProperty\\\", \\\"localName\\\": \\\"numericValue\\\", \\\"mapping_basis\\\": \\\"Declared JSON-LD schema/locked_representation_context.jsonld\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E362\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#markingPlainlyVisibleInIceConditions> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R9 development): Marking plainly visible in ice conditions represents the linked requirement entity, relationship, value, evidence role, or quantity; its scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E363\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weld> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R7): an individual weld whose scope and controlled weld type can be verified.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E364\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#module> <https://w3id.org/nltl/vocab#moduleCore> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E365\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#navigatingInIce> <http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#boolean> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E366\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E367\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-0546\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E368\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#ship> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E369\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#otherIceStrengthenedAreaValue\\\", \\\"kind\\\": \\\"NamedIndividual\\\", \\\"label\\\": \\\"Other ice strengthened area value\\\", \\\"localName\\\": \\\"otherIceStrengthenedAreaValue\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#hullRegionValue\\\", \\\"sourceRefs\\\": \\\"I2-009 | IACS_UR_I2 p.3 | I2.3.1\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E370\", \"kind\": \"SOURCE\", \"text\": \"         I2.13.1 Application\\n\\n         I2.13.1.1 A ramming impact on the bow is the design scenario for the evaluation of the\\n         longitudinal strength of the hull.\\n\\n\\n\\n\\n                                                       I2-17                       IACS Req. 2006/Rev.4 2019\\n\\f                                                                                                            I2\\n\\n\\n         I2.13.1.2 Intentional ramming is not considered as a design scenario for ships which are\\nI2       designed with vertical or bulbous bows, see I1.1.6. Hence the longitudinal strength\\n(cont)   requirements given in I2.13 is not to be considered for ships with stem angle stem equal to or\\n         larger than 80 deg.\\n\\n         I2.13.1.3 Ice loads are only to be combined with still water loads. The combined stresses\\n         are to be compared against permissible bending and shear stresses at different locations\\n         along the ship’s length. In addition, sufficient local buckling strength is also to be verified.\\n\\n\", \"origin\": {\"file\": \"data/requirements/IACS_I2_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 50224, \"end\": 51251}}}, {\"evidence_id\": \"E371\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceTypeValue> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Ice type value\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E372\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"iri\\\": \\\"https://w3id.org/nltl/vocab#benchmarkEntity\\\", \\\"kind\\\": \\\"Class\\\", \\\"label\\\": \\\"Benchmark entity\\\", \\\"localName\\\": \\\"benchmarkEntity\\\", \\\"mapping_basis\\\": \\\"Ontology declaration (registry row not required)\\\", \\\"types\\\": [\\\"http://www.w3.org/2002/07/owl#Class\\\"]}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E373\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"iri\\\": \\\"https://w3id.org/nltl/vocab#ship\\\", \\\"kind\\\": \\\"Class\\\", \\\"label\\\": \\\"Ship\\\", \\\"localName\\\": \\\"ship\\\", \\\"mapping_basis\\\": \\\"Ontology declaration (registry row not required)\\\", \\\"types\\\": [\\\"http://www.w3.org/2002/07/owl#Class\\\"]}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E374\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipOperatesInIceCoveredWaters> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#DatatypeProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E375\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceTypeClassification> <http://www.w3.org/2000/01/rdf-schema#range> <https://w3id.org/nltl/vocab#iceTypeValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E376\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#navigatingInIce> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-015\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E377\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weldType> <https://w3id.org/nltl/vocab#module> <https://w3id.org/nltl/vocab#moduleHull> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E378\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hullRegionValue> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-043\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E379\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipOperatesInIceCoveredWaters> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#benchmarkEntity> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E380\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#evidenceExcerpt> \\\"This chapter applies to: fishing vessels of 24 metres in length overall and above; pleasure yachts of 300 gross tonnage and upwards not engaged in trade; and cargo ships of 300 gross tonnage and upwards but below 500 gross tonnage.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E381\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"xsd:boolean\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#markingPlainlyVisibleInIceConditions\\\", \\\"kind\\\": \\\"DatatypeProperty\\\", \\\"label\\\": \\\"Marking plainly visible in ice conditions\\\", \\\"localName\\\": \\\"markingPlainlyVisibleInIceConditions\\\", \\\"parentOrRange\\\": \\\"http://www.w3.org/2001/XMLSchema#boolean\\\", \\\"sourceRefs\\\": \\\"TRF-133 | TRAFICOM p.65 | 8\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E382\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weld> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E383\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"xsd:string\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#iceType\\\", \\\"kind\\\": \\\"DatatypeProperty\\\", \\\"label\\\": \\\"Ice type\\\", \\\"localName\\\": \\\"iceType\\\", \\\"parentOrRange\\\": \\\"http://www.w3.org/2001/XMLSchema#string\\\", \\\"sourceRefs\\\": \\\"IMO-004 | IMO_POLAR_CODE p.9 | 2.4; IMO-006 | IMO_POLAR_CODE p.9 | 2.8; IMO-008 | IMO_POLAR_CODE p.10 | 2.15\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E384\", \"kind\": \"SOURCE\", \"text\": \"         part of a grillage system.\\n\\n\", \"origin\": {\"file\": \"data/requirements/IACS_I2_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 59668, \"end\": 59705}}}, {\"evidence_id\": \"E385\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#module> <https://w3id.org/nltl/vocab#moduleCore> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E386\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weldType> <https://w3id.org/nltl/vocab#evidenceExcerpt> \\\"The frames shall be attached to the shell by a double continuous weld. No scalloping is allowed (except when crossing shell plate butts).\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E387\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Stage 1): candidate concept for pleasureYacht derived from the linked locked requirements; scope and final semantics require vocabulary approval.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E388\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceType> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-004\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E389\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#namingRule> \\\"N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E390\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designOperationSpeedInIce> <https://w3id.org/nltl/vocab#namingRule> \\\"N3 - remove unit from the identifier and retain it in unit/quantity metadata\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E391\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#weldTypeValue> <https://w3id.org/nltl/vocab#namingBasis> \\\"Applicable TRAFICOM regulation wording plus explicit engineering node/operand role\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E392\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#firstYearIce> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R9 development): First year ice represents the linked requirement entity, relationship, value, evidence role, or quantity; its scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E393\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#operatingIceType> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E394\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipIceStrengthened> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#benchmarkEntity> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E395\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#sidescuttleInIceBelt> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-040\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E396\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceStrengthenedArea> <https://w3id.org/nltl/vocab#evidenceExcerpt> \\\"The strength of a framing member is dependent upon the fixity that is provided at its supports. Fixity can be assumed where framing members are either continuous through the support or attached to a supporting section with a connection bracket. In other cases, simple support is to be assumed unless the connection can be demonstrated to provide significant ro...\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E397\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hasWeld> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#ObjectProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E398\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <https://w3id.org/nltl/vocab#sourceReference> \\\"IMO-109 | IMO_POLAR_CODE p.41 | 1.2.2; IMO-110 | IMO_POLAR_CODE p.41 | 1.2.3\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E399\", \"kind\": \"SOURCE\", \"text\": \"         I2.15.2 Load definition and response criteria are to be determined by the Classification\\n         Society.\\n\\n\", \"origin\": {\"file\": \"data/requirements/IACS_I2_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 58775, \"end\": 58892}}}, {\"evidence_id\": \"E400\", \"kind\": \"CONTEXT_STATUS\", \"text\": \"[\\\"iceStrengthenedArea\\\"]\", \"origin\": {\"context_field\": \"unresolvedOwnership\"}}, {\"evidence_id\": \"E401\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Explicit engineering entity/artifact class set\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E402\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#supportsIceStrengthenedFrames> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-DEV-B01-223\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E403\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/v