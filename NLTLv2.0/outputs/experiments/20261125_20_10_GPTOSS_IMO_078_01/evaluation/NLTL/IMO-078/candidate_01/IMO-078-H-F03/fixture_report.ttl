@prefix ex: <https://example.org/shapes#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F03/passenger1> ;
            sh:resultMessage "Each passenger must have completed instruction in personal survival equipment (value true)." ;
            sh:resultPath nltl:personalSurvivalEquipmentInstructionCompleted ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:na3c50539673b474cbb9660b414d5eff8b3 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F03/passenger1> ;
                    sh:resultMessage "Each passenger must have completed instruction in personal survival equipment (value true)." ;
                    sh:resultPath nltl:personalSurvivalEquipmentInstructionCompleted ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:na3c50539673b474cbb9660b414d5eff8b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape ex:PassengerInstructionShape. See details for more information." ;
            sh:resultPath nltl:hasPassenger ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node ex:PassengerInstructionShape ;
                    sh:path nltl:hasPassenger ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F03/passenger1> ] .

_:na3c50539673b474cbb9660b414d5eff8b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "Each passenger must have completed instruction in personal survival equipment (value true)." ;
    sh:path nltl:personalSurvivalEquipmentInstructionCompleted .

