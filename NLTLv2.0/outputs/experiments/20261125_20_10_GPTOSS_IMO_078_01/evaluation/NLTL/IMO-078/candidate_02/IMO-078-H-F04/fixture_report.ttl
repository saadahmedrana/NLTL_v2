@prefix ex: <https://example.org/shapes#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F04/crew1> ;
                    sh:resultMessage "Each crew member must have completed training for personal and group survival equipment (value true)." ;
                    sh:resultPath nltl:personalAndGroupSurvivalEquipmentTrainingCompleted ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:message "Each crew member must have completed training for personal and group survival equipment (value true)." ;
                            sh:path nltl:personalAndGroupSurvivalEquipmentTrainingCompleted ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape ex:CrewTrainingShape. See details for more information." ;
            sh:resultPath nltl:hasCrewMemberInventory ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node ex:CrewTrainingShape ;
                    sh:path nltl:hasCrewMemberInventory ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-F04/crew1> ] .

