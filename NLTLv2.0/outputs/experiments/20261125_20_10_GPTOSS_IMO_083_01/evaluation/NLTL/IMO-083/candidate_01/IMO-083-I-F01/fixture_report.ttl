@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F01/ship> ;
            sh:resultMessage "Required navigation/communication antenna https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F01/antenna1 lacks ice‑accumulation‑prevention means while ice accretion is likely on the ship.",
                "When ice accretion is likely, every required navigation or communication antenna must be equipped with means to prevent ice accumulation." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Required navigation/communication antenna {$antenna} lacks ice‑accumulation‑prevention means while ice accretion is likely on the ship." ;
                    sh:select """
            SELECT ?this ?antenna
            WHERE {
                ?this a <https://w3id.org/nltl/vocab#ship> ;
                      <https://w3id.org/nltl/vocab#iceAccretionLikely> true ;
                      <https://w3id.org/nltl/vocab#hasRequiredNavigationOrCommunicationAntenna> ?antenna .
                FILTER NOT EXISTS {
                    ?antenna <https://w3id.org/nltl/vocab#antennaIceAccumulationPreventionPresent> true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <https://w3id.org/nltl/shapes/ShipIceAccretionPreventionShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F01/ship> ] .

