@prefix : <https://w3id.org/nltl/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:maxExclusive Literal(\"2021-07-05\", datatype=xsd:date) ; sh:message Literal(\"Construction contract date is before the 2021 applicability threshold; edition constraint does not apply.\") ; sh:path nltl:constructionContractDate ] ] , [ sh:property [ sh:datatype xsd:date ; sh:message Literal(\"Construction contract date is on or after 5 July 2021; the 2021 Ice‑Class regulation edition must be applied.\") ; sh:minInclusive Literal(\"2021-07-05\", datatype=xsd:date) ; sh:path nltl:constructionContractDate ], [ sh:in ( nltl:iceClassRegulationEdition2021 ) ; sh:message Literal(\"For ships contracted on/after 5 July 2021 the applicable Ice‑Class regulation edition must be the 2021 edition.\") ; sh:nodeKind sh:IRI ; sh:path nltl:applicableIceClassRegulationEdition ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape :IceClassEditionApplicabilityShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ] .

