@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix vocab: <https://w3id.org/nltl/vocab#> .

# Shape for ships where the 2010 ice‑class edition applies only when the construction contract date
# falls between 2012‑01‑01 (inclusive) and 2019‑01‑01 (exclusive).  If the date is outside this interval,
# no restriction on the applicableIceClassRegulationEdition is imposed.
vocab:ShipIceClass2010Shape
    a sh:NodeShape ;
    sh:targetClass vocab:ship ;
    sh:or (
        # ---- CASE 1: Date within the 2010‑edition interval → edition must be 2010
        [
            sh:property [
                sh:path vocab:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2012-01-01"^^xsd:date ;
                sh:maxExclusive "2019-01-01"^^xsd:date ;
                sh:message "Construction contract date must be between 2012‑01‑01 (inclusive) and 2019‑01‑01 (exclusive) for applicability of the 2010 Ice Class Regulations." ;
            ] ;
            sh:property [
                sh:path vocab:applicableIceClassRegulationEdition ;
                sh:hasValue vocab:iceClassRegulationEdition2010 ;
                sh:message "Ships built under the 2010 Ice Class Regulations must have applicableIceClassRegulationEdition set to iceClassRegulationEdition2010." ;
            ]
        ]
        # ---- CASE 2: Date NOT within the interval → no edition constraint
        [
            sh:not [
                sh:property [
                    sh:path vocab:constructionContractDate ;
                    sh:datatype xsd:date ;
                    sh:minInclusive "2012-01-01"^^xsd:date ;
                    sh:maxExclusive "2019-01-01"^^xsd:date ;
                ]
            ]
        ]
    ) .
