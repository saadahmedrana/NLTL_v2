@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vocab: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-003-F01/ship> ;
            sh:resultMessage "Ships built under the 2010 Ice Class Regulations must have applicableIceClassRegulationEdition set to iceClassRegulationEdition2010." ;
            sh:resultPath vocab:applicableIceClassRegulationEdition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue vocab:iceClassRegulationEdition2010 ;
                    sh:message "Ships built under the 2010 Ice Class Regulations must have applicableIceClassRegulationEdition set to iceClassRegulationEdition2010." ;
                    sh:path vocab:applicableIceClassRegulationEdition ] ] .

