@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vocab: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-003-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:maxExclusive Literal(\"2019-01-01\", datatype=xsd:date) ; sh:message Literal(\"Construction contract date must be between 2012‑01‑01 (inclusive) and 2019‑01‑01 (exclusive) for applicability of the 2010 Ice Class Regulations.\") ; sh:minInclusive Literal(\"2012-01-01\", datatype=xsd:date) ; sh:path vocab:constructionContractDate ], [ sh:hasValue vocab:iceClassRegulationEdition2010 ; sh:message Literal(\"Ships built under the 2010 Ice Class Regulations must have applicableIceClassRegulationEdition set to iceClassRegulationEdition2010.\") ; sh:path vocab:applicableIceClassRegulationEdition ] ] , [ sh:not [ sh:property [ sh:datatype xsd:date ; sh:maxExclusive Literal(\"2019-01-01\", datatype=xsd:date) ; sh:minInclusive Literal(\"2012-01-01\", datatype=xsd:date) ; sh:path vocab:constructionContractDate ] ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape vocab:ShipIceClass2010Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-003-F01/ship> ] .

