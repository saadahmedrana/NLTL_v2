@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

# Shape that enforces the allowed ice‑class values defined in
# TRF‑010 clause 1.8 (Ice classes) of the Ice Class Regulations
# (2021 edition, file data/requirements/TRAFICOM_full.txt, SHA‑256 e0bf…e8ba).

nltl:ShipIceClassShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    rdfs:comment """
    Requirement TRF‑010, clause 1.8:
    “Under section 3 of the Act on the Ice Classes of Ships and Icebreaker Assistance (1121/2005),
    ships are assigned to ice classes as follows:
      1. ice class IA Super …
      2. ice class IA …
      3. ice class IB …
      4. ice class IC …
      5. ice class II …
      6. ice class III …”
    The shape requires every instance of nltl:ship to have an iceClass property whose
    value is one of the six enumerated ice‑class concepts.
    """ ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "Ship must be assigned one of the ice‑class values defined in TRF‑010 clause 1.8 (IA Super, IA, IB, IC, II, III)." ;
        sh:severity sh:Violation ;
    ] .

# Enumeration individuals (exact IRIs as declared in the ontology)

nltl:iceClassIaSuper a rdf:Resource, nltl:iceClassValue ;
    rdfs:label "IA Super"@en .

nltl:iceClassIa a rdf:Resource, nltl:iceClassValue ;
    rdfs:label "IA"@en .

nltl:iceClassIb a rdf:Resource, nltl:iceClassValue ;
    rdfs:label "IB"@en .

nltl:iceClassIc a rdf:Resource, nltl:iceClassValue ;
    rdfs:label "IC"@en .

nltl:iceClassIi a rdf:Resource, nltl:iceClassValue ;
    rdfs:label "II"@en .

nltl:iceClassIii a rdf:Resource, nltl:iceClassValue ;
    rdfs:label "III"@en .
