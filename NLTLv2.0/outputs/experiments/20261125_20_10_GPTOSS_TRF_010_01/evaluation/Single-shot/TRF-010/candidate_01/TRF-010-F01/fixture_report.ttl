@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-010-F01/ship> ;
            sh:resultMessage "Ship must be assigned one of the ice‑class values defined in TRF‑010 clause 1.8 (IA Super, IA, IB, IC, II, III)." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ;
                    sh:message "Ship must be assigned one of the ice‑class values defined in TRF‑010 clause 1.8 (IA Super, IA, IB, IC, II, III)." ;
                    sh:path nltl:iceClass ;
                    sh:severity sh:Violation ] ;
            sh:value nltl:polarClassPc6 ] .

