WatersIceCondition> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Other waters ice condition\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E149\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipSizeEngineOutputFactorCd> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Batch 01 development): Ship size engine output factor cd is the benchmark representation of the linked requirement operand, relationship, evidence role, or controlled value. Exact scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E150\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <http://www.w3.org/2004/02/skos/core#altLabel> \\\"passenger_ship\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E151\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"xsd:boolean\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#ownerRequested2008EngineOutputRequirements\\\", \\\"kind\\\": \\\"DatatypeProperty\\\", \\\"label\\\": \\\"Owner requested 2008 engine output requirements\\\", \\\"localName\\\": \\\"ownerRequested2008EngineOutputRequirements\\\", \\\"parentOrRange\\\": \\\"http://www.w3.org/2001/XMLSchema#boolean\\\", \\\"sourceRefs\\\": \\\"TRF-006 | TRAFICOM p.8 | 2.1\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E152\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipSizeEngineOutputCoefficientA> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-DEV-B01-208\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E153\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"declaration_evidence\\\": {\\\"numericValue\\\": {\\\"@id\\\": \\\"qudt:numericValue\\\", \\\"@type\\\": \\\"xsd:decimal\\\"}, \\\"unit\\\": {\\\"@id\\\": \\\"qudt:unit\\\", \\\"@type\\\": \\\"@id\\\"}}, \\\"iri\\\": \\\"http://qudt.org/schema/qudt/unit\\\", \\\"kind\\\": \\\"ObjectProperty\\\", \\\"localName\\\": \\\"unit\\\", \\\"mapping_basis\\\": \\\"Declared JSON-LD schema/locked_representation_context.jsonld\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E154\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipSizeEngineOutputCoefficientB> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Development unit selected and fixture conversion required\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E155\", \"kind\": \"SOURCE\", \"text\": \"Table 6-21: Parameters for calculating maximum loads when the thruster penetrates an ice\\n              ridge. Aft thrusters. Bow first operation ...................................................... 60\\nTable 6-22: Parameters for calculating maximum loads when the thruster penetrates an ice\\n              ridge. Thruster first mode such as double acting ships. ................................. 60\\n\", \"origin\": {\"file\": \"data/requirements/TRAFICOM_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 13072, \"end\": 13471}}}, {\"evidence_id\": \"E156\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO26-002\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E157\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#evidenceExcerpt> \\\"This chapter applies to: fishing vessels of 24 metres in length overall and above; pleasure yachts of 300 gross tonnage and upwards not engaged in trade; and cargo ships of 300 gross tonnage and upwards but below 500 gross tonnage.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E158\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-0528\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E159\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO26-016\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E160\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#propulsionMachineryContinuousOutput> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#ObjectProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E161\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#stage1LocalName> \\\"fishingVessel\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E162\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#stage1LocalName> \\\"pleasureYacht\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E163\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#navigatingInIce> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#benchmarkEntity> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E164\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3