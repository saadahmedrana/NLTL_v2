ment_id\\\": \\\"TRF-015\\\", \\\"scope\\\": \\\"OTHER_REQUIREMENT_NOT_TRANSFERABLE\\\", \\\"target_owner\\\": \\\"ship\\\"}, {\\\"model_paths\\\": [], \\\"owners\\\": {\\\"navigatingInIce\\\": \\\"ship\\\"}, \\\"requirement_id\\\": \\\"TRF-016\\\", \\\"scope\\\": \\\"OTHER_REQUIREMENT_NOT_TRANSFERABLE\\\", \\\"target_owner\\\": \\\"ship\\\"}, {\\\"model_paths\\\": [], \\\"owners\\\": {\\\"propulsionMachineryContinuousOutput\\\": \\\"ship\\\"}, \\\"requirement_id\\\": \\\"TRF-017\\\", \\\"scope\\\": \\\"OTHER_REQUIREMENT_NOT_TRANSFERABLE\\\", \\\"target_owner\\\": \\\"ship\\\"}, {\\\"model_paths\\\": [], \\\"owners\\\": {\\\"engineOutputCoefficientKe\\\": \\\"ship\\\", \\\"hydraulicPropulsionMachinery\\\": \\\"ship\\\"}, \\\"requirement_id\\\": \\\"TRF-020\\\", \\\"scope\\\": \\\"OTHER_REQUIREMENT_NOT_TRANSFERABLE\\\", \\\"target_owner\\\": \\\"ship\\\"}, {\\\"model_paths\\\": [], \\\"owners\\\": {\\\"engineOutputComplianceMethod\\\": \\\"ship\\\"}, \\\"requirement_id\\\": \\\"TRF-024\\\", \\\"scope\\\": \\\"OTHER_REQUIREMENT_NOT_TRANSFERABLE\\\", \\\"target_owner\\\": \\\"ship\\\"}, {\\\"model_paths\\\": [], \\\"owners\\\": {\\\"engineOutputCoefficientKe\\\": \\\"ship\\\"}, \\\"requirement_id\\\": \\\"TRF-028\\\", \\\"scope\\\": \\\"OTHER_REQUIREMENT_NOT_TRANSFERABLE\\\", \\\"target_owner\\\": \\\"ship\\\"}, {\\\"model_paths\\\": [], \\\"owners\\\": {\\\"shipSizeEngineOutputCoefficientA\\\": \\\"ship\\\", \\\"shipSizeEngineOutputCoefficientB\\\": \\\"ship\\\", \\\"shipSizeEngineOutputCoefficientK\\\": \\\"ship\\\", \\\"shipSizeEngineOutputFactorCd\\\": \\\"ship\\\"}, \\\"requirement_id\\\": \\\"TRF-037\\\", \\\"scope\\\": \\\"OTHER_REQUIREMENT_NOT_TRANSFERABLE\\\", \\\"target_owner\\\": \\\"ship\\\"}, {\\\"model_paths\\\": [], \\\"owners\\\": {\\\"propulsionSystemDesignedForIceClass\\\": \\\"ship\\\"}, \\\"requirement_id\\\": \\\"TRF-074\\\", \\\"scope\\\": \\\"OTHER_REQUIREMENT_NOT_TRANSFERABLE\\\", \\\"target_owner\\\": null}], \\\"status\\\": \\\"RETRIEVED\\\", \\\"term_iris\\\": [\\\"https://w3id.org/nltl/vocab#propulsionMachineryContinuousOutput\\\", \\\"https://w3id.org/nltl/vocab#shipSizeEngineOutputFactorCd\\\", \\\"https://w3id.org/nltl/vocab#shipSizeEngineOutputCoefficientK\\\", \\\"https://w3id.org/nltl/vocab#shipSizeEngineOutputCoefficientB\\\", \\\"https://w3id.org/nltl/vocab#shipSizeEngineOutputCoefficientA\\\", \\\"https://w3id.org/nltl/vocab#propulsionSystemDesignedForIceClass\\\", \\\"https://w3id.org/nltl/vocab#ownerRequested2008EngineOutputRequirements\\\", \\\"https://w3id.org/nltl/vocab#otherWatersIceCondition\\\", \\\"https://w3id.org/nltl/vocab#openWaterIceCondition\\\", \\\"https://w3id.org/nltl/vocab#navigatingInIce\\\", \\\"https://w3id.org/nltl/vocab#markingPlainlyVisibleInIceConditions\\\", \\\"https://w3id.org/nltl/vocab#hydraulicPropulsionMachinery\\\", \\\"https://w3id.org/nltl/vocab#engineOutputRegulationEdition\\\", \\\"https://w3id.org/nltl/vocab#engineOutputFormulaFactorF4\\\", \\\"https://w3id.org/nltl/vocab#engineOutputFormulaFactorF3\\\", \\\"https://w3id.org/nltl/vocab#engineOutputFormulaFactorF2\\\", \\\"https://w3id.org/nltl/vocab#engineOutputFormulaFactorF1\\\", \\\"https://w3id.org/nltl/vocab#engineOutputFormulaDisplacement\\\", \\\"https://w3id.org/nltl/vocab#engineOutputFormulaBasePowerP0\\\", \\\"https://w3id.org/nltl/vocab#engineOutputComplianceMethodValue\\\", \\\"https://w3id.org/nltl/vocab#engineOutputComplianceMethod\\\", \\\"https://w3id.org/nltl/vocab#engineOutputCoefficientKe\\\", \\\"https://w3id.org/nltl/vocab#hullStructure\\\", \\\"https://w3id.org/nltl/vocab#iceClassRegulationEdition2002\\\"]}]\", \"origin\": {\"context_field\": \"retrieved_schema_evidence\"}}, {\"evidence_id\": \"E247\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#hydraulicPropulsionMachinery\\\", \\\"kind\\\": \\\"NamedIndividual\\\", \\\"label\\\": \\\"Hydraulic propulsion machinery\\\", \\\"localName\\\": \\\"hydraulicPropulsionMachinery\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#propulsionSystemTypeValue\\\", \\\"sourceRefs\\\": \\\"TRF-020 | TRAFICOM p.8-9 | 3.2.2\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E248\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hydraulicPropulsionMachinery> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://w3id.org/nltl/vocab#propulsionSystemTypeValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E249\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hullStructure> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E250\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputComplianceMethod> <https://w3id.org/nltl/vocab#namingRule> \\\"N5 - ASCII lowerCamelCase relationship; use has + object role when it improves direction clarity.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E251\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#engineOutputCoefficientKe\\\", \\\"kind\\\": \\\"QuantityProperty\\\", \\\"label\\\": \\\"Engine-output coefficient Ke\\\", \\\"localName\\\": \\\"engineOutputCoefficientKe\\\", \\\"parentOrRange\\\": \\\"http://qudt.org/schema/qudt/QuantityValue\\\", \\\"sourceRefs\\\": \\\"TRF-020 | TRAFICOM p.8-9 | 3.2.2; TRF-028 | TRAFICOM p.11 | 3.2.5\\\", \\\"unitIri\\\": \\\"http://qudt.org/vocab/unit/UNITLESS\\\", \\\"unitSymbol\\\": \\\"1\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E252\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputCoefficientKe> <https://w3id.org/nltl/vocab#evidenceExcerpt> \\\"To qualify for ice class IA Super, IA, IB or IC, a ship the keel of which is laid or which is at a similar stage of construction on or after 1 September 2003 shall comply with the following requirements regarding its engine output. The engine output requirement shall be calculated for two draughts by formula 3.1. Draughts to be used are the maximum draught a...\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E253\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <http://www.w3.org/2004/02/skos/core#altLabel> \\\"fishing_vessel\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E254\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipSizeEngineOutputCoefficientK> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#ObjectProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E255\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputFormulaFactorF3> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R9 development): Engine output formula factor f3 represents the linked requirement entity, relationship, value, evidence role, or quantity; its scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E256\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceClassIii> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"III\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E257\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#navigatingInIce> <https://w3id.org/nltl/vocab#namingBasis> \\\"Applicable TRAFICOM regulation wording plus explicit engineering node/operand role\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E258\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E259\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#cargoShip\\\", \\\"kind\\\": \\\"Class\\\", \\\"label\\\": \\\"Cargo ship\\\", \\\"localName\\\": \\\"cargoShip\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#ship\\\", \\\"sourceRefs\\\": \\\"IMO26-002 | IMO_AMEND_2026 p.2 | Chapter 9-1 applicability; IMO26-016 | IMO_AMEND_2026 p.5 | Chapter 11-1 applicability\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E260\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputFormulaFactorF4> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R9 development): Engine output formula factor f4 represents the linked requirement entity, relationship, value, evidence role, or quantity; its scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E261\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"iri\\\": \\\"https://w3id.org/nltl/vocab#iceClassIb\\\", \\\"kind\\\": \\\"NamedIndividual\\\", \\\"label\\\": \\\"IB\\\", \\\"localName\\\": \\\"iceClassIb\\\", \\\"mapping_basis\\\": \\\"Ontology declaration (registry row not required)\\\", \\\"types\\\": [\\\"http://www.w3.org/2004/02/skos/core#Concept\\\", \\\"https://w3id.org/nltl/vocab#iceClassValue\\\"]}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E262\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipSizeEngineOutputCoefficientB> <https://w3id.org/nltl/vocab#namingBasis> \\\"Applicable TRAFICOM regulation wording plus explicit engineering node/operand role\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E263\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#propulsionSystemDesignedForIceClass\\\", \\\"kind\\\": \\\"ObjectProperty\\\", \\\"label\\\": \\\"Propulsion system designed for ice class\\\", \\\"localName\\\": \\\"propulsionSystemDesignedForIceClass\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#iceClassValue\\\", \\\"sourceRefs\\\": \\\"TRF-074 | TRAFICOM p.32 | 6.5\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E264\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceClass> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-067\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E265\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#ownerRequested2008EngineOutputRequirements> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Owner requested 2008 engine output requirements\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E266\", \"kind\": \"SOURCE\", \"text\": \"1     GENERAL\\n\\n1.1     Application of the 2021 Ice Class Regulations\\n\\nThe Ice Class Regulations of 2021 apply to ships contracted for construction on or after 5 July\\n2021.\\nThe provisions in section 1.8 (Ice classes) and chapter 2 (Ice Class Draught) in the 2021 Ice\\nClass Regulations apply to all ships irrespective of their year of build.\\n\\n1.2     Application of the 2017 Ice Class Regulations\\n\\nThe Ice Class Regulations of 2017 apply to ships contracted for construction on or after 1 Janu-\\nary 2019 but before 5 July 2021.\\n\\nAs from 1 December 2017, the Ice Class Regulations of 2017 may, however, also be applied to\\nships contracted for construction on or after 1 December 2017 but before 5 July 2021.\\n\\n\\n1.3     Application of the 2010 Ice Class Regulations\\n\\nThe Ice Class Regulations of 2010 (TRAFI/31298/03.04.01.00/2010) apply to ships contracted\\nfor construction on or after 1 January 2012 but before 1 January 2019.\\n\\n1.4     Application of the 2008 Ice Class Regulations\\n\\nThe Ice Class Regulations of 2008 (8.12.2008 No. 2530/30/2008), issued by the Finnish Mari-\\ntime Administration, apply to ships contracted for construction on or after 1 January 2010 but\\nbefore 1 January 2012.\\n\\n1.5     Application of the 2002 Ice Class Regulations\\n\\nThe Ice Class Regulations of 2002 (20.9.2002 No. 5/30/2002), issued by the Finnish Maritime\\nAdministration, as amended, apply to ships the keels of which have been laid or which have\\nbeen at a similar stage of construction on or after 1 September 2003 but which have been con-\\ntracted for construction before 1 January 2010.\\n\\n1.6     Application of the 1985 Ice Class Rules\\n\\nThe Board of Navigation Rules for Assigning Ships Separate Ice-Due Classes, 1985, (2.9.1985\\nNo. 2575/85/307), as amended, apply to ships the keels of which have been laid or which\\nhave been at a similar stage of construction on or after 1 November 1986 but before 1 Sep-\\ntember 2003. On the owner’s request, the requirements of the 2008 Ice Class Regulations\\nmay, however, be applied to the engine output of such ships.\\n\\nHowever, ships of ice class IA Super or IA the keels of which have been laid or which have\\nbeen at a similar stage of construction before 1 September 2003 shall comply with the require-\\nments in section 3.2.2 or 3.2.4 of the Ice Class Regulations of 2017 not later than 1 January in\\nthe year when twenty years have elapsed since the year the ship was delivered.\\n\\n1.7     Application of the 1971 Ice Class Rules\\n\\nThe requirements of Annex I or, depending on the ship’s age, section 10 of the Board of Navi-\\ngation Rules for Assigning Ships Separate Ice-Due Classes of 1971 (6.4.1971 No.\\n\\f                                                                                         Regulation\\n                                                                                                  6 (65)\\n                                                                TRAFICOM/68863/03.04.01.00/2021\\n\\n\\n\\n\\n1260/71/307), as amended, apply to ships the keels of which have been laid or which have\\nbeen at a similar stage of construction before 1 November 1986. On the owner’s request, the\\nrequirements of the 1985 Ice Class Rules or the 2008 Ice Class Regulations may, however, be\\napplied to the engine output of such ships.\\n\\nHowever, ships of ice class IA Super or IA the keels of which have been laid or which have\\nbeen at a similar stage of construction before 1 September 2003 shall comply with the require-\\nments in section 3.2.2 or 3.2.4 of the Ice Class Regulations of 2017 not later than 1 January in\\nthe year when twenty years have elapsed since the year the ship was delivered.\\n\\n1.8       Ice classes\\n\\nUnder section 3 of the Act on the Ice Classes of Ships and Icebreaker Assistance (1121/2005),\\nships are assigned to ice classes as follows:\\n\\n      1. ice class IA Super; ships with such a structure, engine output and other properties that\\n         they are normally capable of navigating in difficult ice conditions without the assistance\\n         of icebreakers;\\n      2. ice class IA; ships with such a structure, engine output and other properties that they\\n         are capable of navigating in difficult ice conditions, with the assistance of icebreakers\\n         when necessary;\\n      3. ice class IB; ships with such a structure, engine output and other properties that they\\n         are capable of navigating in moderate ice conditions, with the assistance of icebreakers\\n         when necessary;\\n      4. ice class IC; ships with such a structure, engine output and other properties that they\\n         are capable of navigating in light ice conditions, with the assistance of icebreakers when\\n         necessary;\\n      5. ice class II; ships that have a steel hull and that are structurally fit for navigation in the\\n         open sea and that, despite not being strengthened for navigation in ice, are capable of\\n         navigating in very light ice conditions using their own propulsion machinery;\\n      6. ice class III; ships that do not belong to the ice classes referred to in paragraphs 1-5.\\n\\n\\n\\n2       ICE CLASS DRAUGHT\\n\\n\", \"origin\": {\"file\": \"data/requirements/TRAFICOM_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 17575, \"end\": 22652}}}, {\"evidence_id\": \"E267\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputFormulaFactorF1> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Engine output formula factor f1\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E268\", \"kind\": \"SOURCE\", \"text\": \"3.2.1     Definitions\\n\\nThe dimensions of the ship and some other parameters are defined as follows:\\n\\n L        m           the length of the ship between the perpendiculars\\n LBOW     m           the length of the bow\\n LPAR     m           the length of the parallel midship body\\n B        m           the maximum breadth of the ship\\n T        m           the actual ice class draughts of the ship according to 3.2.2\\n Awf      m2          the area of the waterline of the bow\\n α        degree      the angle of the waterline at B/4\\n ϕ1       degree      the rake of the stem at the centerline\\n ϕ2       degree      the rake of the bow at B/4\\n ψ        degree      the flare angle calculated as ψ = tan−1 �\\n                                                                tan ϕ\\n                                                                      � using local angles α and φ at\\n                                                                sin α\\n                      each location. For chapter 3, the flare angle is calculated using φ = φ2\\n DP       m           the diameter of the propeller\\n HM       m           the thickness of the brash ice in mid channel\\n HF       m           the thickness of the brash ice layer displaced by the bow\\n\\n\\n\\n\\nFigure 3-1. Determination of the geometric quantities of the hull. If the ship has a bulbous\\nbow, then ϕ1 = 90°.\\n\\n3.2.2     New ships\\n\\nTo qualify for ice class IA Super, IA, IB or IC, a ship the keel of which is laid or which is at a\\nsimilar stage of construction on or after 1 September 2003 shall comply with the following re-\\nquirements regarding its engine output. The engine output requirement shall be calculated for\\n\\f                                                                                                                            Regulation\\n                                                                                                                                  9 (65)\\n                                                                                  TRAFICOM/68863/03.04.01.00/2021\\n\\n\\n\\n\\ntwo draughts by formula 3.1. Draughts to be used are the maximum draught amidships re-\\nferred to as UIWL and the minimum draught amidships referred to as LIWL, as defined in sec-\\ntion 2.2. In the calculations, the ship's parameters which depend on the draught must be de-\\ntermined at the appropriate draught, but L and B must be determined only at the UIWL. The\\nengine output shall be no less than the greater of these two outputs.\\n\\n\\n\\n                                                            (𝑅𝑅𝐶𝐶𝐶𝐶 /1000)3/2\\n                                          𝑃𝑃𝑚𝑚𝑚𝑚𝑚𝑚 = 𝐾𝐾𝑒𝑒                       [kW],                                           (3.1)\\n                                                                   𝐷𝐷𝑝𝑝\\n\\n\\n\\nwhere Ke shall be given a value according to Table 3-1.\\n\\n\\n                     Table 3-1: Values of Ke for conventional propulsion systems\\n                   Number of pro-     CP propeller or electric or hy- FP\\n                   pellers            draulic propulsion machinery     propeller\\n                   1 propeller        2.03                             2.26\\n                   2 propellers       1.44                             1.60\\n                   3 propellers       1.18                             1.31\\n\\nThese Ke values apply to conventional propulsion systems. Other methods may be used for de-\\ntermining the required power for advanced propulsion systems (see 3.2.5).\\n\\nRCH is the ice resistance in Newton of the ship in a channel with brash ice and a consolidated\\nsurface layer.\\n\\n                                                                                                        𝐿𝐿𝐿𝐿 3 𝐴𝐴𝑤𝑤𝑤𝑤\\n        𝑅𝑅𝐶𝐶𝐶𝐶 = 𝐶𝐶1 + 𝐶𝐶2 + 𝐶𝐶3 𝐶𝐶𝜇𝜇 (𝐻𝐻𝐹𝐹 + 𝐻𝐻𝑀𝑀 )2 �𝐵𝐵 + 𝐶𝐶𝜓𝜓 𝐻𝐻𝐹𝐹 � + 𝐶𝐶4 𝐿𝐿𝑃𝑃𝑃𝑃𝑃𝑃 𝐻𝐻𝐹𝐹2 + 𝐶𝐶5 �𝐵𝐵2 �               ,      (3.2)\\n                                                                                                                 𝐿𝐿\\n\\n\\n\\nwhere\\n     𝐶𝐶𝜇𝜇 = 0.15𝑐𝑐𝑐𝑐𝑐𝑐 ϕ2 + sin ψ sin α, Cµ has a value equal to or larger than 0.45\\n      𝐶𝐶𝜓𝜓 = 0.047𝜓𝜓 − 2.115 and 𝐶𝐶𝜓𝜓 = 0 if 𝜓𝜓 ≤ 45°\\n      𝐻𝐻𝐹𝐹 = 0.26 + (𝐻𝐻𝑀𝑀 𝐵𝐵)0.5\\n      𝐻𝐻𝑀𝑀 = 1.0 m for ice classes IA and IA Super\\n           = 0.8 m for ice class IB\\n           = 0.6 m for ice class IC\\n\\n      C1 and C2 take account of a consolidated upper layer of brash ice. C1=0 and C2=0 for ice\\n      classes IA, IB and IC.\\n\\n      For ice class IA Super:\\n\\n\\n                               𝐵𝐵𝐿𝐿𝑃𝑃𝑃𝑃𝑃𝑃\\n                             𝐶𝐶1 = 𝑓𝑓1    + (1 + 0.021𝜙𝜙1 )(𝑓𝑓2 𝐵𝐵 + 𝑓𝑓3 𝐿𝐿𝐵𝐵𝐵𝐵𝐵𝐵 + 𝑓𝑓4 𝐵𝐵𝐿𝐿𝐵𝐵𝐵𝐵𝐵𝐵 ),\\n                                 𝑇𝑇\\n                              2 +1\\n                                𝐵𝐵\\n                                                                                    𝑇𝑇 𝐵𝐵2\\n                          𝐶𝐶2 = (1 + 0.063𝜙𝜙1 )(𝑔𝑔1 + 𝑔𝑔2 𝐵𝐵) + 𝑔𝑔3 �1 + 1.2 � .\\n                                                                                   𝐵𝐵 √𝐿𝐿\\n      For a ship with a bulbous bow, ϕ1 = 90°.\\n\\f                                                                                                               Regulation\\n                                                                                                                    10 (65)\\n                                                                                      TRAFICOM/68863/03.04.01.00/2021\\n\\n\\n\\n\\n        Coefficients f1-f4 and g1-g3 are given in Table 3-2.\\n\\n         Table 3-2: Values of coefficients f1-f4 and g1-g3 for the determination of C1 and C2\\n                                 f1 = 23 N/m2       g1 = 1530 N\\n                                 f2 = 45.8 N/m g2 = 170 N/m\\n                                 f3 = 14.7 N/m g3 = 400 N/m1.5\\n                                 f4 = 29 N/m2\\n\\n        C3 = 845 kg/(m2s2)\\n        C4 = 42 kg/(m2s2)\\n        C5 = 825 kg/s2\\n                    tan 𝜙𝜙2\\n        𝜓𝜓 = tan−1 �        �\\n                     sin 𝛼𝛼\\n                                      𝐿𝐿𝐿𝐿 3\\n        If the value of the term� 2� is less than 5, the value 5 shall be used and if the value of\\n                                      𝐵𝐵\\n        the term is more than 20, the value 20 shall be used.\\n\\n\", \"origin\": {\"file\": \"data/requirements/TRAFICOM_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 26750, \"end\": 32889}}}, {\"evidence_id\": \"E269\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputComplianceMethod> <https://w3id.org/nltl/vocab#namingBasis> \\\"Applicable TRAFICOM regulation wording plus explicit engineering node/operand role\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E270\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceClass> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Verified regulation-defined controlled value set\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E271\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#engineOutputFormulaBasePowerP0\\\", \\\"kind\\\": \\\"QuantityProperty\\\", \\\"label\\\": \\\"Engine output formula base power p0\\\", \\\"localName\\\": \\\"engineOutputFormulaBasePowerP0\\\", \\\"parentOrRange\\\": \\\"http://qudt.org/schema/qudt/QuantityValue\\\", \\\"sourceRefs\\\": \\\"TRF-132 | TRAFICOM p.64 | 8\\\", \\\"unitIri\\\": \\\"http://qudt.org/vocab/unit/KiloW\\\", \\\"unitSymbol\\\": \\\"kW\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E272\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hydraulicPropulsionMachinery> <https://w3id.org/nltl/vocab#namingBasis> \\\"Applicable TRAFICOM regulation wording plus explicit engineering node/operand role\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E273\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputFormulaFactorF4> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#ObjectProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E274\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#propulsionSystemDesignedForIceClass> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-074\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E275\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#navigatingInIce> <https://w3id.org/nltl/vocab#namingRule> \\\"N4 - explicit regulatory concept in ASCII lowerCamelCase with an XSD datatype.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E276\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#evidenceExcerpt> \\\"This chapter applies to: fishing vessels of 24 metres in length overall and above; pleasure yachts of 300 gross tonnage and upwards not engaged in trade; and cargo ships of 300 gross tonnage and upwards but below 500 gross tonnage.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E277\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipSizeEngineOutputFactorCd> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Ship size engine output factor cd\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E278\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E279\", \"kind\": \"SOURCE\", \"text\": \"            Table 6-12: Coefficient values for frequency domain excitation calculation\\n                  Torque excitation Z=3\\n                                      Cq0        Cq1   α1   Cq2       α2     E0\\n                  Excitation case 1 0.375        0.36 -90 0           0      1\\n                  Excitation case 2 0.7          0.33 -90 0.05        -45 1\\n                  Excitation case 3 0.25         0.25 -90 0                  2\\n                  Excitation case 4 0.2          0.25 0     0.05      -90 1\\n\\n                     Torque excitation         Z=4\\n                                               Cq0          Cq1       α1      Cq2           α2      E0\\n                     Excitation case 1         0.45         0.36      -90     0.06          -90     1\\n                     Excitation case 2         0.9375       0         -90     0.0625        -90     1\\n                     Excitation case 3         0.25         0.25      -90     0             0       2\\n                     Excitation case 4         0.2          0.25      0       0.05          -90     1\\n\\n                     Torque excitation         Z=5\\n                                               Cq0          Cq1       α1      Cq2           α2      E0\\n                     Excitation case 1         0.45         0.36      -90     0.06          -90     1\\n                     Excitation case 2         1.19         0.17      -90     0.02          -90     1\\n                     Excitation case 3         0.3          0.25      -90     0.048         -90     2\\n                     Excitation case 4         0.2          0.25      0       0.05          -90     1\\n\\n                     Torque excitation         Z=6\\n                                               Cq0          Cq1       α1      Cq2           α2      E0\\n                     Excitation case 1         0.45         0.36      -90     0.05          -90     1\\n                     Excitation case 2         1.435        0.1       -90     0             0       1\\n                     Excitation case 3         0.3          0.25      -90     0.048         -90     2\\n                     Excitation case 4         0.2          0.25      0       0.05          -90     1\\n\\f                                                                                                              Regulation\\n                                                                                                                   45 (65)\\n                                                                                  TRAFICOM/68863/03.04.01.00/2021\\n\\n\\n\\n\\nThe design torque for the frequency domain excitation case must be obtained using the for-\\nmula:\\n\\n                  𝑄𝑄𝑝𝑝𝑝𝑝𝑝𝑝𝑝𝑝 = 𝑄𝑄𝑒𝑒𝑒𝑒𝑒𝑒𝑒𝑒 + 𝑄𝑄𝑣𝑣𝑣𝑣𝑣𝑣 + �𝑄𝑄 𝑛𝑛 𝑚𝑚𝑚𝑚𝑚𝑚 𝐶𝐶𝑞𝑞0 �𝐼𝐼𝑒𝑒 /𝐼𝐼𝑡𝑡 + 𝑄𝑄𝑟𝑟𝑟𝑟1 + 𝑄𝑄𝑟𝑟𝑟𝑟2,       (6.34)\\n\\n              where\\n                𝑛𝑛\\n              𝑄𝑄𝑚𝑚𝑚𝑚𝑚𝑚 is the maximum propeller ice torque at the operation speed in consideration\\n              Cq0 is the mean static torque coefficient from Table 6-12\\n              Qrf1 is the blade order torsional response from the frequency domain analysis\\n              Qrf2 is the second order blade torsional response from the frequency domain\\n              analysis\\n\\nIf the prime mover maximum torque, Qemax, is not known, it shall be taken as given in Table 6-\\n10. All the torque values have to be scaled to the shaft revolutions for the component in ques-\\ntion.\\n\\nThe calculation should cover the entire relevant rpm range and the simulation of responses at\\ntorsional vibration resonances.\\n\\n\", \"origin\": {\"file\": \"data/requirements/TRAFICOM_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 121476, \"end\": 125006}}}, {\"evidence_id\": \"E280\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputFormulaDisplacement> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Engine output formula displacement\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E281\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceClass> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E282\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#hullStructure> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Hull structure\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E283\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipSizeEngineOutputFactorCd> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-037\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E284\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipSizeEngineOutputCoefficientK> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-037\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E285\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceClass> <https://w3id.org/nltl/vocab#stage1LocalName> \\\"iceClass\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E286\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipSizeEngineOutputCoefficientK> <http://www.w3.org/2000/01/rdf-schema#range> <http://qudt.org/schema/qudt/QuantityValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E287\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-118\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E288\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputCoefficientKe> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-028\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E289\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-110\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E290\", \"kind\": \"SOURCE\", \"text\": \"6     PROPULSION MACHINERY\\n\\n6.1     Scope\\n\\nThese regulations apply to propulsion machinery covering open- and ducted-type propellers\\nwith a controllable pitch or fixed pitch design for ice classes IA Super, IA, IB and IC. The given\\npropeller loads are the expected ice loads for the entire ship’s service life under normal opera-\\ntional conditions, including loads resulting from the changing rotational direction of FP propel-\\nlers. However, these loads do not cover off-design operational conditions, for example when a\\nstopped propeller is dragged through ice. However, the load models of the regulations do not\\ninclude propeller/ice interaction loads when ice enters the propeller of a turned azimuthing\\nthruster from the side (radially).\\n\\nThe regulations also apply to azimuthing and fixed thrusters for main propulsion, taking con-\\nsideration of loads resulting from propeller/ice interaction and loads on the thruster body/ice\\ninteraction. The given azimuthing thruster body loads are the expected ice loads for the ship’s\\n\\f                                                                                           Regulation\\n                                                                                                   27 (65)\\n                                                                 TRAFICOM/68863/03.04.01.00/2021\\n\\n\\n\\n\\nservice life under normal operational conditions. The local strength of the thruster body shall\\nbe sufficient to withstand local ice pressure when the thruster body is designed for extreme\\nloads.\\n\\nThe thruster global vibrations caused by blade order excitation on the propeller may cause sig-\\nnificant vibratory loads.\\n\\n6.2         Definitions\\n\\nc              m          chord length of blade section\\nc0.7           m          chord length of blade section at 0.7R propeller radius\\nCP                        controllable pitch\\nD              m          propeller diameter\\nd              m          external diameter of propeller hub (at propeller plane)\\nDlimit         m          limit value for propeller diameter\\nEAR                       expanded blade area ratio\\nFb             kN         maximum backward blade force for the ship’s service life\\nFex            kN         ultimate blade load resulting from blade loss through plastic bending\\nFf             kN         maximum forward blade force during the ship’s service life\\nFice           kN         ice load\\n(Fice)max      kN         maximum ice load during the ship’s service life\\nFP                        fixed pitch\\nh0             m          depth of the propeller centreline from the lower ice waterline\\nHice           m          thickness of the maximum design ice block entering the propeller\\nHiced          m          thickness of the design ice block impacting the thruster (2/3 of Hice)\\nIe             kgm2       equivalent mass moment of inertia of all parts on the engine side of\\n                          the component under consideration\\nIt             kgm2       equivalent mass moment of inertia of the whole propulsion system\\nk                         shape parameter for Weibull distribution\\nLIWL           m          lower ice waterline\\nm                         slope for SN curve in log/log scale\\nMBL            kNm        blade bending moment\\nMCR                       maximum continuous rating\\nn              rev./s     propeller rotational speed\\nnn             rev./s     nominal propeller rotational speed at MCR in free running condition\\nNclass                    reference number of impacts per nominal propeller rotational speed\\n                          per ice class\\nNice                      total number of ice loads on the propeller blade for the ship’s service\\n                          life\\nNR                        reference number of load for the equivalent fatigue stress (108 cycles)\\nNQ                        number of propeller revolutions during a milling sequence\\nP0,7           m          propeller pitch at 0.7R radius\\nP0.7n          m          propeller pitch at 0.7R radius at MCR in free running condition\\nP0.7b          m          propeller pitch at 0.7R radius at MCR in bollard condition\\nQ              kNm        torque\\nQemax          kNm        maximum engine torque\\nQmax           kNm        maximum torque on the propeller resulting from propeller/ice interac-\\n                          tion\\nQmaxn          kNm        maximum torque on the propeller resulting from propeller/ice interac-\\n                          tion reduced to the rotational speed in question\\n\\f                                                                                                            Regulation\\n                                                                                                                      28 (65)\\n                                                                                TRAFICOM/68863/03.04.01.00/2021\\n\\n\\n\\n\\nQmotor                kNm   electric motor peak torque\\nQn                    kNm   nominal torque at MCR in free running condition\\nQr                    kNm   response torque along the propeller shaft line\\nQpeak                 kNm   maximum of the response torque Qr\\nQsmax                 kNm   maximum spindle torque of the blade for the ship’s service life\\nQsex                  kNm   maximum spindle torque due to blade failure caused by plastic bend-\\n                            ing\\nQvib                  kNm   vibratory torque at considered component, taken from frequency do-\\n                            main open water torque vibration calculation (TVC)\\nR                     m     propeller radius\\nr                     m     blade section radius\\nT                     kN    propeller thrust\\nTb                    kN    maximum backward propeller ice thrust during the ship’s service life\\nTf                    kN    maximum forward propeller ice thrust during the ship’s service life\\nTn                    kN    propeller thrust at MCR in free running condition\\nTr                    kN    maximum response thrust along the shaft line\\nt                     m     maximum blade section thickness\\nZ                           number of propeller blades\\nαi                    deg   duration of propeller blade/ice interaction expressed in rotation angle\\nα1                    deg   phase angle of propeller ice torque for blade order excitation compo-\\n                            nent\\nα2                    deg   phase angle of propeller ice torque for twice the blade order excitation\\n                            component\\n𝛾𝛾𝜖𝜖1                       the reduction factor for fatigue; scatter effect\\n 𝛾𝛾𝜖𝜖2                      the reduction factor for fatigue; test specimen size effect\\n𝛾𝛾𝜈𝜈                        the reduction factor for fatigue; variable amplitude loading effect\\n𝛾𝛾𝑚𝑚                        the reduction factor for fatigue; mean stress effect\\n𝜌𝜌                          a reduction factor for fatigue correlating the maximum stress ampli-\\n                            tude to the equivalent fatigue stress for 108 stress cycles\\n𝜎𝜎0.2                 MPa   proof yield strength (at 0.2% offset) of blade material\\n𝜎𝜎𝑒𝑒𝑒𝑒𝑒𝑒              MPa   mean fatigue strength of blade material at 108 cycles to failure in sea\\n                            water\\n𝜎𝜎𝑓𝑓𝑓𝑓𝑓𝑓              MPa   equivalent fatigue ice load stress amplitude for 108 stress cycles\\n𝜎𝜎𝑓𝑓𝑓𝑓                MPa   characteristic fatigue strength for blade material\\n𝜎𝜎𝑟𝑟𝑟𝑟𝑟𝑟1             MPa   reference strength 𝜎𝜎𝑟𝑟𝑟𝑟𝑟𝑟1 = 0,6𝜎𝜎0.2 + 0,4𝜎𝜎𝑢𝑢\\n𝜎𝜎𝑟𝑟𝑟𝑟𝑟𝑟2             MPa   reference strength 𝜎𝜎𝑟𝑟𝑟𝑟𝑟𝑟2 = 0,7𝜎𝜎𝑢𝑢 or 𝜎𝜎𝑟𝑟𝑟𝑟𝑟𝑟2 = 0,6𝜎𝜎0.2 + 0,4𝜎𝜎𝑢𝑢 , whichever is\\n                            less\\n𝜎𝜎𝑠𝑠𝑠𝑠                MPa   maximum stress resulting from Fb or Ff\\n𝜎𝜎𝑢𝑢                  MPa   ultimate tensile strength of blade material\\n(𝜎𝜎𝑖𝑖𝑖𝑖𝑖𝑖 )𝑏𝑏𝑏𝑏𝑎𝑎𝑎𝑎   MPa   principal stress caused by the maximum backward propeller ice load\\n(𝜎𝜎𝑖𝑖𝑖𝑖𝑖𝑖 )𝑓𝑓𝑓𝑓𝑓𝑓𝑓𝑓   MPa   principal stress caused by the maximum forward propeller ice load\\n(𝜎𝜎𝑖𝑖𝑖𝑖𝑖𝑖 )𝑚𝑚𝑚𝑚𝑚𝑚     MPa   maximum ice load stress amplitude\\n\\f                                                                                  Regulation\\n                                                                                         29 (65)\\n                                                         TRAFICOM/68863/03.04.01.00/2021\\n\\n\\n\\n\\n                               Table 6-1: Definition of loads.\\n        Definition                                       Use of the load in design process\\nFb      The maximum lifetime backward force on a         Design force for strength calcula-\\n        propeller blade resulting from propeller/ice     tion of the propeller blade.\\n        interaction, including hydrodynamic loads\\n        on that blade. The direction of the force is\\n        perpendicular to the 0.7R chord line. See\\n        Figure 6-1.\\n\\nFf      The maximum lifetime forward force on a          Design force for calculation of\\n        propeller blade resulting from propeller/ice     strength of the propeller blade.\\n        interaction, including hydrodynamic loads\\n        on that blade. The direction of the force is\\n        perpendicular to the 0.7R chord line.\\n\\nQsmax   The maximum lifetime spindle torque on a         When designing the propeller\\n        propeller blade resulting from propeller/ice     strength, the spindle torque is au-\\n        interaction, including hydrodynamic loads        tomatically taken into account be-\\n        on that blade.                                   cause the propeller load is acting\\n                                                         on the blade in the form of distrib-\\n                                                         uted pressure on the leading edge\\n                                                         or tip area.\\n\\nTb      The maximum lifetime thrust on a propeller       Is used for estimating the response\\n        (all blades) resulting from propeller/ice in-    thrust Tr. Tb can be used as an esti-\\n        teraction. The direction of the thrust is the    mate of excitation in axial vibration\\n        propeller shaft direction and the force is op-   calculations. However, axial vibra-\\n        posite to the hydrodynamic thrust.               tion calculations are not required\\n                                                         by the rules.\\n\\nTf      The maximum lifetime thrust on a propeller       Is used for estimating the response\\n        (all blades) resulting from propeller/ice in-    thrust Tr. Tf can be used as an esti-\\n        teraction. The direction of the thrust is the    mate of excitation in axial vibration\\n        propeller shaft direction acting in the direc-   calculations. However, axial vibra-\\n        tion of hydrodynamic thrust.                     tion calculations are not required\\n                                                         by the rules.\\n\\nQmax    The maximum ice-induced torque resulting         Is used for estimating the response\\n        from propeller/ice interaction on one pro-       torque (Qr) along the propulsion\\n        peller blade, including hydrodynamic loads       shaft line and as excitation for tor-\\n        on that blade.                                   sional vibration calculations.\\n\\nFex     Ultimate blade load resulting from blade         Blade failure load is used to dimen-\\n        loss through plastic bending. The force that     sion the blade bolts, pitch control\\n        is needed to cause total failure of the blade    mechanism, propeller shaft, pro-\\n        so that a plastic hinge appears in the root      peller shaft bearing and trust bear-\\n        area. The force is acting on 0.8R. The spin-     ing. The objective is to guarantee\\n        dle arm is 2/3 of the distance between the       that total propeller blade failure\\n        axis of blade rotation and the leading/trail-    does not lead to damage to other\\n        ing edge (whichever is the greater) at the       components.\\n        0.8R radius.\\n\\f                                                                                       Regulation\\n                                                                                              30 (65)\\n                                                              TRAFICOM/68863/03.04.01.00/2021\\n\\n\\n\\n\\n Qr        Maximum response torque along the pro-             Design torque for propeller shaft\\n           peller shaft line, taking account of the dy-       line components.\\n           namic behaviour of the shaft line for ice ex-\\n           citation (torsional vibration) and the hydro-\\n           dynamic mean torque on the propeller.\\n\\n Tr        Maximum response thrust along the shaft            Design thrust for propeller shaft\\n           line, taking account of the dynamic behav-         line components.\\n           iour of the shaft line for ice excitation (axial\\n           vibration) and the hydrodynamic mean\\n           thrust on the propeller.\\n\\n Fti       Maximum response force caused by ice               Design load for thruster body and\\n           block impacts on the thruster body or the          slewing bearings.\\n           propeller hub.\\n\\n Ftr       Maximum response force on the thruster             Design load for thruster body and\\n           body caused by ice ridge/thruster body in-         slewing bearings.\\n           teraction.\\n\\n\\n\\n\\n                                              Shaft\\n                                              direction\\n\\n\\n                  Back side\\n\\n\\n                                             Fb\\n\\n\\n\\n\\n Direction of\\n rotation\\n\\n\\n\\n\\nFigure 6-1. Direction of the resultant backward blade force taken perpendicular to the chord\\nline at radius 0.7R. The ice contact pressure at the leading edge is indicated with small ar-\\nrows.\\n\\f                                                                                                  Regulation\\n                                                                                                         31 (65)\\n                                                                     TRAFICOM/68863/03.04.01.00/2021\\n\\n\\n\\n\\n6.3      Design ice conditions\\n\\nIn estimating the ice loads of the propeller for various ice classes, account was taken of differ-\\nent types of operation as shown in Table 6-2. For the estimation of design ice loads, a maxi-\\nmum ice block size must be determined. The maximum design ice block entering the propeller\\nis a rectangular ice block with the dimensions 𝐻𝐻𝑖𝑖𝑖𝑖𝑖𝑖 ∙ 2𝐻𝐻𝑖𝑖𝑖𝑖𝑖𝑖 ∙ 3𝐻𝐻𝑖𝑖𝑖𝑖𝑖𝑖 . The thickness of the ice block\\n(Hice) is given in Table 6-3.\\n\\n                          Table 6-2: Types of operation for different ice classes.\\n             Ice class         Operation of the ship\\n             IA Super          Operation in ice channels and in level ice\\n                               The ship may proceed by ramming\\n             IA, IB, IC        Operation in ice channels\\n\\n                                Table 6-3: Thickness of design ice block.\\n                                                 IA Super IA           IB                 IC\\n            Thickness of the design maxi-           1.75 m        1.5 m       1.2 m       1.0 m\\n            mum ice block entering the pro-\\n            peller (Hice)\\n\\n\\n\", \"origin\": {\"file\": \"data/requirements/TRAFICOM_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 74570, \"end\": 89766}}}, {\"evidence_id\": \"E291\", \"kind\": \"SOURCE\", \"text\": \"3.2.4        Existing ships of ice class IA Super or IA\\n\\nIn order to retain ice class IA Super or IA a ship, the keel of which has been laid or which has\\nbeen at a similar stage of construction before 1 September 2003, shall comply with the re-\\nquirements in section 3.2.2 above not later than 1 January in the year when twenty years have\\nelapsed since the year the ship was delivered.\\n\\nIf the ship does not comply with the requirements in section 3.2.2 on the date given above,\\nthe highest lower ice class for which the engine output is sufficient can be confirmed for the\\nship.\\n\\nWhen, for an existing ship, values for some of the hull form parameters required for the calcu-\\nlation method in section 3.2.2 are difficult to obtain, the following alternative formulae can be\\nused:\\n                                                                                                   𝐿𝐿𝐿𝐿 3 𝐵𝐵\\n               𝑅𝑅𝐶𝐶𝐶𝐶 = 𝐶𝐶1 + 𝐶𝐶2 + 𝐶𝐶3 (𝐻𝐻𝐹𝐹 + 𝐻𝐻𝑀𝑀 )2 (𝐵𝐵 + 0.658𝐻𝐻𝐹𝐹 ) + 𝐶𝐶4 𝐿𝐿𝐻𝐻𝐹𝐹2 + 𝐶𝐶5 �𝐵𝐵2 � 4 ,           (3.3)\\n\\n\\n        where for ice class IA, C1=0 and C2=0.\\n\\n        For ice class IA Super, ship without a bulb, C1 and C2 shall be calculated as follows:\\n\\n                                                     𝐵𝐵𝐵𝐵\\n                                           𝐶𝐶1 = 𝑓𝑓1 𝑇𝑇     + 1,84(𝑓𝑓2 𝐵𝐵 + 𝑓𝑓3 𝐿𝐿 + 𝑓𝑓4 𝐵𝐵𝐵𝐵),\\n                                                    2 +1\\n                                                     𝐵𝐵\\n                                                                             𝑇𝑇 𝐵𝐵2\\n                                      𝐶𝐶2 = 3.52(𝑔𝑔1 + 𝑔𝑔2 𝐵𝐵) + 𝑔𝑔3 �1 + 1,2 � .\\n                                                                             𝐵𝐵 √𝐿𝐿\\n\\f                                                                                       Regulation\\n                                                                                                11 (65)\\n                                                               TRAFICOM/68863/03.04.01.00/2021\\n\\n\\n\\n\\n        For ice class IA Super, ship with a bulb, C1 and C2 shall be calculated as follows:\\n                                             𝐵𝐵𝐵𝐵\\n                                 𝐶𝐶1 = 𝑓𝑓1        + 2.89(𝑓𝑓2 𝐵𝐵 + 𝑓𝑓3 𝐿𝐿 + 𝑓𝑓4 𝐵𝐵𝐵𝐵),\\n                                            𝑇𝑇\\n                                           2 +1\\n                                            𝐵𝐵\\n                                                                          𝑇𝑇 𝐵𝐵2\\n                                 𝐶𝐶2 = 6.67(𝑔𝑔1 + 𝑔𝑔2 𝐵𝐵) + 𝑔𝑔3 �1 + 1.2 � .\\n                                                                          𝐵𝐵 √𝐿𝐿\\n\\n        Coefficients f1-f4 and g1-g3 are given in Table 3-3.\\n\\n\\n         Table 3-3: Values of coefficients f1-f4 and g1-g3 for the determination of C1 and C2\\n                                 f1 = 10.3 N/m2 g1 = 1530 N\\n                                 f2 = 45.8 N/m g2 = 170 N/m\\n                                 f3 = 2.94 N/m g3 = 400 N/m1.5\\n                                 f4 = 5.8 N/m2\\n\\n              C3 = 460 kg/(m2s2)\\n              C4 = 18.7 kg/(m2s2)\\n              C5 = 825 kg/s2\\n                               𝐿𝐿𝐿𝐿 3\\n      If the value of the term� 2� is less than 5, the value 5 shall be used and if the value of the\\n                               𝐵𝐵\\n      term is more than 20, the value 20 shall be used.\\n\\n\", \"origin\": {\"file\": \"data/requirements/TRAFICOM_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 33344, \"end\": 36644}}}, {\"evidence_id\": \"E292\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#sourceReference> \\\"IMO26-002 | IMO_AMEND_2026 p.2 | Chapter 9-1 applicability; IMO26-016 | IMO_AMEND_2026 p.5 | Chapter 11-1 applicability\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E293\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipSizeEngineOutputCoefficientK> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Ship size engine output coefficient k\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E294\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Pleasure yacht\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E295\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#propulsionSystemDesignedForIceClass> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#ship> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E296\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Stage 1): candidate concept for cargoShip derived from the linked locked requirements; scope and final semantics require vocabulary approval.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E297\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputFormulaBasePowerP0> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#ship> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E298\", \"kind\": \"CALLER_DECLARATION\", \"text\": \"{\\\"declaration\\\": {\\\"admission_id\\\": \\\"SYNTHETIC_DESIGN_RESEARCH_SCOPE_TRF_010_V1\\\", \\\"approval\\\": {\\\"approved_by\\\": \\\"User in the current conversation\\\", \\\"reference\\\": \\\"User instruction in the current conversation, 2026-11-24 (verbatim approval):\\\\nI approve the grouped synthetic research-scope proposal and its\\\\nexperimental edition selections for I2-005, IMO-001, TRF-010 and\\\\nTRF-035. I approve TRF-035 option A: recorded ruleLength and a\\\\nseparately supplied classificationSocietyRuleLength reference datum.\\\\n\\\\nRecord this instruction as approval provenance. Retain the stated\\\\nlimits: research assumptions do not certify real-vessel eligibility,\\\\nlegal governing editions or society-rule derivation.\\\\n\\\\nPreserve every generated candidate, including the last rejected one,\\\\nwith its findings and terminal reason. Keep acceptance criteria\\\\nidentical across attempts. Do not add a lenient final attempt,\\\\nfallback acceptance or human-review arm.\\\\n\\\\nSelected NLTL output remains the first internally accepted candidate.\\\\nIf none is accepted, report NO_VERDICT. Evaluate rejected candidates\\\\nonly as separately labelled diagnostics; never select by external score.\\\\n\\\\nFinalize the five-requirement paired pilot manifest using the approved\\\\nscopes and TRF-035 mapping choice. Verify identical actual initial\\\\nrequests/settings across arms, evaluation isolation and the existing\\\\n55-call maximum with early stopping.\\\\n\\\\nKeep v0.10.1 implementation frozen. No further pipeline changes.\\\\nReturn final readiness and exact dispatch instructions.\\\\nDo not make model calls or dispatch yet.\\\", \\\"status\\\": \\\"APPROVED\\\"}, \\\"eligibility_assertion\\\": \\\"ASSUMED_EXTERNAL_RESEARCH_ELIGIBILITY\\\", \\\"focus_set\\\": {\\\"mode\\\": \\\"COMPLETE_CLASS_POPULATION_PER_INPUT\\\", \\\"owner_class\\\": \\\"https://w3id.org/nltl/vocab#ship\\\"}, \\\"format_version\\\": 2, \\\"interpretation\\\": \\\"A\\\", \\\"population_description\\\": \\\"Synthetic ship-design records supplied as the complete nltl:ship population of each input. External legal/application eligibility and the experimental source-edition selection are research assumptions, not facts inferred from RDF. This is not real-vessel certification. The population includes incomplete, inconsistent and unrecognized-value records; represented correctness is not assumed. Conditions inside the represented requirement, effective activation, missing represented inputs, paths, units, datatypes and query correctness remain for generated SHACL to address from supplied source/schema. The represented domain is section 1.8 ice-class designation records, not an independent reconstruction of structure, propulsion power or navigational capability. External research eligibility is assumed for the supplied records; section 1.1 expressly applies section 1.8 irrespective of year of build. Designation validity is not assumed, and the source descriptions remain visible. No proof of an actual ship's class assignment or underlying capabilities is claimed.\\\", \\\"provenance\\\": {\\\"basis\\\": \\\"User-approved grouped synthetic research assumptions and experimental editions; no certification of real-vessel eligibility, governing legal editions or society-rule derivation.\\\", \\\"declarant\\\": \\\"User in the current conversation\\\", \\\"reference\\\": \\\"User instruction in the current conversation, 2026-11-24 (verbatim approval):\\\\nI approve the grouped synthetic research-scope proposal and its\\\\nexperimental edition selections for I2-005, IMO-001, TRF-010 and\\\\nTRF-035. I approve TRF-035 option A: recorded ruleLength and a\\\\nseparately supplied classificationSocietyRuleLength reference datum.\\\\n\\\\nRecord this instruction as approval provenance. Retain the stated\\\\nlimits: research assumptions do not certify real-vessel eligibility,\\\\nlegal governing editions or society-rule derivation.\\\\n\\\\nPreserve every generated candidate, including the last rejected one,\\\\nwith its findings and terminal reason. Keep acceptance criteria\\\\nidentical across attempts. Do not add a lenient final attempt,\\\\nfallback acceptance or human-review arm.\\\\n\\\\nSelected NLTL output remains the first internally accepted candidate.\\\\nIf none is accepted, report NO_VERDICT. Evaluate rejected candidates\\\\nonly as separately labelled diagnostics; never select by external score.\\\\n\\\\nFinalize the five-requirement paired pilot manifest using the approved\\\\nscopes and TRF-035 mapping choice. Verify identical actual initial\\\\nrequests/settings across arms, evaluation isolation and the existing\\\\n55-call maximum with early stopping.\\\\n\\\\nKeep v0.10.1 implementation frozen. No further pipeline changes.\\\\nReturn final readiness and exact dispatch instructions.\\\\nDo not make model calls or dispatch yet.\\\"}, \\\"source_editions\\\": [{\\\"document_id\\\": \\\"TRAFICOM/68863/03.04.01.00/2021\\\", \\\"edition\\\": \\\"2021 regulation (issued 1 July 2021)\\\", \\\"file\\\": \\\"data/requirements/TRAFICOM_full.txt\\\", \\\"selection_provenance\\\": \\\"User instruction in the current conversation, 2026-11-24 (verbatim approval):\\\\nI approve the grouped synthetic research-scope proposal and its\\\\nexperimental edition selections for I2-005, IMO-001, TRF-010 and\\\\nTRF-035. I approve TRF-035 option A: recorded ruleLength and a\\\\nseparately supplied classificationSocietyRuleLength reference datum.\\\\n\\\\nRecord this instruction as approval provenance. Retain the stated\\\\nlimits: research assumptions do not certify real-vessel eligibility,\\\\nlegal governing editions or society-rule derivation.\\\\n\\\\nPreserve every generated candidate, including the last rejected one,\\\\nwith its findings and terminal reason. Keep acceptance criteria\\\\nidentical across attempts. Do not add a lenient final attempt,\\\\nfallback acceptance or human-review arm.\\\\n\\\\nSelected NLTL output remains the first internally accepted candidate.\\\\nIf none is accepted, report NO_VERDICT. Evaluate rejected candidates\\\\nonly as separately labelled diagnostics; never select by external score.\\\\n\\\\nFinalize the five-requirement paired pilot manifest using the approved\\\\nscopes and TRF-035 mapping choice. Verify identical actual initial\\\\nrequests/settings across arms, evaluation isolation and the existing\\\\n55-call maximum with early stopping.\\\\n\\\\nKeep v0.10.1 implementation frozen. No further pipeline changes.\\\\nReturn final readiness and exact dispatch instructions.\\\\nDo not make model calls or dispatch yet.\\\\nExperimental source selection only, not legally governing-edition determination.\\\", \\\"sha256\\\": \\\"e0bf179c97a1535aa7d4d0dd5d4053edf5f3f4e7e028c49d14c3a31cc7c1e8ba\\\"}]}, \\\"declaration_sha256\\\": \\\"9ca723848aea4568e88258562b96eccbc9e7fa9adecc81cf0a14e26a01be8098\\\", \\\"policy\\\": {\\\"caller_attestation_is_not_independent_certification\\\": true, \\\"constraint_responsibilities\\\": [\\\"represented requirement obligations\\\", \\\"conditions within the represented requirement\\\", \\\"declared datatypes units and paths\\\", \\\"effective activation within admitted population\\\", \\\"complete query and logical correctness\\\"], \\\"external_responsibilities\\\": [\\\"synthetic research-population eligibility assumption\\\", \\\"applicable source-edition selection and construction-date eligibility\\\"], \\\"interpretation\\\": \\\"A\\\", \\\"no_eligibility_inferred_from_missing_assertions\\\": true}, \\\"scope_definition_sha256\\\": \\\"884e4f5e66e11d15074b9459ac215c5b69ba9c028f965b157e7433632b434a82\\\", \\\"verification\\\": \\\"Approved common experimental scope, declared class and retained source hashes checked. No input nodes, case identifiers, labels or counterparts loaded; no real-vessel eligibility or legal edition applicability certified.\\\"}\", \"origin\": {\"context_field\": \"admission\"}}, {\"evidence_id\": \"E299\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#propulsionSystemDesignedForIceClass> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Propulsion system designed for ice class\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E300\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <http://www.w3.org/2004/02/skos/core#altLabel> \\\"oil_tanker\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E301\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-0121\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E302\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#shipSizeEngineOutputCoefficientK\\\", \\\"kind\\\": \\\"QuantityProperty\\\", \\\"label\\\": \\\"Ship size engine output coefficient k\\\", \\\"localName\\\": \\\"shipSizeEngineOutputCoefficientK\\\", \\\"parentOrRange\\\": \\\"http://qudt.org/schema/qudt/QuantityValue\\\", \\\"sourceRefs\\\": \\\"TRF-037 | TRAFICOM p.14 | 4.2.2\\\", \\\"unitIri\\\": \\\"http://qudt.org/vocab/unit/UNITLESS\\\", \\\"unitSymbol\\\": \\\"1\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E303\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#openWaterIceCondition> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Open water ice condition\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E304\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputCoefficientKe> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Engine-output coefficient Ke\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E305\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nl