}, {\"evidence_id\": \"E170\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#sourceAlias> \\\"pleasure_yacht\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E171\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipSizeEngineOutputCoefficientK> <https://w3id.org/nltl/vocab#namingBasis> \\\"Applicable TRAFICOM regulation wording plus explicit engineering node/operand role\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E172\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceClass> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-001\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E173\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#propulsionSystemDesignedForIceClass> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R9 development): Propulsion system designed for ice class represents the linked requirement entity, relationship, value, evidence role, or quantity; its scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E174\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#ownerRequested2008EngineOutputRequirements> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R7): true when the owner has requested application of the 2008 Ice Class Regulations to engine output for the specified ship cohort.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E175\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceClassValue> <http://www.w3.org/2000/01/rdf-schema#subClassOf> <http://www.w3.org/2004/02/skos/core#Concept> .\", \"orig