idence_id\": \"E93\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceClass> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#ObjectProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E94\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"iri\\\": \\\"https://w3id.org/nltl/vocab#iceClassIii\\\", \\\"kind\\\": \\\"NamedIndividual\\\", \\\"label\\\": \\\"III\\\", \\\"localName\\\": \\\"iceClassIii\\\", \\\"mapping_basis\\\": \\\"Ontology declaration (registry row not required)\\\", \\\"types\\\": [\\\"http://www.w3.org/2004/02/skos/core#Concept\\\", \\\"https://w3id.org/nltl/vocab#iceClassValue\\\"]}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E95\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#propulsionMachineryContinuousOutput> <https://w3id.org/nltl/vocab#namingRule> \\\"N4 - explicit engineering quantity in ASCII lowerCamelCase; formula symbols remain aliases only.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E96\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"kind\\\": \\\"REPRESENTATION_ONLY\\\", \\\"modelPaths\\\": [], \\\"owners\\\": {\\\"iceClass\\\": \\\"ship\\\"}, \\\"target_owner\\\": \\\"ship\\\"}\", \"origin\": {\"context_field\": \"contract\"}}, {\"evidence_id\": \"E97\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#passengerShip\\\", \\\"kind\\\": \\\"Class\\\", \\\"label\\\": \\\"Passenger ship\\\", \\\"localName\\\": \\\"passengerShip\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#ship\\\", \\\"sourceRefs\\\": \\\"IMO-070 | IMO_POLAR_CODE p.24 | 8.3.3.1.1; IMO-118 | IMO_POLAR_CODE p.43 | 4.2.2\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E98\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#benchmarkEntity> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E99\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceClassRegulationEdition2002> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E100\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputFormulaFactorF3> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-132\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E101\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#markingPlainlyVisibleInIceConditions> <http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#boolean> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E102\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E103\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipSizeEngineOutputCoefficientB> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#benchmarkEntity> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E104\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputRegulationEdition> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-DEV-B01-047\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E105\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipSizeEngineOutputCoefficientA> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/nltl/vocab#benchmarkEntity> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E106\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#namingBasis> \\\"Benchmark-coined descriptive engineering term\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E107\", \"kind\": \"SOURCE\", \"text\": \"6.6.1      Design principle\\n\\nThe strength of the propulsion line shall be designed according to the pyramid strength princi-\\nple. This means that the loss of the propeller blade shall not cause any significant damage to\\nother propeller shaft line components.\\n\\n\", \"origin\": {\"file\": \"data/requirements/TRAFICOM_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 129860, \"end\": 130120}}}, {\"evidence_id\": \"E108\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#shipSizeEngineOutputFactorCd\\\", \\\"kind\\\": \\\"QuantityProperty\\\", \\\"label\\\": \\\"Ship size engine output factor cd\\\", \\\"localName\\\": \\\"shipSizeEngineOutputFactorCd\\\", \\\"parentOrRange\\\": \\\"http://qudt.org/schema/qudt/QuantityValue\\\", \\\"sourceRefs\\\": \\\"TRF-037 | TRAFICOM p.14 | 4.2.2\\\", \\\"unitIri\\\": \\\"http://qudt.org/vocab/unit/UNITLESS\\\", \\\"unitSymbol\\\": \\\"1\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E109\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipSizeEngineOutputCoefficientK> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Ship size engine output coefficient k\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E110\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputFormulaFactorF2> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R9 development): Engine output formula factor f2 represents the linked requirement entity, relationship, value, evidence role, or quantity; its scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E111\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputFormulaFactorF1> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Engine output formula factor f1\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E112\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceClassRegulationEdition2002> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-005\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E113\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputComplianceMethodValue> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"TRF-024\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E114\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipSizeEngineOutputCoefficientB> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Ship size engine output coefficient b\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E115\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#propulsionMachineryContinuousOutput> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Development unit selected and fixture conversion required\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E116\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputComplianceMethodValue> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E117\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Passenger ship\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E118\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#stage1LocalName> \\\"passengerShip\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E119\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceClassValue> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E120\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#propulsionSystemDesignedForIceClass> <http://www.w3.org/2000/01/rdf-schema#range> <https://w3id.org/nltl/vocab#iceClassValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E121\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#markingPlainlyVisibleInIceConditions> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#DatatypeProperty> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E122\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipSizeEngineOutputCoefficientA> <https://w3id.org/nltl/vocab#namingRule> \\\"N4 - explicit engineering quantity in ASCII lowerCamelCase; formula symbols remain aliases only.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E123\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceClass> <https://w3id.org/nltl/vocab#evidenceExcerpt> \\\"The Ice Class Regulations of 2021 apply to ships contracted for construction on or after 5 July 2021. The provisions in section 1.8 (Ice classes) and chapter 2 (Ice Class Draught) in the 2021 Ice Class Regulations apply to all ships irrespective of their year of build.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E124\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E125\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputFormulaFactorF2> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Engine output formula factor f2\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E126\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputRegulationEdition> <https://w3id.org/nltl/vocab#namingBasis> \\\"Applicable TRAFICOM regulation wording plus explicit engineering node/operand role\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E127\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#engineOutputComplianceMethod> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Typed relationship needed to traverse between engineering or evidence nodes.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E128\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#ownerRequested2008EngineOutputRequirements> <http://www.w3.org/2000/01/rdf-schema#domain> <https://w3id.org/