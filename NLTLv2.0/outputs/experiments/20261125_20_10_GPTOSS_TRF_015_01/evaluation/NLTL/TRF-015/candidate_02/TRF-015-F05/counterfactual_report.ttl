@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F05/ship> ;
            sh:resultMessage "When navigating in ice the intended route sea‑water salinity is missing or has an invalid unit." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When navigating in ice the intended route sea‑water salinity is missing or has an invalid unit." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://www.qudt.org/vocab/unit#>
            SELECT $this
            WHERE {
                $this nltl:navigatingInIce true .
                FILTER NOT EXISTS {
                    $this nltl:intendedRouteSeaWaterSalinity ?salinity .
                    ?salinity qudt:numericValue ?val .
                    ?salinity qudt:unit <https://w3id.org/nltl/vocab#gramPerKilogramSalinityUnit> .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:ShipIceNavigationShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F05/ship> ;
            sh:resultMessage "When navigating in ice the loading‑calculation sea‑water salinity is missing or has an invalid unit." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When navigating in ice the loading‑calculation sea‑water salinity is missing or has an invalid unit." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://www.qudt.org/vocab/unit#>
            SELECT $this
            WHERE {
                $this nltl:navigatingInIce true .
                FILTER NOT EXISTS {
                    $this nltl:loadingCalculationSeaWaterSalinity ?salCalc .
                    ?salCalc qudt:numericValue ?val .
                    ?salCalc qudt:unit <https://w3id.org/nltl/vocab#gramPerKilogramSalinityUnit> .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:ShipIceNavigationShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F05/ship> ] .

