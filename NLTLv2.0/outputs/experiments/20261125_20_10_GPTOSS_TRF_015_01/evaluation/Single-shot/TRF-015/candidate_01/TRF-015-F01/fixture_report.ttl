@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F01/ship> ;
            sh:resultMessage "When navigating in ice the operating draught exceeds the Upper Ice Waterline draught." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When navigating in ice the operating draught exceeds the Upper Ice Waterline draught." ;
                    sh:select """
            SELECT $this ( ?operDraughtVal AS ?value )
            WHERE {
                $this nltl:navigatingInIce true .
                $this nltl:operatingDraught ?operDraught .
                $this nltl:upperIceWaterlineDraught ?uiwl .
                
                ?operDraught qudt:numericValue ?operDraughtVal .
                ?operDraught qudt:unit <http://qudt.org/vocab/unit/M> .
                
                ?uiwl qudt:numericValue ?uiwlVal .
                ?uiwl qudt:unit <http://qudt.org/vocab/unit/M> .
                
                FILTER ( ?operDraughtVal > ?uiwlVal )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:ShipIceNavigationShape ;
            sh:value 6.1 ] .

