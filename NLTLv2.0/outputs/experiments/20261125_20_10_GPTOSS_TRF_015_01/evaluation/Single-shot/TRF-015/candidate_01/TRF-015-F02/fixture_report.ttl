@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F02/ship> ;
            sh:resultMessage "When navigating in ice the operating trim exceeds the maximum permitted ice trim." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When navigating in ice the operating trim exceeds the maximum permitted ice trim." ;
                    sh:select """
            SELECT $this ( ?operTrimVal AS ?value )
            WHERE {
                $this nltl:navigatingInIce true .
                $this nltl:operatingTrim ?operTrim .
                $this nltl:maximumPermittedIceTrim ?maxTrim .
                
                ?operTrim qudt:numericValue ?operTrimVal .
                ?operTrim qudt:unit <http://qudt.org/vocab/unit/M> .
                
                ?maxTrim qudt:numericValue ?maxTrimVal .
                ?maxTrim qudt:unit <http://qudt.org/vocab/unit/M> .
                
                FILTER ( ?operTrimVal > ?maxTrimVal )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:ShipIceNavigationShape ;
            sh:value 0.6 ] .

