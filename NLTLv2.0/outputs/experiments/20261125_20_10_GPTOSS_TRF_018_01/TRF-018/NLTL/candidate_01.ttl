@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

# Shape applying to all ships (the admitted synthetic population)
nltl:ShipEngineOutputShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    
    # Constraint for IA Super ships – minimum 2 800 kW
    sh:sparql [
        a sh:SPARQLConstraint ;
        rdfs:comment "The engine output shall not be less than 2 800 kW for ice class IA Super (TRF‑018)." ;
        sh:message "Engine output for IA Super ships must be ≥ 2 800 kW." ;
        sh:select """
            SELECT $this ?val WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper .
                $this nltl:calculatedRequiredPower ?cp .
                ?cp qudt:numericValue ?val .
                ?cp qudt:unit unit:KiloW .
                FILTER ( ?val < 2800 )
            }
        """ ;
    ] ;
    
    # Constraint for IA, IB, IC ships – minimum 1 000 kW
    sh:sparql [
        a sh:SPARQLConstraint ;
        rdfs:comment "The engine output shall not be less than 1 000 kW for ice classes IA, IB and IC (TRF‑018)." ;
        sh:message "Engine output for IA, IB, or IC ships must be ≥ 1 000 kW." ;
        sh:select """
            SELECT $this ?val WHERE {
                $this nltl:iceClass ?ic .
                FILTER ( ?ic IN (nltl:iceClassIa, nltl:iceClassIb, nltl:iceClassIc) )
                $this nltl:calculatedRequiredPower ?cp .
                ?cp qudt:numericValue ?val .
                ?cp qudt:unit unit:KiloW .
                FILTER ( ?val < 1000 )
            }
        """ ;
    ] .

# Declaration of the quantity value class (required for the value nodes)
unit:KiloW a rdf:Property .   # placeholder to ensure the IRI is known in the graph

