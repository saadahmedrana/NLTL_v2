@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P03/ship> ;
            sh:resultMessage "Engine output for IA Super ships must be ≥ 2 800 kW." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    rdfs:comment "The engine output shall not be less than 2 800 kW for ice class IA Super (TRF‑018)." ;
                    sh:message "Engine output for IA Super ships must be ≥ 2 800 kW." ;
                    sh:select """
            SELECT $this ?val WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper .
                $this nltl:calculatedRequiredPower ?cp .
                ?cp qudt:numericValue ?val .
                ?cp qudt:unit unit:KiloW .
                FILTER ( ?val < 2800 )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:ShipEngineOutputShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P03/ship> ] .

