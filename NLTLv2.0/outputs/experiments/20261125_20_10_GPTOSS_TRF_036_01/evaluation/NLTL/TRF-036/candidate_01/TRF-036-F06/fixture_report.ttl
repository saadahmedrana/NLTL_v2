@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F06/levelIceThickness> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F06/levelIceThickness>->qudt:unit does not contain a value in the set: ['unit:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n46ce93963b7f4471b020070b762b1135b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F06/designParameters> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ; sh:targetClass qudt:QuantityValue ]. See details for more information." ;
            sh:resultPath nltl:levelIceThickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:description "Level ice thickness (hi) for the ice class." ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ;
                            sh:targetClass qudt:QuantityValue ] ;
                    sh:path nltl:levelIceThickness ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F06/levelIceThickness> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F06/levelIceThickness> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F06/levelIceThickness>->qudt:unit does not contain a value in the set: ['unit:M']" ;
            sh:resultPath qudt:unit ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n46ce93963b7f4471b020070b762b1135b3 ] .

_:n46ce93963b7f4471b020070b762b1135b3 sh:hasValue unit:M ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

