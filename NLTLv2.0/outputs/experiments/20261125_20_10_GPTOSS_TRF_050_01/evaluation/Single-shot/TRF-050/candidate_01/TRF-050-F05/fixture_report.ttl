@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vocab: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/attachmentRecord> ;
            sh:resultMessage "The frame must be attached to the shell by a double continuous weld (TRF‑050 §4.4.4.2)." ;
            sh:resultPath vocab:frameShellWeldType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue vocab:doubleContinuousWeld ;
                    sh:message "The frame must be attached to the shell by a double continuous weld (TRF‑050 §4.4.4.2)." ;
                    sh:path vocab:frameShellWeldType ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> ;
            sh:resultMessage "Shell‑plate‑butt crossing flag must be provided (boolean)." ;
            sh:resultPath vocab:shellPlateButtCrossing ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Shell‑plate‑butt crossing flag must be provided (boolean)." ;
                    sh:minCount 1 ;
                    sh:path vocab:shellPlateButtCrossing ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> ;
            sh:resultMessage "Scalloping presence flag must be provided (boolean)." ;
            sh:resultPath vocab:scallopingPresent ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Scalloping presence flag must be provided (boolean)." ;
                    sh:minCount 1 ;
                    sh:path vocab:scallopingPresent ] ] .

