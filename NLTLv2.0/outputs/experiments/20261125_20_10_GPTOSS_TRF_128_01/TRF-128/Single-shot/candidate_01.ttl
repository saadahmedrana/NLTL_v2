@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix vocab: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# Shape targeting all ships
:vesselCompressorShape
    a sh:NodeShape ;
    sh:targetClass vocab:ship ;
    
    # The ship must have a compressorChargeTime value (QuantityValue)
    sh:property [
        sh:path vocab:compressorChargeTime ;
        sh:minCount 1 ;
        sh:class qudt:QuantityValue ;
    ] ;
    
    # Universal constraint: charge time must not exceed 1 hour
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Compressor charge time must not exceed 1 hour." ;
        sh:select """
            SELECT $this WHERE {
                $this vocab:compressorChargeTime ?qt .
                ?qt qudt:numericValue ?val .
                ?qt qudt:unit unit:HR .
                FILTER(?val > 1)
            }
        """ ;
    ] ;
    
    # Conditional tighter constraint for IA Super ships requiring reversal
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For IA Super ships that require propulsion reversal for astern, the compressor charge time must not exceed 0.5 hour." ;
        sh:select """
            SELECT $this WHERE {
                $this vocab:compressorChargeTime ?qt .
                ?qt qudt:numericValue ?val .
                ?qt qudt:unit unit:HR .
                $this vocab:iceClass vocab:iceClassIaSuper .
                $this vocab:propulsionEngineReversalRequiredForAstern true .
                FILTER(?val > 0.5)
            }
        """ ;
    ] .
