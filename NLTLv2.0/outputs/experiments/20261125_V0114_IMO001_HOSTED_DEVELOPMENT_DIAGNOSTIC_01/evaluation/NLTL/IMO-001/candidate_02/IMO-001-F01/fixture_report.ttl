@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-F01/ship> ;
            sh:resultMessage "Ship is classified as Category A (polarShipCategoryA)." ;
            sh:resultPath nltl:shipCategory ;
            sh:resultSeverity sh:Info ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:polarShipCategoryA ;
                    sh:message "Ship is classified as Category A (polarShipCategoryA)." ;
                    sh:path nltl:shipCategory ;
                    sh:severity sh:Info ] ] .

