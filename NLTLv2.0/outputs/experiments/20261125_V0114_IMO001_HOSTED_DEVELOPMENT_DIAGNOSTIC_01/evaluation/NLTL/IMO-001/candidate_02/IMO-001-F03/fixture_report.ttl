@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-F03/ship> ;
            sh:resultMessage "Category A ship must be designed for operation in at least medium first‑year ice (may include old ice inclusions)." ;
            sh:resultPath nltl:designIceCondition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:mediumFirstYearIceWithPossibleOldIceInclusions ;
                    sh:message "Category A ship must be designed for operation in at least medium first‑year ice (may include old ice inclusions)." ;
                    sh:path nltl:designIceCondition ;
                    sh:severity sh:Violation ] ] .

