\"evidence_id\": \"E90\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceConditionLessSevereThanCategoryAAndB> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R7): controlled design-ice-condition value for the source-defined less-severe-than-category-A-and-B branch.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E91\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/nltl/vocab#ship> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E92\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Explicit engineering entity/artifact class set\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E93\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#sourceAlias> \\\"pleasure_yacht\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E94\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#iceConditionLessSevereThanCategoryAAndB\\\", \\\"kind\\\": \\\"NamedIndividual\\\", \\\"label\\\": \\\"Ice condition less severe than categories A and B\\\", \\\"localName\\\": \\\"iceConditionLessSevereThanCategoryAAndB\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#iceConditionValue\\\", \\\"sourceRefs\\\": \\\"IMO-003 | IMO_POLAR_CODE p.11 | 1.2.3\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E95\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipCategory> <http://www.w3.org/2004/02/skos/core#altLabel> \\\"ship_category\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E96\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipCategory> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO26-011\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E97\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipCategory> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-118\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E98\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#pleasureYacht\\\", \\\"kind\\\": \\\"Class\\\", \\\"label\\\": \\\"Pleasure yacht\\\", \\\"localName\\\": \\\"pleasureYacht\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#ship\\\", \\\"sourceRefs\\\": \\\"IMO26-002 | IMO_AMEND_2026 p.2 | Chapter 9-1 applicability; IMO26-016 | IMO_AMEND_2026 p.5 | Chapter 11-1 applicability\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E99\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designIceCondition> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-0192\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E100\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#module> <https://w3id.org/nltl/vocab#moduleCore> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E101\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designIceCondition> <https://w3id.org/nltl/vocab#namingRule> \\\"N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E102\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipCategory> <https://w3id.org/nltl/vocab#sourceAlias> \\\"ship_category\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E103\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Fishing vessel\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E104\", \"kind\": \"SOURCE\", \"text\": \" 4.1    Definitions\\n\", \"origin\": {\"file\": \"data/requirements/IMO_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 10312, \"end\": 10332}}}, {\"evidence_id\": \"E105\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <https://w3id.org/nltl/vocab#sourceAlias> \\\"oil_tanker\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E106\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#openWaterIceCondition> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://w3id.org/nltl/vocab#iceConditionValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E107\", \"kind\": \"SOURCE\", \"text\": \"1.2      Definitions\\n\\nIn addition to the definitions included in the relevant SOLAS chapters and the Introduction of\\nthis Code, the following definitions are applicable to this part.\\n\\n1.2.1    Bergy waters mean an area of freely navigable water in which ice of land origin is\\npresent in concentrations less than 1/10. There may be sea ice present, although the total\\nconcentration of all ice shall not exceed 1/10.\\n\\n1.2.2    Escort means any ship with superior ice capability in transit with another ship.\\n\\n1.2.3    Escorted operation means any operation in which a ship's movement is facilitated\\nthrough the intervention of an escort.\\n\\n1.2.4   Habitable environment means a ventilated environment that will protect against\\nhypothermia.\\n\\n1.2.5   Icebreaker means any ship whose operational profile may include escort or ice\\nmanagement functions, whose powering and dimensions allow it to undertake aggressive\\noperations in ice-covered waters.\\n\\n1.2.6    Ice Class means the notation assigned to the ship by the Administration or by an\\norganization recognized by the Administration showing that the ship has been designed for\\nnavigation in sea-ice conditions.\\n\\n1.2.7  Maximum expected time of rescue means the time adopted for the design of\\nequipment and system that provide survival support. It shall never be less than 5 days.\\n\\n1.2.8    Machinery installations means equipment and machinery and associated piping and\\ncabling, which is necessary for the safe operation of the ship.\\n\\n1.2.9    Mean Daily Low Temperature (MDLT) means the mean value of the daily low\\ntemperature for each day of the year over a minimum 10 year period. A data set acceptable\\nto the Administration may be used if 10 years of data is not available.\\n\\f                        RESOLUTION MSC.385(94) (adopted on 21 November 2014)\\n                    INTERNATIONAL CODE FOR SHIPS OPERATING IN POLAR WATERS\\n                                         (POLAR CODE)\\n\\n                                             - 13 -\\n\\n1.2.10 Polar Class (PC) means the ice class assigned to the ship by the Administration or\\nby an organization recognized by the Administration based upon IACS Unified\\nRequirements.\\n\\n1.2.11 Polar Service Temperature (PST) means a temperature specified for a ship which is\\nintended to operate in low air temperature, which shall be set at least 10°C below the lowest\\nMDLT for the intended area and season of operation in polar waters.\\n\\n1.2.12 Ship intended to operate in low air temperature means a ship which is intended to\\nundertake voyages to or through areas where the lowest Mean Daily Low Temperature\\n(MDLT) is below -10°C.\\n\\n1.2.13 Tankers mean oil tankers as defined in SOLAS regulation II-1/2.22, chemical\\ntankers as defined in SOLAS regulation II-1/3.19 and gas carriers as defined in SOLAS\\nregulation VII/11.2.\\n\\n1.2.14 Upper ice waterline means the waterline defined by the maximum draughts forward\\nand aft for operation in ice.\\n\\n\", \"origin\": {\"file\": \"data/requirements/IMO_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 21679, \"end\": 24602}}}, {\"evidence_id\": \"E108\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <http://www.w3.org/2004/02/skos/core#altLabel> \\\"pleasure_yacht\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E109\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#module> <https://w3id.org/nltl/vocab#moduleCore> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E110\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E111\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-0510\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E112\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipCategory> <http://www.w3.org/2000/01/rdf-schema#range> <https://w3id.org/nltl/vocab#polarShipCategoryValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E113\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#openWaterIceCondition> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-DEV-R9-0239\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E114\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#polarShipCategoryB> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://w3id.org/nltl/vocab#polarShipCategoryValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E115\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipCategory> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-001\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E116\", \"kind\": \"SOURCE\", \"text\": \"                                       INTRODUCTION\\n\\n\", \"origin\": {\"file\": \"data/requirements/IMO_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 13761, \"end\": 13814}}}, {\"evidence_id\": \"E117\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#mediumFirstYearIceWithPossibleOldIceInclusions> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://w3id.org/nltl/vocab#iceConditionValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E118\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#shipCategory\\\", \\\"kind\\\": \\\"ObjectProperty\\\", \\\"label\\\": \\\"Ship category\\\", \\\"localName\\\": \\\"shipCategory\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#polarShipCategoryValue\\\", \\\"sourceRefs\\\": \\\"IMO-001 | IMO_POLAR_CODE p.9 | 2.1; IMO-002 | IMO_POLAR_CODE p.9 | 2.2; IMO-003 | IMO_POLAR_CODE p.9 | 2.3; IMO-032 | IMO_POLAR_CODE p.17 | 3.3.2.1-.3; IMO-037 | IMO_POLAR_CODE p.19 | 4.3.2.1; IMO-049 | IMO_POLAR_CODE p.21 | 6.3.3.1-.3; IMO-085 | IMO_POLAR_CODE p.27 | 9.3.2.1.4.2; IMO-108 | IMO_POLAR_CODE p.41 | 1.2.1; IMO-109 | IMO_POLAR_CODE p.41 | 1.2.2; IMO-110 | IMO_POLAR_CODE p.41 | 1.2.3; IMO-111 | IMO_POLAR_CODE p.41 | 1.2.4; IMO-114 | IMO_POLAR_CODE p.42 | 2.1.3; IMO-118 | IMO_POLAR_CODE p.43 | 4.2.2; IMO-119 | IMO_POLAR_CODE p.43 | 4.2.3; IMO26-011 | IMO_AMEND_2026 p.4 | 9-1.3.2.1.4.2\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E119\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO26-002\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E120\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipCategory> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Verified regulation-defined controlled value set\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E121\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Oil tanker\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E122\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Cargo ship\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E123\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"canonical_literal_encoding\\\": \\\"http://www.w3.org/2001/XMLSchema#decimal\\\", \\\"declarations\\\": {\\\"numericValue\\\": {\\\"@id\\\": \\\"qudt:numericValue\\\", \\\"@type\\\": \\\"xsd:decimal\\\"}, \\\"unit\\\": {\\\"@id\\\": \\\"qudt:unit\\\", \\\"@type\\\": \\\"@id\\\"}}, \\\"file\\\": \\\"schema/locked_representation_context.jsonld\\\", \\\"numeric_predicate\\\": \\\"http://qudt.org/schema/qudt/numericValue\\\", \\\"quantity_class\\\": \\\"http://qudt.org/schema/qudt/QuantityValue\\\", \\\"scope\\\": \\\"Declared quantity serialization, not a numeric-equality solution or conversion\\\", \\\"unit_predicate\\\": \\\"http://qudt.org/schema/qudt/unit\\\"}\", \"origin\": {\"context_field\": \"quantityEncoding\"}}, {\"evidence_id\": \"E124\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#mediumFirstYearIceWithPossibleOldIceInclusions> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-001\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E125\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#polarShipCategoryValue> <http://www.w3.org/2000/01/rdf-schema#subClassOf> <http://www.w3.org/2004/02/skos/core#Concept> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E126\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceConditionLessSevereThanCategoryAAndB> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#NamedIndividual> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E127\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <http://www.w3.org/2004/02/skos/core#altLabel> \\\"fishing_vessel\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E128\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipCategory> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-119\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E129\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E130\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designIceCondition> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Design ice condition\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E131\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#cargoShip\\\", \\\"kind\\\": \\\"Class\\\", \\\"label\\\": \\\"Cargo ship\\\", \\\"localName\\\": \\\"cargoShip\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#ship\\\", \\\"sourceRefs\\\": \\\"IMO26-002 | IMO_AMEND_2026 p.2 | Chapter 9-1 applicability; IMO26-016 | IMO_AMEND_2026 p.5 | Chapter 11-1 applicability\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E132\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipCategory> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-049\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E133\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"kind\\\": \\\"REPRESENTATION_ONLY\\\", \\\"modelPaths\\\": [], \\\"owners\\\": {\\\"designIceCondition\\\": \\\"ship\\\", \\\"shipCategory\\\": \\\"ship\\\"}, \\\"target_owner\\\": null}\", \"origin\": {\"context_field\": \"contract\"}}, {\"evidence_id\": \"E134\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designIceCondition> <https://w3id.org/nltl/vocab#sourceAlias> \\\"design_ice_condition\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E135\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#evidenceExcerpt> \\\"This chapter applies to: fishing vessels of 24 metres in length overall and above; pleasure yachts of 300 gross tonnage and upwards not engaged in trade; and cargo ships of 300 gross tonnage and upwards but below 500 gross tonnage.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E136\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E137\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceConditionValue> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-102\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E138\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipCategory> <https://w3id.org/nltl/vocab#stage1LocalName> \\\"shipCategory\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E139\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-118\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E140\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-110\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E141\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#sourceReference> \\\"IMO26-002 | IMO_AMEND_2026 p.2 | Chapter 9-1 applicability; IMO26-016 | IMO_AMEND_2026 p.5 | Chapter 11-1 applicability\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E142\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designIceCondition> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E143\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipCategory> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Ship category\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E144\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Pleasure yacht\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E145\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#mediumFirstYearIceWithPossibleOldIceInclusions> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Medium first-year ice with possible old-ice inclusions\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E146\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designIceCondition> <https://w3id.org/nltl/vocab#evidenceExcerpt> \\\"Category A ship means a ship designed for operation in polar waters in at least medium first-year ice, which may include old ice inclusions.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E147\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Stage 1): candidate concept for cargoShip derived from the linked locked requirements; scope and final semantics require vocabulary approval.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E148\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <http://www.w3.org/2004/02/skos/core#altLabel> \\\"oil_tanker\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E149\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-0121\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E150\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#openWaterIceCondition> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Open water ice condition\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E151\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipCategory> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-037\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E152\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <http://www.w3.org/2004/02/skos/core#altLabel> \\\"cargo_ship\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E153\", \"kind\": \"SOURCE\", \"text\": \"  5.1    Definitions\\n\", \"origin\": {\"file\": \"data/requirements/IMO_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 10688, \"end\": 10709}}}, {\"evidence_id\": \"E154\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E155\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#mediumFirstYearIceWithPossibleOldIceInclusions\\\", \\\"kind\\\": \\\"NamedIndividual\\\", \\\"label\\\": \\\"Medium first-year ice with possible old-ice inclusions\\\", \\\"localName\\\": \\\"mediumFirstYearIceWithPossibleOldIceInclusions\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#iceConditionValue\\\", \\\"sourceRefs\\\": \\\"IMO-001 | IMO_POLAR_CODE p.11 | 1.2.1\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E156\", \"kind\": \"SOURCE\", \"text\": \"5.1     Definitions\\n\\n5.1.1  Ice-shelf means a floating ice sheet of considerable thickness, showing 2 to 50 m or\\nmore above sea-level, attached to the coast.\\n\\n5.1.2   Fast ice means sea ice which forms and remains fast along the coast, where it is\\nattached to the shore, to an ice wall, to an ice front, between shoals or grounded icebergs\\n\\n\", \"origin\": {\"file\": \"data/requirements/IMO_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 104873, \"end\": 105214}}}, {\"evidence_id\": \"E157\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#openWaterIceCondition> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-007\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E158\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#evidenceExcerpt> \\\"For passenger ships, a proper sized immersion suit or a thermal protective aid shall be provided for each person on board.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E159\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"iri\\\": \\\"https://w3id.org/nltl/vocab#polarShipCategoryC\\\", \\\"kind\\\": \\\"NamedIndividual\\\", \\\"label\\\": \\\"Category C\\\", \\\"localName\\\": \\\"polarShipCategoryC\\\", \\\"mapping_basis\\\": \\\"Ontology declaration (registry row not required)\\\", \\\"types\\\": [\\\"http://www.w3.org/2004/02/skos/core#Concept\\\", \\\"https://w3id.org/nltl/vocab#polarShipCategoryValue\\\"]}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E160\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#namingRule> \\\"N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E161\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceConditionLessSevereThanCategoryAAndB> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-003\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E162\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"http://www.w3.org/2001/XMLSchema#decimal\\\", \\\"declaration_evidence\\\": {\\\"numericValue\\\": {\\\"@id\\\": \\\"qudt:numericValue\\\", \\\"@type\\\": \\\"xsd:decimal\\\"}, \\\"unit\\\": {\\\"@id\\\": \\\"qudt:unit\\\", \\\"@type\\\": \\\"@id\\\"}}, \\\"iri\\\": \\\"http://qudt.org/schema/qudt/numericValue\\\", \\\"kind\\\": \\\"DatatypeProperty\\\", \\\"localName\\\": \\\"numericValue\\\", \\\"mapping_basis\\\": \\\"Declared JSON-LD schema/locked_representation_context.jsonld\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E163\", \"kind\": \"SOURCE\", \"text\": \" 2     Definitions\\n\", \"origin\": {\"file\": \"data/requirements/IMO_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 7322, \"end\": 7341}}}, {\"evidence_id\": \"E164\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#module> <https://w3id.org/nltl/vocab#moduleCore> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E165\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#thinFirstYearIceWithPossibleOldIceInclusions> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://w3id.org/nltl/vocab#iceConditionValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E166\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#openWaterIceCondition> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Open water ice condition\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E167\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceConditionValue> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R9 development): Ice condition value represents the linked requirement entity, relationship, value, evidence role, or quantity; its scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E168\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E169\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#draftConceptId> \\\"VOC-0546\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E170\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipCategory> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Stage 1): candidate concept for shipCategory derived from the linked locked requirements; scope and final semantics require vocabulary approval.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E171\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#openWaterIceCondition> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#NamedIndividual> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E172\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#ship> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E173\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceConditionValue> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-007\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E174\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#otherWatersIceCondition> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#NamedIndividual> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E175\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"iri\\\": \\\"https://w3id.org/nltl/vocab#benchmarkEntity\\\", \\\"kind\\\": \\\"Class\\\", \\\"label\\\": \\\"Benchmark entity\\\", \\\"localName\\\": \\\"benchmarkEntity\\\", \\\"mapping_basis\\\": \\\"Ontology declaration (registry row not required)\\\", \\\"types\\\": [\\\"http://www.w3.org/2002/07/owl#Class\\\"]}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E176\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"iri\\\": \\\"https://w3id.org/nltl/vocab#ship\\\", \\\"kind\\\": \\\"Class\\\", \\\"label\\\": \\\"Ship\\\", \\\"localName\\\": \\\"ship\\\", \\\"mapping_basis\\\": \\\"Ontology declaration (registry row not required)\\\", \\\"types\\\": [\\\"http://www.w3.org/2002/07/owl#Class\\\"]}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E177\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#evidenceExcerpt> \\\"This chapter applies to: fishing vessels of 24 metres in length overall and above; pleasure yachts of 300 gross tonnage and upwards not engaged in trade; and cargo ships of 300 gross tonnage and upwards but below 500 gross tonnage.\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E178\", \"kind\": \"SOURCE\", \"text\": \"    RESOLUTION MSC.385(94) (adopted on 21 November 2014)\\nINTERNATIONAL CODE FOR SHIPS OPERATING IN POLAR WATERS\\n                     (POLAR CODE)\\n\\f                        RESOLUTION MSC.385(94) (adopted on 21 November 2014)\\n                    INTERNATIONAL CODE FOR SHIPS OPERATING IN POLAR WATERS\\n                                         (POLAR CODE)\\n\\n\\n                                RESOLUTION MSC.385(94)\\n                              (adopted on 21 November 2014)\\n\\n         INTERNATIONAL CODE FOR SHIPS OPERATING IN POLAR WATERS\\n                              (POLAR CODE)\\n\\n\\nTHE MARITIME SAFETY COMMITTEE,\\n\\nRECALLING article 28(b) of the Convention on the International Maritime Organization\\nconcerning the function of the Committee,\\n\\nRECOGNIZING the need to provide a mandatory framework for ships operating in polar\\nwaters due to the additional demands on ships, their systems and operation, which go\\nbeyond the existing requirements of the International Convention for the Safety of Life at Sea\\n(SOLAS), 1974, as amended (\\\"the Convention\\\"), and other relevant binding\\nIMO instruments,\\n\\nNOTING resolution MSC.386(94), by which it adopted, inter alia, the new chapter XIV of the\\nConvention,\\n\\nNOTING ALSO that the Marine Environment Protection Committee, at its sixty-seventh\\nsession, approved with a view to adoption, at its sixty-eighth session, the Introduction, as it\\nrelates to environmental protection, and parts II-A and II-B of the International Code for Ships\\nOperating in Polar Waters (Polar Code), and also considered for adoption relevant\\namendments to the International Convention for the Prevention of Pollution from Ships, 1973,\\nas modified by the 1978 Protocol,\\n\\nHAVING CONSIDERED, at its ninety-fourth session, the draft International Code for Ships\\nOperating in Polar Waters,\\n\\n\", \"origin\": {\"file\": \"data/requirements/IMO_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 0, \"end\": 1800}}}, {\"evidence_id\": \"E179\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#thinFirstYearIceWithPossibleOldIceInclusions> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E180\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#module> <https://w3id.org/nltl/vocab#moduleCore> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E181\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Stage 1): candidate concept for pleasureYacht derived from the linked locked requirements; scope and final semantics require vocabulary approval.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E182\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#namingRule> \\\"N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E183\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipCategory> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-032\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E184\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designIceCondition> <https://w3id.org/nltl/vocab#sourceReference> \\\"IMO-001 | IMO_POLAR_CODE p.9 | 2.1; IMO-002 | IMO_POLAR_CODE p.9 | 2.2; IMO-003 | IMO_POLAR_CODE p.9 | 2.3\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E185\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceFreeIceCondition> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R9 development): Ice free ice condition represents the linked requirement entity, relationship, value, evidence role, or quantity; its scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E186\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <https://w3id.org/nltl/vocab#sourceReference> \\\"IMO-109 | IMO_POLAR_CODE p.41 | 1.2.2; IMO-110 | IMO_POLAR_CODE p.41 | 1.2.3\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E187\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#otherWatersIceCondition\\\", \\\"kind\\\": \\\"NamedIndividual\\\", \\\"label\\\": \\\"Other waters ice condition\\\", \\\"localName\\\": \\\"otherWatersIceCondition\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#iceConditionValue\\\", \\\"sourceRefs\\\": \\\"IMO-102 | IMO_POLAR_CODE p.30 | 12.3.1\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E188\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Explicit engineering entity/artifact class set\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E189\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#passengerShip> <https://w3id.org/nltl/vocab#sourceAlias> \\\"passenger_ship\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E190\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#fishingVessel\\\", \\\"kind\\\": \\\"Class\\\", \\\"label\\\": \\\"Fishing vessel\\\", \\\"localName\\\": \\\"fishingVessel\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#ship\\\", \\\"sourceRefs\\\": \\\"IMO26-002 | IMO_AMEND_2026 p.2 | Chapter 9-1 applicability; IMO26-016 | IMO_AMEND_2026 p.5 | Chapter 11-1 applicability\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E191\", \"kind\": \"SOURCE\", \"text\": \"2        Definitions\\n\\nFor the purpose of this Code, the terms used have the meanings defined in the following\\nparagraphs. Terms used in part I-A but not defined in this section shall have the same\\nmeaning as defined in SOLAS. Terms used in part II-A but not defined in this section shall\\nhave the same meaning as defined in Article 2 of MARPOL and the relevant MARPOL\\nAnnexes.\\n\\n2.1    Category A ship means a ship designed for operation in polar waters in at least\\nmedium first-year ice, which may include old ice inclusions.\\n\\n2.2     Category B ship means a ship not included in category A, designed for operation in\\npolar waters in at least thin first-year ice, which may include old ice inclusions.\\n\\n2.3     Category C ship means a ship designed to operate in open water or in ice conditions\\nless severe than those included in categories A and B.\\n\\n2.4     First-year ice means sea ice of not more than one winter growth developing from\\nyoung ice with thickness from 0.3 m to 2.0 m.\\n\\n2.5      Ice free waters means no ice present. If ice of any kind is present this term shall not\\nbe used.\\n\\n2.6      Ice of land origin means ice formed on land or in an ice shelf, found floating in water.\\n\\n2.7      MARPOL means the International Convention for the Prevention of Pollution from\\nShips, 1973, as modified by the Protocol of 1978 relating thereto as amended by the 1997\\nProtocol.\\n\\n2.8      Medium first-year ice means first-year ice of 0.7 m to 1.2 m thickness.\\n\\n2.9      Old ice means sea ice which has survived at least one summer's melt; typical\\nthickness up to 3 m or more. It is subdivided into residual first-year ice, second-year ice and\\nmulti-year ice.\\n\\n2.10    Open water means a large area of freely navigable water in which sea ice is present\\nin concentrations less than 1/10. No ice of land origin is present.\\n\\n2.11     Organization means the International Maritime Organization.\\n\\n2.12    Sea ice means any form of ice found at sea which has originated from the freezing\\nof sea water.\\n\\n2.13   SOLAS means the International Convention for the Safety of Life at Sea, 1974,\\nas amended.\\n\\n2.14      STCW Convention means the International Convention on Standards of Training,\\nCertification and Watchkeeping for Seafarers, 1978, as amended.\\n\\f                        RESOLUTION MSC.385(94) (adopted on 21 November 2014)\\n                    INTERNATIONAL CODE FOR SHIPS OPERATING IN POLAR WATERS\\n                                         (POLAR CODE)\\n\\n                                               -9-\\n\\n2.15     Thin first-year ice means first-year ice of 0.3 m to 0.7 m thickness.\\n\\n\", \"origin\": {\"file\": \"data/requirements/IMO_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 14049, \"end\": 16635}}}, {\"evidence_id\": \"E192\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#polarShipCategoryA> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Category A\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E193\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Stage 1): candidate concept for fishingVessel derived from the linked locked requirements; scope and final semantics require vocabulary approval.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E194\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipCategory> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-085\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E195\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceFreeIceCondition> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Ice free ice condition\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E196\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#openWaterIceCondition> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R9 development): Open water ice condition represents the linked requirement entity, relationship, value, evidence role, or quantity; its scope is limited to the cited requirements.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E197\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#polarShipCategoryB> <http://www.w3.org/2004/02/skos/core#prefLabel> \\\"Category B\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E198\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceFreeIceCondition> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-102\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E199\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Cargo ship\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E200\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designIceCondition> <http://www.w3.org/2000/01/rdf-schema#range> <https://w3id.org/nltl/vocab#iceConditionValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E201\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#oilTanker\\\", \\\"kind\\\": \\\"Class\\\", \\\"label\\\": \\\"Oil tanker\\\", \\\"localName\\\": \\\"oilTanker\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#ship\\\", \\\"sourceRefs\\\": \\\"IMO-109 | IMO_POLAR_CODE p.41 | 1.2.2; IMO-110 | IMO_POLAR_CODE p.41 | 1.2.3\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E202\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#mediumFirstYearIceWithPossibleOldIceInclusions> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (R7): controlled design-ice-condition value for at least medium first-year ice with possible old-ice inclusions.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E203\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designIceCondition> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-003\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E204\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#polarShipCategoryC> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://w3id.org/nltl/vocab#polarShipCategoryValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E205\", \"kind\": \"SOURCE\", \"text\": \"4        INVITES ALSO Parties to consider the voluntary application of the Polar Code, as\\nfar as practicable, to ships not covered by the Polar Code and operating in polar waters;\\n\\n5        REQUESTS the Secretary-General, for the purposes of article 16(2)(e) of MARPOL,\\nto transmit certified copies of the present resolution and the text of the Polar Code, contained\\nin the annex, to all Parties to MARPOL;\\n\\n\", \"origin\": {\"file\": \"data/requirements/IMO_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 6086, \"end\": 6494}}}, {\"evidence_id\": \"E206\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceConditionLessSevereThanCategoryAAndB> <http://www.w3.org/2000/01/rdf-schema#label> \\\"Ice condition less severe than categories A and B\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E207\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#namingRule> \\\"N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E208\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designIceCondition> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Stage 1 controlled-enumeration string\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E209\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/nltl/vocab#ship> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E210\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designIceCondition> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-001\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E211\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#sourceReference> \\\"IMO26-002 | IMO_AMEND_2026 p.2 | Chapter 9-1 applicability; IMO26-016 | IMO_AMEND_2026 p.5 | Chapter 11-1 applicability\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E212\", \"kind\": \"SCHEMA_TEXT\", \"text\": \"{\\\"datatype\\\": \\\"\\\", \\\"iri\\\": \\\"https://w3id.org/nltl/vocab#openWaterIceCondition\\\", \\\"kind\\\": \\\"NamedIndividual\\\", \\\"label\\\": \\\"Open water ice condition\\\", \\\"localName\\\": \\\"openWaterIceCondition\\\", \\\"parentOrRange\\\": \\\"https://w3id.org/nltl/vocab#iceConditionValue\\\", \\\"sourceRefs\\\": \\\"IMO-007 | IMO_POLAR_CODE p.9 | 2.10; IMO-003 | IMO_POLAR_CODE p.9 | 2.3\\\", \\\"unitIri\\\": \\\"\\\", \\\"unitSymbol\\\": \\\"\\\"}\", \"origin\": {\"context_field\": \"schema_terms\"}}, {\"evidence_id\": \"E213\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#roleDecisionBasis> \\\"Explicit engineering entity/artifact class set\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E214\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#thinFirstYearIceWithPossibleOldIceInclusions> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-002\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E215\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designIceCondition> <https://w3id.org/nltl/vocab#stage1LocalName> \\\"designIceCondition\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E216\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipCategory> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-109\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E217\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#sourceAlias> \\\"fishing_vessel\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E218\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#designIceCondition> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Stage 1): candidate concept for designIceCondition derived from the linked locked requirements; scope and final semantics require vocabulary approval.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E219\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#cargoShip> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E220\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#fishingVessel> <https://w3id.org/nltl/vocab#unitDecisionStatus> \\\"Not a quantity property\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E221\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#oilTanker> <http://www.w3.org/2004/02/skos/core#definition> \\\"NORMALIZED (Stage 1): candidate concept for oilTanker derived from the linked locked requirements; scope and final semantics require vocabulary approval.\\\"@en .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E222\", \"kind\": \"SOURCE\", \"text\": \" 1.2     Definitions\\n\", \"origin\": {\"file\": \"data/requirements/IMO_full.txt\", \"authority\": \"User-supplied retained source document; interpretations are not independently verified\", \"selection\": {\"start\": 7477, \"end\": 7498}}}, {\"evidence_id\": \"E223\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#pleasureYacht> <https://w3id.org/nltl/vocab#namingRule> \\\"N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E224\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#shipCategory> <https://w3id.org/nltl/vocab#sourceRequirementId> \\\"IMO-003\\\"^^<http://www.w3.org/2001/XMLSchema#string> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E225\", \"kind\": \"RDF_FACT\", \"text\": \"<https://w3id.org/nltl/vocab#iceConditionLessSevereThanCategoryAAndB> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://w3id.org/nltl/vocab#iceConditionValue> .\", \"origin\": {\"context_field\": \"ontology_evidence\"}}, {\"evidence_id\": \"E226\", \"kind\": \"RDF_FACT\", \"text\": 