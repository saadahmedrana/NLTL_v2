@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix ex:   <http://example.org/shapes#> .

# Shape expressing TRF‑035 clause 4.1.1
ex:ShipRuleLengthShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    rdfs:comment "TRF‑035 | Ice Class Regulations – clause 4.1.1: “L shall be taken as the ship's rule length used by the classification society.”" ;
    
    # ruleLength – the ship's rule length (QuantityValue in metres)
    sh:property [
        sh:path nltl:ruleLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                rdfs:comment "Numeric value of the rule length (metres)." ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                rdfs:comment "Unit must be the canonical metre unit." ;
            ] ;
        ] ;
    ] ;
    
    # classificationSocietyRuleLength – rule length as recorded by the classification society
    sh:property [
        sh:path nltl:classificationSocietyRuleLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                rdfs:comment "Numeric value of the classification‑society rule length (metres)." ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                rdfs:comment "Unit must be the canonical metre unit." ;
            ] ;
        ] ;
    ] ;
    
    # classificationSociety – name of the classification society (string)
    sh:property [
        sh:path nltl:classificationSociety ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        rdfs:comment "Name of the classification society that provides the rule length." ;
    ] .
