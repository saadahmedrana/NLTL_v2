@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltlv2:development-reference:I2-042:0> a sh:NodeShape ;
    sh:sparql <urn:nltlv2:development-reference:I2-042:0:query> ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltlv2:development-reference:I2-042:1> a sh:NodeShape ;
    sh:sparql <urn:nltlv2:development-reference:I2-042:1:query> ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltlv2:development-reference:I2-042:2> a sh:NodeShape ;
    sh:sparql <urn:nltlv2:development-reference:I2-042:2:query> ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltlv2:development-reference:I2-042:0:query> sh:message "Source-authored development control: flangeWidth" ;
    sh:select "PREFIX n: <https://w3id.org/nltl/vocab#> PREFIX q: <http://qudt.org/schema/qudt/> PREFIX u: <http://qudt.org/vocab/unit/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { $this n:hasStructuralMember ?m . FILTER NOT EXISTS { ?m n:flangeWidth ?q . ?q q:numericValue ?v ; q:unit u:MilliM . FILTER(datatype(?v)=xsd:decimal) } }" .

<urn:nltlv2:development-reference:I2-042:1:query> sh:message "Source-authored development control: netWebThickness" ;
    sh:select "PREFIX n: <https://w3id.org/nltl/vocab#> PREFIX q: <http://qudt.org/schema/qudt/> PREFIX u: <http://qudt.org/vocab/unit/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { $this n:hasStructuralMember ?m . FILTER NOT EXISTS { ?m n:netWebThickness ?q . ?q q:numericValue ?v ; q:unit u:MilliM . FILTER(datatype(?v)=xsd:decimal) } }" .

<urn:nltlv2:development-reference:I2-042:2:query> sh:message "Source-authored development control: flangeWidth" ;
    sh:select "PREFIX n: <https://w3id.org/nltl/vocab#> PREFIX q: <http://qudt.org/schema/qudt/> PREFIX u: <http://qudt.org/vocab/unit/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { $this n:hasStructuralMember ?m . ?m n:flangeWidth/q:numericValue ?w ; n:netWebThickness/q:numericValue ?t . FILTER(?w < 5*?t) }" .

