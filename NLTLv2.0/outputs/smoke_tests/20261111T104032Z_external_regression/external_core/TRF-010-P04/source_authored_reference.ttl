@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltlv2:development-reference:TRF-010:0> a sh:NodeShape ;
    sh:sparql <urn:nltlv2:development-reference:TRF-010:0:query> ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltlv2:development-reference:TRF-010:0:query> sh:message "Source-authored development control: iceClass" ;
    sh:select "PREFIX n: <https://w3id.org/nltl/vocab#> PREFIX q: <http://qudt.org/schema/qudt/> PREFIX u: <http://qudt.org/vocab/unit/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { FILTER NOT EXISTS { $this n:iceClass ?v . FILTER(?v IN (n:iceClassIaSuper,n:iceClassIa,n:iceClassIb,n:iceClassIc,n:iceClassIi,n:iceClassIii)) } }" .

