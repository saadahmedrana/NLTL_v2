@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltlv2:development-reference:TRF-035:0> a sh:NodeShape ;
    sh:sparql <urn:nltlv2:development-reference:TRF-035:0:query> ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltlv2:development-reference:TRF-035:1> a sh:NodeShape ;
    sh:sparql <urn:nltlv2:development-reference:TRF-035:1:query> ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltlv2:development-reference:TRF-035:2> a sh:NodeShape ;
    sh:sparql <urn:nltlv2:development-reference:TRF-035:2:query> ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltlv2:development-reference:TRF-035:0:query> sh:message "Source-authored development control: classificationSocietyRuleLength" ;
    sh:select "PREFIX n: <https://w3id.org/nltl/vocab#> PREFIX q: <http://qudt.org/schema/qudt/> PREFIX u: <http://qudt.org/vocab/unit/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { FILTER NOT EXISTS { $this n:classificationSocietyRuleLength ?q . ?q q:numericValue ?v ; q:unit u:M . FILTER(datatype(?v)=xsd:decimal) } }" .

<urn:nltlv2:development-reference:TRF-035:1:query> sh:message "Source-authored development control: ruleLength" ;
    sh:select "PREFIX n: <https://w3id.org/nltl/vocab#> PREFIX q: <http://qudt.org/schema/qudt/> PREFIX u: <http://qudt.org/vocab/unit/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { FILTER NOT EXISTS { $this n:ruleLength ?q . ?q q:numericValue ?v ; q:unit u:M . FILTER(datatype(?v)=xsd:decimal) } }" .

<urn:nltlv2:development-reference:TRF-035:2:query> sh:message "Source-authored development control: ruleLength" ;
    sh:select "PREFIX n: <https://w3id.org/nltl/vocab#> PREFIX q: <http://qudt.org/schema/qudt/> PREFIX u: <http://qudt.org/vocab/unit/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { $this n:classificationSocietyRuleLength/q:numericValue ?a ; n:ruleLength/q:numericValue ?b . FILTER(?a != ?b) }" .

