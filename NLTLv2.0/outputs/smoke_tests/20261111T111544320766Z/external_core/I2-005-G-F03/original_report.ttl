@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/ship> ;
            sh:resultMessage "Source-authored development control: shellInclinationAngle" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint <urn:nltlv2:development-reference:I2-005:1:query> ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltlv2:development-reference:I2-005:1> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/ship> ] .

