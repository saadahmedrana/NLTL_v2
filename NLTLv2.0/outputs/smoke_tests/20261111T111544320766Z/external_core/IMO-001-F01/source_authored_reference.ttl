@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltlv2:development-reference:IMO-001:0> a sh:NodeShape ;
    sh:sparql <urn:nltlv2:development-reference:IMO-001:0:query> ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltlv2:development-reference:IMO-001:1> a sh:NodeShape ;
    sh:sparql <urn:nltlv2:development-reference:IMO-001:1:query> ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltlv2:development-reference:IMO-001:0:query> sh:message "Source-authored development control: designIceCondition" ;
    sh:select "PREFIX n: <https://w3id.org/nltl/vocab#> PREFIX q: <http://qudt.org/schema/qudt/> PREFIX u: <http://qudt.org/vocab/unit/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { FILTER NOT EXISTS { $this n:designIceCondition ?d } }" .

<urn:nltlv2:development-reference:IMO-001:1:query> sh:message "Source-authored development control: shipCategory" ;
    sh:select "PREFIX n: <https://w3id.org/nltl/vocab#> PREFIX q: <http://qudt.org/schema/qudt/> PREFIX u: <http://qudt.org/vocab/unit/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { $this n:designIceCondition n:mediumFirstYearIceWithPossibleOldIceInclusions . FILTER NOT EXISTS { $this n:shipCategory n:polarShipCategoryA } }" .

