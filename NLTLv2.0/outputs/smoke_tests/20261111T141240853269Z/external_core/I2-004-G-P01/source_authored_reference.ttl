@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltlv2:development-reference:I2-004:0> a sh:NodeShape ;
    sh:sparql <urn:nltlv2:development-reference:I2-004:0:query> ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltlv2:development-reference:I2-004:1> a sh:NodeShape ;
    sh:sparql <urn:nltlv2:development-reference:I2-004:1:query> ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltlv2:development-reference:I2-004:2> a sh:NodeShape ;
    sh:sparql <urn:nltlv2:development-reference:I2-004:2:query> ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltlv2:development-reference:I2-004:3> a sh:NodeShape ;
    sh:sparql <urn:nltlv2:development-reference:I2-004:3:query> ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltlv2:development-reference:I2-004:0:query> sh:message "Source-authored development control: hasUpperIceWaterlineCase" ;
    sh:select "PREFIX n: <https://w3id.org/nltl/vocab#> PREFIX q: <http://qudt.org/schema/qudt/> PREFIX u: <http://qudt.org/vocab/unit/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { FILTER NOT EXISTS { $this n:hasUpperIceWaterlineCase ?c } }" .

<urn:nltlv2:development-reference:I2-004:1:query> sh:message "Source-authored development control: waterlineCaseDisplacement" ;
    sh:select "PREFIX n: <https://w3id.org/nltl/vocab#> PREFIX q: <http://qudt.org/schema/qudt/> PREFIX u: <http://qudt.org/vocab/unit/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE {  $this n:hasUpperIceWaterlineCase ?c . FILTER NOT EXISTS { ?c n:waterlineCaseDisplacement ?q . ?q q:numericValue ?v ; q:unit u:KiloTON_Metric . FILTER(datatype(?v)=xsd:decimal) } }" .

<urn:nltlv2:development-reference:I2-004:2:query> sh:message "Source-authored development control: upperIceWaterlineDisplacement" ;
    sh:select "PREFIX n: <https://w3id.org/nltl/vocab#> PREFIX q: <http://qudt.org/schema/qudt/> PREFIX u: <http://qudt.org/vocab/unit/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { FILTER NOT EXISTS { $this n:upperIceWaterlineDisplacement ?q . ?q q:numericValue ?v ; q:unit u:KiloTON_Metric . FILTER(datatype(?v)=xsd:decimal) } }" .

<urn:nltlv2:development-reference:I2-004:3:query> sh:message "Source-authored development control: upperIceWaterlineDisplacement" ;
    sh:select "PREFIX n: <https://w3id.org/nltl/vocab#> PREFIX q: <http://qudt.org/schema/qudt/> PREFIX u: <http://qudt.org/vocab/unit/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { $this n:upperIceWaterlineDisplacement/q:numericValue ?s . FILTER( EXISTS { $this n:hasUpperIceWaterlineCase/n:waterlineCaseDisplacement/q:numericValue ?v . FILTER(?v > ?s) } || NOT EXISTS { $this n:hasUpperIceWaterlineCase/n:waterlineCaseDisplacement/q:numericValue ?v . FILTER(?v = ?s) }) }" .

