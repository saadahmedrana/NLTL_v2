@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltlv2:development-reference:I2-005:0> a sh:NodeShape ;
    sh:sparql <urn:nltlv2:development-reference:I2-005:0:query> ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltlv2:development-reference:I2-005:1> a sh:NodeShape ;
    sh:sparql <urn:nltlv2:development-reference:I2-005:1:query> ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltlv2:development-reference:I2-005:2> a sh:NodeShape ;
    sh:sparql <urn:nltlv2:development-reference:I2-005:2:query> ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltlv2:development-reference:I2-005:0:query> sh:message "Source-authored development control: hasBottomRegionLowerRegionBoundaryPoint" ;
    sh:select "PREFIX n: <https://w3id.org/nltl/vocab#> PREFIX q: <http://qudt.org/schema/qudt/> PREFIX u: <http://qudt.org/vocab/unit/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { FILTER NOT EXISTS { $this n:hasBottomRegionLowerRegionBoundaryPoint ?p } }" .

<urn:nltlv2:development-reference:I2-005:1:query> sh:message "Source-authored development control: shellInclinationAngle" ;
    sh:select "PREFIX n: <https://w3id.org/nltl/vocab#> PREFIX q: <http://qudt.org/schema/qudt/> PREFIX u: <http://qudt.org/vocab/unit/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { $this n:hasBottomRegionLowerRegionBoundaryPoint ?p . FILTER NOT EXISTS { ?p n:shellInclinationAngle ?q . ?q q:numericValue ?v ; q:unit u:DEG . FILTER(datatype(?v)=xsd:decimal) } }" .

<urn:nltlv2:development-reference:I2-005:2:query> sh:message "Source-authored development control: shellInclinationAngle" ;
    sh:select "PREFIX n: <https://w3id.org/nltl/vocab#> PREFIX q: <http://qudt.org/schema/qudt/> PREFIX u: <http://qudt.org/vocab/unit/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { $this n:hasBottomRegionLowerRegionBoundaryPoint/n:shellInclinationAngle/q:numericValue ?v . FILTER(?v != 7) }" .

