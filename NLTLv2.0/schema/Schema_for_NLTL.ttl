nltl:colregSternLightArcComplianceStatus a owl:DatatypeProperty ;
    rdfs:label "COLREG stern light arc compliance status"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range xsd:boolean ;
    skos:altLabel "COLREG_stern_light_arc_compliance_status" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for colregSternLightArcComplianceStatus derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "COLREG stern light arc compliance status"@en ;
    nltl:draftConceptId "VOC-0147" ;
    nltl:evidenceExcerpt "Ships involved in operations with an icebreaker escort shall be equipped with a manually initiated flashing red light visible from astern to indicate when the ship is stopped. This light shall have a range of visibility of at least two nautical miles, and the horizontal and vertical arcs of visibility shall conform to the stern light specifications required ..." ;
    nltl:module nltl:moduleHull ;
    nltl:namingBasis "Locked-workbook normalized regulatory term" ;
    nltl:namingRule "N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase" ;
    nltl:roleDecisionBasis "Stage 1 explicit boolean" ;
    nltl:sourceAlias "COLREG_stern_light_arc_compliance_status" ;
    nltl:sourceReference "IMO-089 | IMO_POLAR_CODE p.27 | 9.3.3.2" ;
    nltl:sourceRequirementId "IMO-089" ;
    nltl:stage1LocalName "colregSternLightArcComplianceStatus" ;
    nltl:unitDecisionStatus "Not a quantity property" .

nltl:combinedAxialBendingTorsionLoad a owl:ObjectProperty ;
    rdfs:label "Combined axial bending torsion load"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "combinedAxialBendingTorsionLoad" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for combinedAxialBendingTorsionLoad derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Combined axial bending torsion load"@en ;
    nltl:draftConceptId "VOC-0148" ;
    nltl:evidenceExcerpt "The ultimate load resulting from total blade failure, as defined in section 6.5.4 should not cause yielding in shafts and shaft components. The loading shall consist of the combined axial, bending, and torsion loads, wherever this is significant. The minimum safety factor against yielding must be 1.0 for bending and torsional stresses." ;
    nltl:module nltl:moduleMachinery ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:quantityKindLabel "Force" ;
    nltl:recommendedUnit unit:KiloN ;
    nltl:roleDecisionBasis "Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node" ;
    nltl:sourceAlias "combinedAxialBendingTorsionLoad" ;
    nltl:sourceReference "TRF-112 | TRAFICOM p.52 | 6.6.4.1" ;
    nltl:sourceRequirementId "TRF-112" ;
    nltl:stage1LocalName "combinedAxialBendingTorsionLoad" ;
    nltl:unitDecisionStatus "Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical benchmark force/load unit" ;
    nltl:unitSymbol "kN" .

nltl:combinedBendingAndShearEvaluated a owl:DatatypeProperty ;
    rdfs:label "Combined bending and shear evaluated"@en ;
    rdfs:domain nltl:directAnalysisCase ;
    rdfs:range xsd:boolean ;
    skos:altLabel "combinedBendingShearCapacity" ;
    skos:definition "NORMALIZED (Batch 01 development): Combined bending and shear evaluated is the benchmark representation of the linked requirement operand, relationship, evidence role, or controlled value. Exact scope is limited to the cited requirements."@en ;
    skos:prefLabel "Combined bending and shear evaluated"@en ;
    nltl:draftConceptId "VOC-DEV-B01-027" ;
    nltl:namingBasis "Applicable TRAFICOM regulation wording plus explicit engineering node/operand role" ;
    nltl:namingRule "N4 - explicit regulatory concept in ASCII lowerCamelCase with an XSD datatype." ;
    nltl:roleDecisionBasis "Typed literal required for applicability, state, identification, or non-quantity evidence." ;
    nltl:sourceAlias "combinedBendingShearCapacity" ;
    nltl:sourceRequirementId "TRF-030" ;
    nltl:unitDecisionStatus "Not a quantity property" .

nltl:combinedBendingShearStress a owl:ObjectProperty ;
    rdfs:label "Combined bending shear stress"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "combinedBendingShearStress" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for combinedBendingShearStress derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Combined bending shear stress"@en ;
    nltl:draftConceptId "VOC-0149" ;
    nltl:evidenceExcerpt "The acceptance criterion for designs is that the combined stresses from bending and shear, when using the von Mises yield criterion, are lower than the yield point sigmay. When the direct calculation is based on beam theory, the allowable shear stress must be no larger than 0.9*tauy, where tauy = sigmay/sqrt3." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:quantityKindLabel "PressureOrStress" ;
    nltl:recommendedUnit unit:MegaPA ;
    nltl:roleDecisionBasis "Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node" ;
    nltl:sourceAlias "combinedBendingShearStress" ;
    nltl:sourceReference "TRF-031 | TRAFICOM p.12 | 4.1" ;
    nltl:sourceRequirementId "TRF-031" ;
    nltl:stage1LocalName "combinedBendingShearStress" ;
    nltl:unitDecisionStatus "Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical benchmark stress/pressure unit" ;
    nltl:unitSymbol "MPa" .

nltl:combinedShearAndBendingDemand a owl:ObjectProperty ;
    rdfs:label "Combined shear and bending demand"@en ;
    rdfs:domain nltl:loadCase ;
    rdfs:range qudt:QuantityValue ;
    skos:definition "NORMALIZED (R9 development): Combined shear and bending demand represents the linked requirement entity, relationship, value, evidence role, or quantity; its scope is limited to the cited requirements."@en ;
    skos:prefLabel "Combined shear and bending demand"@en ;
    nltl:draftConceptId "VOC-DEV-R9-0044" ;
    nltl:sourceRequirementId "I2-031",
        "I2-034" .

nltl:combinedShearBendingEffect a owl:DatatypeProperty ;
    rdfs:label "Combined shear bending effect"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range xsd:string ;
    skos:altLabel "combinedBendingShearEffect",
        "combinedShearBendingEffect" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for combinedShearBendingEffect derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Combined shear bending effect"@en ;
    nltl:draftConceptId "VOC-0150" ;
    nltl:evidenceExcerpt "The local frames in bottom structures (i.e. hull areas BIb, Mb and Sb) and transverse local frames in side structures are to be dimensioned such that the combined effects of shear and bending do not exceed the plastic strength of the member. The plastic strength is defined by the magnitude of midspan load that causes the development of a plastic collapse mec..." ;
    nltl:module nltl:moduleHull ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:roleDecisionBasis "Conservative textual scalar fallback" ;
    nltl:sourceAlias "combinedBendingShearEffect",
        "combinedShearBendingEffect" ;
    nltl:sourceReference "I2-031 | IACS_UR_I2 p.12 | I2.6.1; I2-034 | IACS_UR_I2 p.13 | I2.7.1; I2-037 | IACS_UR_I2 p.13 | I2.8.1" ;
    nltl:sourceRequirementId "I2-031",
        "I2-034",
        "I2-037" ;
    nltl:stage1LocalName "combinedShearBendingEffect" ;
    nltl:unitDecisionStatus "Not a quantity property" .

