    nltl:sourceAlias "longitudinalDistributionFactor" ;
    nltl:sourceReference "I2-051 | IACS_UR_I2 p.19 | I2.13.3.1" ;
    nltl:sourceRequirementId "I2-051" ;
    nltl:stage1LocalName "longitudinalDistributionFactor" ;
    nltl:unitDecisionStatus "Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical dimensionless unit" ;
    nltl:unitSymbol "1" .

