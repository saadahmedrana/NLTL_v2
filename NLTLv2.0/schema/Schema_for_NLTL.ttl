    nltl:sourceAlias "loadLengthParameter" ;
    nltl:sourceReference "TRF-057 | TRAFICOM p.23 | 4.6.1" ;
    nltl:sourceRequirementId "TRF-057" ;
    nltl:stage1LocalName "loadLengthParameter" ;
