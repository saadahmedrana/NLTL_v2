    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range nltl:evidenceState ;
    skos:altLabel "approvalRevocationStatus" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for approvalRevocationStatus derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Approval revocation status"@en ;
    nltl:draftConceptId "VOC-0046" ;
    nltl:evidenceExcerpt "For an individual ship, in lieu of the Ke or RCH values defined in sections 3.2.2 and 3.2.3, the use of Ke or RCH values based on more precise calculations or values based on model tests may be approved. Such approval will be given on the understanding that it can be revoked if experience of the ship's performance provides grounds for this in practice." ;
    nltl:module nltl:moduleDocuments ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:roleDecisionBasis "Evidence lifecycle state decision" ;
    nltl:sourceAlias "approvalRevocationStatus" ;
    nltl:sourceReference "TRF-028 | TRAFICOM p.11 | 3.2.5" ;
    nltl:sourceRequirementId "TRF-028" ;
    nltl:stage1LocalName "approvalRevocationStatus" ;
    nltl:unitDecisionStatus "Not a quantity property" .

