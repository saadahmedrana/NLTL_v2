nltl:emergencyProviderContactProcedurePresent a owl:DatatypeProperty ;
    rdfs:label "Emergency provider contact procedure present"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range xsd:boolean ;
    skos:altLabel "emergency_provider_contact_procedure_present" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for emergencyProviderContactProcedurePresent derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Emergency provider contact procedure present"@en ;
    nltl:draftConceptId "VOC-0227" ;
    nltl:evidenceExcerpt "The Manual shall include risk-based procedures to be followed for: contacting emergency response providers for salvage, search and rescue (SAR), spill response, etc., as applicable; and, in the case of ships ice strengthened in accordance with chapter 3, procedures for maintaining life support and ship integrity in the event of prolonged entrapment by ice." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Locked-workbook normalized regulatory term" ;
    nltl:namingRule "N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase" ;
    nltl:roleDecisionBasis "Stage 1 explicit boolean" ;
    nltl:sourceAlias "emergency_provider_contact_procedure_present" ;
    nltl:sourceReference "IMO-028 | IMO_POLAR_CODE p.16 | 2.3.4" ;
    nltl:sourceRequirementId "IMO-028" ;
    nltl:stage1LocalName "emergencyProviderContactProcedurePresent" ;
    nltl:unitDecisionStatus "Not a quantity property" .

