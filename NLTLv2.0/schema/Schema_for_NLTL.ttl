nltl:outsideIceBeltFactor a owl:ObjectProperty ;
    rdfs:label "Outside ice belt factor"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "outside_ice_belt_factor" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for outsideIceBeltFactor derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Outside ice belt factor"@en ;
    nltl:draftConceptId "VOC-0525" ;
    nltl:evidenceExcerpt "The section modulus of a stringer situated outside the ice belt but supporting ice-strengthened frames shall be calculated using Z = f_9*f_10*p*h*l^2/(m*sigma_y)*(1 - h_s/l_s)*10^6 [cm^3] (4.13), and the effective shear area shall be A = sqrt(3)*f_9*f_10*f_11*p*h*l/(2*sigma_y)*(1 - h_s/l_s)*10^4 [cm^2] (4.14). Use p from 4.2.2, h from 4.2.1, p*h = 0.15 MN/m ..." ;
    nltl:module nltl:moduleHull ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:quantityKindLabel "DimensionlessRatio" ;
    nltl:recommendedUnit unit:UNITLESS ;
    nltl:roleDecisionBasis "Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node" ;
    nltl:sourceAlias "outside_ice_belt_factor" ;
    nltl:sourceReference "TRF-054 | TRAFICOM p.22-23 | 4.5.2" ;
    nltl:sourceRequirementId "TRF-054" ;
    nltl:stage1LocalName "outsideIceBeltFactor" ;
    nltl:unitDecisionStatus "Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical dimensionless unit" ;
    nltl:unitSymbol "1" .

