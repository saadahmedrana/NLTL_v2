nltl:actualFrameShearArea a owl:ObjectProperty ;
    rdfs:label "Actual frame shear area"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "actual_frame_shear_area" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for actualFrameShearArea derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Actual frame shear area"@en ;
    nltl:draftConceptId "VOC-0006" ;
    nltl:evidenceExcerpt "The section modulus of a longitudinal frame shall be calculated using Z = f_4*p*h*l^2/(4*m*sigma_y)*10^6 [cm^3] (4.9). The effective shear area shall be A = sqrt(3)*f_4*f_5*p*h*l/(2*sigma_y)*10^4 [cm^2] (4.10). The bracket shear area shall not be included in the actual frame shear area. Use f_4 = 1 - 0.2*h/s, f_5 = 2.16, p from 4.2.2, h from 4.2.1, s as fram..." ;
    nltl:module nltl:moduleHull ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:quantityKindLabel "Area" ;
    nltl:recommendedUnit unit:CentiM2 ;
    nltl:roleDecisionBasis "Quantity metadata requires the canonical QUDT QuantityValue node pattern" ;
    nltl:sourceAlias "actual_frame_shear_area" ;
    nltl:sourceReference "TRF-048 | TRAFICOM p.20 | 4.4.3" ;
    nltl:sourceRequirementId "TRF-048" ;
    nltl:stage1LocalName "actualFrameShearArea" ;
    nltl:stage2UnitEvidence "TRF-048 explicitly gives [cm^2]" ;
    nltl:unitDecisionStatus "Verified recommended QUDT unit from Stage 1 or a documented Stage 2 source-unit refinement" ;
    nltl:unitSymbol "cm^2" .

nltl:actualHullStructuralSteelGrade a owl:ObjectProperty ;
    rdfs:label "Actual hull structural steel grade"@en ;
    rdfs:domain nltl:steelGradeRequirementCase ;
