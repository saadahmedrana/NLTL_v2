<https://w3id.org/nltl/vocab> a owl:Ontology ;
    rdfs:label "NLTL benchmark controlled vocabulary" ;
    dct:created "2026-08-12"^^xsd:date ;
    dct:description "One controlled vocabulary for NL-to-SHACL benchmark inputs. It defines names and value structures but contains no regulatory threshold, formula, applicability outcome, or pass/fail answer logic." ;
    owl:versionIRI <https://w3id.org/nltl/vocab/2.17.0-stage2-final-r7> ;
    owl:versionInfo "2.17.0-stage2-final-r7" ;
    nltl:publicationStatus "Final R5 candidate; permanent W3ID namespace requested" .

nltl:abandonmentEnvironment a owl:DatatypeProperty ;
    rdfs:label "Abandonment environment"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range xsd:string ;
    skos:altLabel "abandonment_environment" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for abandonmentEnvironment derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Abandonment environment"@en ;
    nltl:draftConceptId "VOC-0001" ;
    nltl:evidenceExcerpt "Taking into account the presence of any hazards, as identified in the assessment in chapter 1, resources shall be provided to support survival following abandoning ship, whether to the water, to ice or to land, for the maximum expected time of rescue. These resources shall provide: a habitable environment; protection of persons from the effects of cold, wind..." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Locked-workbook normalized regulatory term" ;
    nltl:namingRule "N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase" ;
    nltl:roleDecisionBasis "Controlled/textual category rule" ;
    nltl:sourceAlias "abandonment_environment" ;
    nltl:sourceReference "IMO-065 | IMO_POLAR_CODE p.23-24 | 8.2.3.3" ;
    nltl:sourceRequirementId "IMO-065" ;
    nltl:stage1LocalName "abandonmentEnvironment" ;
    nltl:unitDecisionStatus "Not a quantity property" .

nltl:abandonmentOntoIceOrLandPotential a owl:DatatypeProperty ;
    rdfs:label "Abandonment onto ice or land potential"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range xsd:boolean ;
    skos:altLabel "abandonment_onto_ice_or_land_potential" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for abandonmentOntoIceOrLandPotential derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Abandonment onto ice or land potential"@en ;
    nltl:draftConceptId "VOC-0002" ;
    nltl:evidenceExcerpt "Whenever the assessment identifies a potential of abandonment onto ice or land, group survival equipment shall be carried, unless an equivalent level of functionality for survival is provided by the ship's normal life-saving appliances." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Locked-workbook normalized regulatory term" ;
    nltl:namingRule "N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase" ;
    nltl:roleDecisionBasis "Explicit binary applicability/state semantics from the linked requirement" ;
    nltl:sourceAlias "abandonment_onto_ice_or_land_potential" ;
    nltl:sourceReference "IMO-074 | IMO_POLAR_CODE p.25 | 8.3.3.3.3.1" ;
    nltl:sourceRequirementId "IMO-074" ;
    nltl:stage1LocalName "abandonmentOntoIceOrLandPotential" ;
    nltl:unitDecisionStatus "Not a quantity property" .

nltl:abreastOfHatch a owl:DatatypeProperty ;
    rdfs:label "Abreast of hatch"@en ;
    rdfs:domain nltl:narrowDeckStrip ;
