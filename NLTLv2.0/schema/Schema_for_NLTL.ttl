nltl:flareAngle a owl:ObjectProperty ;
    rdfs:label "Flare angle"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "psi" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for flareAngle derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Flare angle"@en ;
    nltl:draftConceptId "VOC-0272" ;
    nltl:evidenceExcerpt "Coefficients f_1-f_4 and g_1-g_3 are given in Table 3-2. C_3 = 845 kg/(m^2*s^2), C_4 = 42 kg/(m^2*s^2), C_5 = 825 kg/s^2. psi = atan(tan(phi_2)/sin(alpha)). If the value of the term ((L*T)/B^2)^3 is less than 5, the value 5 shall be used; if the value is more than 20, the value 20 shall be used." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Verified exact implementation term" ;
    nltl:namingRule "N1 - reuse only after exact URI and semantic-context verification" ;
    nltl:quantityKindLabel "Angle" ;
    nltl:recommendedUnit unit:DEG ;
    nltl:roleDecisionBasis "Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node" ;
    nltl:sourceAlias "psi" ;
    nltl:sourceReference "TRF-022 | TRAFICOM p.10 | 3.2.2; TRF-061 | TRAFICOM p.25 | 4.7" ;
    nltl:sourceRequirementId "TRF-022",
        "TRF-061" ;
    nltl:stage1LocalName "flareAngle" ;
    nltl:unitDecisionStatus "Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical benchmark plane-angle unit" ;
    nltl:unitSymbol "deg" .

