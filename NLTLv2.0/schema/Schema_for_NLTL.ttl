    skos:prefLabel "Direct calculation method"@en ;
    nltl:draftConceptId "VOC-0205" ;
    nltl:evidenceExcerpt "The acceptance criterion for designs is that the combined stresses from bending and shear, when using the von Mises yield criterion, are lower than the yield point sigmay. When the direct calculation is based on beam theory, the allowable shear stress must be no larger than 0.9*tauy, where tauy = sigmay/sqrt3." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:roleDecisionBasis "Stage 1 controlled-enumeration string" ;
    nltl:sourceAlias "directCalculationMethod" ;
    nltl:sourceReference "TRF-031 | TRAFICOM p.12 | 4.1" ;
    nltl:sourceRequirementId "TRF-031" ;
    nltl:stage1LocalName "directCalculationMethod" ;
    nltl:unitDecisionStatus "Not a quantity property" .

