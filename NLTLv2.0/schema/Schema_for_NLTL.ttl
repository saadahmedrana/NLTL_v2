        "iceLoadCycleCount" ;
    nltl:sourceReference "TRF-077 | TRAFICOM p.36 | 6.5.1.8; TRF-078 | TRAFICOM p.36 | 6.5.1.9; TRF-080 | TRAFICOM p.37 | 6.5.1.9; TRF-109 | TRAFICOM p.50 | 6.6.2.3" ;
