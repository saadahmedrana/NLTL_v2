    nltl:sourceReference "TRF-096 | TRAFICOM p.41 | 6.5.3.4" ;
    nltl:sourceRequirementId "TRF-096" ;
    nltl:stage1LocalName "maximumTorqueDuringSpeedDrop" ;
    nltl:unitDecisionStatus "Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical maritime linear-speed unit" ;
    nltl:unitSymbol "kn" .

