nltl:shaftComponent a owl:Class ;
    rdfs:label "Shaft component"@en ;
    rdfs:subClassOf nltl:machineryComponent ;
    skos:altLabel "shaftComponent" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for shaftComponent derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Shaft component"@en ;
    nltl:draftConceptId "VOC-0664" ;
    nltl:evidenceExcerpt "The ultimate load resulting from total blade failure, as defined in section 6.5.4 should not cause yielding in shafts and shaft components. The loading shall consist of the combined axial, bending, and torsion loads, wherever this is significant. The minimum safety factor against yielding must be 1.0 for bending and torsional stresses." ;
    nltl:module nltl:moduleMachinery ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:roleDecisionBasis "Explicit engineering entity/artifact class set" ;
    nltl:sourceAlias "shaftComponent" ;
    nltl:sourceReference "TRF-112 | TRAFICOM p.52 | 6.6.4.1" ;
    nltl:sourceRequirementId "TRF-112" ;
    nltl:stage1LocalName "shaftComponent" ;
    nltl:unitDecisionStatus "Not a quantity property" .

nltl:shaftComponentDesignTorque a owl:ObjectProperty ;
    rdfs:label "Shaft component design torque"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "shaftComponentDesignTorque" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for shaftComponentDesignTorque derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Shaft component design torque"@en ;
    nltl:draftConceptId "VOC-0665" ;
    nltl:evidenceExcerpt "If there is first blade order torsional resonance in the operational speed range or in the range 20% above and 20% below the maximum operating speed (bollard condition), the design torque (Qpeak) of the shaft component shall be determined by means of torsional vibration" ;
    nltl:module nltl:moduleMachinery ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:quantityKindLabel "TorqueOrMoment" ;
    nltl:recommendedUnit unit:KiloN-M ;
    nltl:roleDecisionBasis "Formula/comparison or engineering-numeric semantics require a unit-bearing QUDT QuantityValue node" ;
    nltl:sourceAlias "shaftComponentDesignTorque" ;
    nltl:sourceReference "TRF-089 | TRAFICOM p.39 | 6.5.3.4" ;
    nltl:sourceRequirementId "TRF-089" ;
    nltl:stage1LocalName "shaftComponentDesignTorque" ;
    nltl:unitDecisionStatus "Recommended canonical QUDT unit selected by Stage 2 engineering normalization: Canonical benchmark torque/moment unit" ;
    nltl:unitSymbol "kN*m" .

