nltl:polarServiceTemperature a owl:ObjectProperty ;
    rdfs:label "Polar service temperature"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "PST_degC" ;
