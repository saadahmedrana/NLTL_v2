nltl:elongationAtTest a owl:ObjectProperty ;
    rdfs:label "Elongation measured by test"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "elongation_test_percent" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for elongationTestPercent derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Elongation measured by test"@en ;
    nltl:draftConceptId "VOC-0225" ;
    nltl:evidenceExcerpt "The materials of components exposed to sea water, such as propeller blades, propeller hubs, and thruster body, shall have an elongation of no less than 15% in a test specimen, the gauge length of which is five times the diameter. A Charpy V impact test shall be carried out for materials other than bronze and austenitic steel. An average impact energy value o..." ;
    nltl:module nltl:moduleTests ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
    nltl:quantityKindLabel "DimensionlessRatio" ;
    nltl:recommendedUnit unit:PERCENT ;
    nltl:roleDecisionBasis "Quantity metadata requires the canonical QUDT QuantityValue node pattern" ;
    nltl:sourceAlias "elongation_test_percent" ;
    nltl:sourceReference "TRF-072 | TRAFICOM p.31 | 6.4.1" ;
    nltl:sourceRequirementId "TRF-072" ;
    nltl:stage1LocalName "elongationTestPercent" ;
    nltl:stage2UnitEvidence "TRF-072 explicitly states elongation percentage" ;
    nltl:unitDecisionStatus "Verified recommended QUDT unit from Stage 1 or a documented Stage 2 source-unit refinement" ;
    nltl:unitSymbol "%" .

