nltl:directCalculationMethod a owl:DatatypeProperty ;
    rdfs:label "Direct calculation method"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range xsd:string ;
    skos:altLabel "directCalculationMethod" ;
