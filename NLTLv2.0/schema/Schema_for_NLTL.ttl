    skos:prefLabel "Maximum torque during speed drop"@en ;
    nltl:draftConceptId "VOC-0469" ;
    nltl:evidenceExcerpt "If a speed drop occurs until the main engine is at a standstill, this indicates that the engine may not be sufficiently powered for the intended service task. For the consideration of loads, the maximum occurring torque during the speed drop process must be used." ;
    nltl:module nltl:moduleMachinery ;
    nltl:namingBasis "Benchmark-coined descriptive engineering term" ;
    nltl:namingRule "N5 - component or subject first, followed by characteristic and qualifier/state; no unsupported external mapping" ;
