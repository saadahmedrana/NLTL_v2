nltl:maximumSpindleTorque a owl:ObjectProperty ;
    rdfs:label "Maximum spindle torque"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "Qsmax_kNm" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for maximumSpindleTorque derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Maximum spindle torque"@en ;
    nltl:draftConceptId "VOC-0468" ;
    nltl:evidenceExcerpt "The maximum spindle torque due to a blade-failure load acting at 0.8R shall be determined by appropriate stress analysis or Q_sex = max(C_LE0.8, 0.8*C_TE0.8)*C_spex*F_ex [kNm] (6.36), where C_spex = C_sp*C_fex = 0.7*(1 - ((4*EAR)/Z)^3) (6.37). If C_spex is below 0.3, a value of 0.3 shall be used. C_LE0.8 and C_TE0.8 are the leading-edge and trailing-edge por..." ;
    nltl:module nltl:moduleMachinery ;
    nltl:namingBasis "Unit-stripped normalized regulatory variable" ;
    nltl:namingRule "N3 - remove unit from the identifier and retain it in unit/quantity metadata" ;
    nltl:quantityKindLabel "TorqueOrMoment" ;
    nltl:recommendedUnit unit:KiloN-M ;
    nltl:roleDecisionBasis "Quantity metadata requires the canonical QUDT QuantityValue node pattern" ;
    nltl:sourceAlias "Qsmax_kNm" ;
    nltl:sourceReference "TRF-102 | TRAFICOM p.46 | 6.5.4.2; TRF-103 | TRAFICOM p.46 | 6.5.4.2" ;
    nltl:sourceRequirementId "TRF-102",
        "TRF-103" ;
    nltl:stage1LocalName "maximumSpindleTorque" ;
    nltl:unitDecisionStatus "Verified recommended QUDT unit from Stage 1 or a documented Stage 2 source-unit refinement" ;
    nltl:unitSymbol "kN*m" .

nltl:maximumTorqueDuringSpeedDrop a owl:ObjectProperty ;
    rdfs:label "Maximum torque during speed drop"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "maximumTorqueDuringSpeedDrop" ;
