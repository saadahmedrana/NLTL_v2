    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range xsd:string ;
    skos:altLabel "sewage_discharge_type" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for sewageDischargeType derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Sewage discharge type"@en ;
    nltl:draftConceptId "VOC-0661" ;
    nltl:evidenceExcerpt "The ship is discharging comminuted and disinfected sewage in accordance with regulation 11.1.1 of MARPOL Annex IV at a distance of more than three nautical miles from any ice-shelf or fast ice and shall be as far as practicable from areas of ice concentration exceeding 1/10." ;
    nltl:module nltl:moduleCore ;
    nltl:namingBasis "Locked-workbook normalized regulatory term" ;
    nltl:namingRule "N4 - preserve the source concept; normalize spelling to ASCII lowerCamelCase" ;
    nltl:roleDecisionBasis "Stage 1 controlled-enumeration string" ;
    nltl:sourceAlias "sewage_discharge_type" ;
    nltl:sourceReference "IMO-115 | IMO_POLAR_CODE p.42 | 4.2.1.1; IMO-116 | IMO_POLAR_CODE p.42 | 4.2.1.2" ;
    nltl:sourceRequirementId "IMO-115",
        "IMO-116" ;
    nltl:stage1LocalName "sewageDischargeType" ;
    nltl:unitDecisionStatus "Not a quantity property" .

