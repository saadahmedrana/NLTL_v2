    nltl:namingBasis "Applicable TRAFICOM regulation wording plus explicit engineering node/operand role" ;
    nltl:namingRule "N4 - explicit engineering quantity in ASCII lowerCamelCase; formula symbols remain aliases only." ;
    nltl:recommendedUnit unit:CentiM3 ;
