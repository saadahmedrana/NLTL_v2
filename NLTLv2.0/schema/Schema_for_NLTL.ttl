nltl:patchLoad a owl:ObjectProperty ;
    rdfs:label "Patch load"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "patchLoad" ;
    skos:definition "NORMALIZED (Stage 1): candidate concept for patchLoad derived from the linked locked requirements; scope and final semantics require vocabulary approval."@en ;
    skos:prefLabel "Patch load"@en ;
