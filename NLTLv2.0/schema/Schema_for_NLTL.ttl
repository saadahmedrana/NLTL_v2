nltl:bladeIceLoad a owl:ObjectProperty ;
    rdfs:label "Blade ice load"@en ;
    rdfs:domain nltl:benchmarkEntity ;
    rdfs:range qudt:QuantityValue ;
    skos:altLabel "bladeIceLoad" ;
